##ACL-ORG-REGION storages
##ACL-ORG-REGION write-rules
      // INGRESS-only after the ADR 1020 split — this is the ONLY thing
      // that lets a vendor PUBLISH, and only into its own namespace.
      // Egress delivery is universal via trial-peer-deliver-all.
      //
      // One grant per peer, two prefixes (ADR 1032): the persisted
      // <vendor>/** namespace + the non-persisted volatile/<vendor>/**
      // class. Same identity boundary; volatile/<vendor>/** has NO
      // storage entry (so nothing reaches rocksdb) and is excluded by the
      // audit subscriber (--exclude-key volatile/**), so it routes live
      // but is never persisted. Granting this write WITHOUT the audit
      // exclude active would route the firehose into the locked audit
      // bucket — keep them in lockstep.
      // BEGIN peering xab (goatbuilder federate)
      {
        id: "fed-w-xab",
        messages: ["put", "delete"],
        flows: ["ingress"],
        permission: "allow",
        key_exprs: [
          "from/xab/**",
        ],
      },
      {
        id: "fed-w-interest-xab",
        messages: ["declare_subscriber", "query", "declare_queryable"],
        flows: ["egress"],
        permission: "allow",
        key_exprs: [
          "from/xab/**",
        ],
      },
      {
        id: "fed-r-xab",
        messages: ["put", "delete", "declare_subscriber", "query", "reply"],
        flows: ["egress"],
        permission: "allow",
        key_exprs: [
          "from/xaa/all/**",
          "from/xaa/xab/**",
        ],
      },
      {
        id: "fed-r-interest-xab",
        messages: ["declare_subscriber", "query", "declare_queryable"],
        flows: ["ingress"],
        permission: "allow",
        key_exprs: [
          "from/xaa/**",
        ],
      },
      {
        id: "fed-rp-r-xab",
        messages: ["put", "delete", "declare_subscriber", "query", "reply"],
        flows: ["egress"],
        permission: "allow",
        key_exprs: [
          "release/all/**",
          "release/xab/**",
        ],
      },
      {
        id: "fed-rp-r-interest-xab",
        messages: ["declare_subscriber", "query", "declare_queryable"],
        flows: ["ingress"],
        permission: "allow",
        key_exprs: [
          "release/all/**",
          "release/xab/**",
        ],
      },
      {
        id: "fed-rp-w-xab",
        messages: ["put", "delete"],
        flows: ["ingress"],
        permission: "allow",
        key_exprs: [
          "from/xaa/all/**",
          "from/xaa/xab/**",
        ],
      },
      {
        id: "fed-rp-w-interest-xab",
        messages: ["declare_subscriber", "query", "declare_queryable"],
        flows: ["egress"],
        permission: "allow",
        key_exprs: [
          "from/xaa/**",
        ],
      },
      // END peering xab
##ACL-ORG-REGION subjects
      // BEGIN peering xab (goatbuilder federate)
      {
        id: "fed-xab",
        cert_common_names: ["fed.xab.xaa.01"],
      },
      {
        id: "fed-rp-xab",
        cert_common_names: ["fed.xaa.xab.republisher.01"],
      },
      // END peering xab
##ACL-ORG-REGION policies
      // BEGIN peering xab (goatbuilder federate)
      { rules: ["fed-w-xab", "fed-w-interest-xab", "fed-r-xab", "fed-r-interest-xab"], subjects: ["fed-xab"] },
      { rules: ["fed-rp-r-xab", "fed-rp-r-interest-xab", "fed-rp-w-xab", "fed-rp-w-interest-xab"], subjects: ["fed-rp-xab"] },
      // END peering xab
