# Copy to hosts.env (not committed) and fill in. Addresses below are
# documentation examples (RFC 5737).
HOST_MODE=ssh
SSH_KEY=$HOME/.ssh/id_ed25519
# SSH destinations, reached from the machine that drives the measurement.
CONTROL_TARGET=ubuntu@198.51.100.10
RELAY_TARGET=ubuntu@198.51.100.20
PEER_A_TARGET=ubuntu@198.51.100.11
PEER_B_TARGET=ubuntu@198.51.100.12
# Addresses the peers use inside the placement group (private addresses).
CONTROL_ADDR=192.0.2.10
RELAY_ADDR=192.0.2.20
RELAY_BIND=192.0.2.20
PEER_A_ADDR=192.0.2.11
PEER_B_ADDR=192.0.2.12
# RELAY_PORT=33080
# MGMT_PORT=8080
