%%{init: {'theme': 'base', 'themeVariables': {'fontSize': '13px'}}}%%
graph TB
  subgraph PROD["Producers"]
    direction TB
    P1[gatewatch]
    P2[airdefenders]
    P3[ntp-health-agent]
    P4[admit-audit]
  end

  subgraph FABRIC["Zenoh data fabric"]
    direction LR
    R1[Zenoh router-A] <==> R2[Zenoh router-B]
    INTERCEPT[Rust audit-logger interceptor<br/>+ future CDS conditioning]
    R1 -.- INTERCEPT
    R2 -.- INTERCEPT
    STORE[(RocksDB ops/**<br/>7-day TTL)]
    R1 -.- STORE
    R2 -.- STORE
  end

  subgraph CONS["Consumers"]
    direction TB
    C1[isitup status]
    C2[Prometheus]
    C3[late-join replay]
    C4[partner federation<br/>via boundary node]
  end

  PROD ==> FABRIC
  FABRIC ==> CONS

  GATE["Phase 2 gate criteria<br/>(0509)"]:::gate
  FABRIC -. evaluated against .-> GATE

  classDef gate fill:#fff3e0,stroke:#f57c00
  style FABRIC fill:#e3f2fd,stroke:#1976d2,stroke-width:2px
