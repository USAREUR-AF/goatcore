{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "goatbuilder target type (ops/goatbuilder/targets/<type>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "type",
    "families"
  ],
  "properties": {
    "schema": {
      "const": "goatbuilder-target/v1"
    },
    "type": {
      "$ref": "#/definitions/name"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/name"
      }
    },
    "group": {
      "type": "string",
      "pattern": "^[a-z0-9_{}]+$"
    },
    "preflight": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_{} -]+$"
    },
    "inventory": {
      "type": "string",
      "pattern": "^inventory/[A-Za-z0-9_{}-]+\\.ini$"
    },
    "converges_as": {
      "$ref": "#/definitions/name"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_by",
        "standup"
      ],
      "properties": {
        "declared_by": {
          "$ref": "#/definitions/key"
        },
        "absent_reason": {
          "$ref": "#/definitions/key"
        },
        "standup": {
          "enum": [
            "phase-14",
            "obs-legs"
          ]
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/phase"
      }
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n\\r]+$"
    },
    "when": {
      "enum": [
        "founder",
        "joiner"
      ]
    },
    "play": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play",
        "args"
      ],
      "properties": {
        "play": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*\\.ya?ml$"
        },
        "args": {
          "description": "Words for ansible-playbook. No shell syntax. It must limit the play to a group: -e target={group}.",
          "type": "string",
          "pattern": "^-[A-Za-z0-9_.,:/=@+{} -]+$"
        },
        "from": {
          "description": "Where the play lives when it is not in this repository.",
          "type": "string",
          "pattern": "^(overlay|[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)$"
        }
      }
    },
    "phase": {
      "description": "Exactly one of plays, builtin and skip (checked by the loader).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "$ref": "#/definitions/line"
        },
        "label": {
          "$ref": "#/definitions/line"
        },
        "when": {
          "$ref": "#/definitions/when"
        },
        "leg": {
          "enum": [
            "baseline",
            "utility",
            "stack"
          ]
        },
        "plays": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/play"
          }
        },
        "builtin": {
          "$ref": "#/definitions/name"
        },
        "skip": {
          "$ref": "#/definitions/line"
        }
      }
    }
  }
}
