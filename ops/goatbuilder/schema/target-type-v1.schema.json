{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "goatbuilder target type (ops/goatbuilder/targets/<type>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "type",
    "families"
  ],
  "properties": {
    "schema": {
      "const": "goatbuilder-target/v1"
    },
    "type": {
      "$ref": "#/definitions/name"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/name"
      }
    },
    "group": {
      "type": "string",
      "pattern": "^[a-z0-9_{}]+$"
    },
    "preflight": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_{} -]+$"
    },
    "inventory": {
      "type": "string",
      "pattern": "^inventory/[A-Za-z0-9_{}-]+\\.ini$"
    },
    "converges_as": {
      "$ref": "#/definitions/name"
    },
    "encryption": {
      "description": "The minimum encryption scope a machine of the type requires (design section 3.1). doctor --target names it; the checkout cannot show a machine's disks, so it is not checked there.",
      "enum": [
        "root"
      ]
    },
    "declares": {
      "description": "What a machine of the type must declare in its host_vars, besides platform_family. tap: the network tap's mode, source, ports and management interface (design section 3.8).",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "tap"
        ]
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_by",
        "standup"
      ],
      "properties": {
        "declared_by": {
          "$ref": "#/definitions/key"
        },
        "absent_reason": {
          "$ref": "#/definitions/key"
        },
        "standup": {
          "enum": [
            "phase-14",
            "obs-legs"
          ]
        }
      }
    },
    "services": {
      "description": "Components of ops/pins/fleet-pins.yaml the machine runs (design section 3.9): join-node deploys each to it after the phases, and standup's phase 14 to the type's machines at the site, through deploy itself. Not for a type standup builds in obs-legs.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/name"
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/phase"
      }
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n\\r]+$"
    },
    "when": {
      "enum": [
        "founder",
        "joiner"
      ]
    },
    "play": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play",
        "args"
      ],
      "properties": {
        "play": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*\\.ya?ml$"
        },
        "args": {
          "description": "Words for ansible-playbook. No shell syntax. It must limit the play to a group: -e target={group}.",
          "type": "string",
          "pattern": "^-[A-Za-z0-9_.,:/=@+{} -]+$"
        },
        "from": {
          "description": "Where the play lives when it is not in this repository.",
          "type": "string",
          "pattern": "^(overlay|[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)$"
        }
      }
    },
    "phase": {
      "description": "Exactly one of plays, builtin, component and skip; a component has a skip beside it, the reason when no pin for it exists (checked by the loader).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "$ref": "#/definitions/line"
        },
        "label": {
          "$ref": "#/definitions/line"
        },
        "when": {
          "$ref": "#/definitions/when"
        },
        "leg": {
          "enum": [
            "baseline",
            "utility",
            "stack"
          ]
        },
        "plays": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/play"
          }
        },
        "builtin": {
          "$ref": "#/definitions/name"
        },
        "component": {
          "description": "A release component of the pins (artifact_type: release): installed at its pin, or skipped with the reason in skip.",
          "$ref": "#/definitions/name"
        },
        "skip": {
          "$ref": "#/definitions/line"
        }
      }
    }
  }
}
