{# The DNS-01 provider is acme_dns_provider (traefik-acme.yml): cloudflare,
    the default, or azure (lego's `azuredns`, an Entra service principal).
    The Cloudflare render is byte-for-byte what it was before the switch. #}
{% set _azure = (acme_dns_provider | default('cloudflare')) == 'azure' %}
# docker-compose.acme.yml — Traefik ACME overlay for a mgmt host
#
# Rendered by ops/ansible/traefik-acme.yml. DO NOT EDIT THIS FILE ON
# THE HOST — it will be overwritten on the next ansible-playbook run.
# Edit the template at ops/ansible/templates/traefik-acme/docker-compose.acme.yml.j2
# instead.
#
# Extends the base mgmt-host compose Traefik service with Let's Encrypt
# ACME ({{ 'Azure' if _azure else 'Cloudflare' }} DNS-01).
#
# !! BRITTLE BIT !!
# Docker Compose REPLACES (not merges) the `command:` array when a service
# is overridden. So this file MUST re-list every flag from the base
# `ops/compose/mgmt-host/docker-compose.yml` Traefik service `command:`
# block PLUS the ACME additions below. If the base Traefik command set
# changes, sync the changes here.
#
# Apply: from /opt/mgmt-host:
#   docker compose -f docker-compose.yml -f docker-compose.acme.yml \
#       up -d traefik

services:
  traefik:
    command:
      # ----- base command set (mirror of docker-compose.yml Traefik command block) -----
      - --providers.file.directory=/etc/traefik/dynamic
      - --providers.file.watch=true
      - --entrypoints.websecure.address=:443
      - --entrypoints.websecure.transport.respondingTimeouts.readTimeout=0
      - --entrypoints.websecure.transport.respondingTimeouts.writeTimeout=0
      - --entrypoints.websecure.transport.respondingTimeouts.idleTimeout=0
      # Dedicated enrollment entrypoint for the
      # rathole-forwarded path; host-bound to 127.0.0.1:8443 only (see
      # base compose ports block). Docker Compose REPLACES the
      # `command:` array on service override — so this MUST mirror the
      # base compose. If the base adds another flag, sync here too.
      - --entrypoints.enrollment.address=:8443
      - --entrypoints.enrollment.transport.respondingTimeouts.readTimeout=0
      - --entrypoints.enrollment.transport.respondingTimeouts.writeTimeout=0
      - --entrypoints.enrollment.transport.respondingTimeouts.idleTimeout=0
      - --entrypoints.metrics.address=:8082
      - --metrics.prometheus=true
      - --metrics.prometheus.entryPoint=metrics
      # Universal client-demand ceiling and universal response compression —
      # applies `goat-entrypoint-ceiling` and `goat-compress` to EVERY router
      # on :443, including services that do not exist yet. The ceiling is the
      # 3000 r/s tier-1 limiter sized for this host's own netbird client
      # (the 50 r/s `goat-ratelimit` attaches per router on browsing
      # surfaces — see mgmt-dynamic.yml.j2). Both
      # middlewares are defined in mgmt-dynamic.yml.j2 and rendered
      # into {{ dynamic_dir }} by THIS playbook's "Render Traefik dynamic
      # config" task, which runs BEFORE "Recreate Traefik with the ACME
      # overlay" — that ordering is load-bearing.
      #
      # FAIL-CLOSED, DELIBERATELY NOT IN THE BASE COMPOSE: Traefik fails a
      # router whose middleware cannot be resolved. If this flag were in
      # ops/compose/mgmt-host/docker-compose.yml it would also reach hosts
      # that never run traefik-acme.yml and therefore have no
      # goat-entrypoint-ceiling/goat-compress definition — taking every vhost on those
      # hosts down.
      # It lives here, beside the playbook that guarantees the definition.
      # Hosts on the traefik-role path get the same middleware via that
      # role's own dynamic template; see surface-overload-protection.md §4.
      # Order is deliberate: ratelimit first so a rejected request is
      # never compressed, then compress what survives.
      - --entrypoints.websecure.http.middlewares=goat-entrypoint-ceiling@file,goat-compress@file
      - --log.level=INFO
      - --accesslog=true
      - --accesslog.format=json
      # Response Content-Type in the access log. Without it the compression
      # exporter cannot tell "sent uncompressed because the client did not ask"
      # from "sent uncompressed because a PNG does not compress", so its
      # missed-opportunity metric reads 0.00 MB forever and looks healthy while
      # measuring nothing. One header, kept verbatim; it carries no client
      # identity, unlike User-Agent which is deliberately still not logged.
      - --accesslog.fields.headers.names.Content-Type=keep
      - --api.dashboard=false
      - --api.insecure=false
      # ----- ACME additions (Let's Encrypt via {{ 'Azure' if _azure else 'Cloudflare' }} DNS-01) -----
      - --certificatesresolvers.le.acme.email={{ acme_email }}
      - --certificatesresolvers.le.acme.storage=/letsencrypt/acme.json
      - --certificatesresolvers.le.acme.dnschallenge=true
      - --certificatesresolvers.le.acme.dnschallenge.provider={{ 'azuredns' if _azure else 'cloudflare' }}
      - --certificatesresolvers.le.acme.dnschallenge.resolvers={{ traefik_acme_dns_resolvers | default('1.1.1.1:53,8.8.8.8:53', true) }}
    environment:
      # Read at runtime from /opt/mgmt-host/.env (rendered by the playbook).
      # Compose loads .env automatically for env interpolation in the file
      # AND propagates env-name-only entries into the container.
{% if _azure %}
      # lego `azuredns`, service principal by client secret. AZURE_AUTH_METHOD=env
      # pins that one credential: without it lego walks the default chain,
      # which on a non-Azure host ends at the managed-identity endpoint.
      # IDs and names below are not secrets; the client secret is, so it
      # comes from .env like the Cloudflare token.
      - AZURE_AUTH_METHOD=env
      - AZURE_TENANT_ID={{ traefik_acme_azure_tenant_id }}
      - AZURE_CLIENT_ID={{ traefik_acme_azure_client_id }}
      - AZURE_SUBSCRIPTION_ID={{ traefik_acme_azure_subscription_id }}
      - AZURE_RESOURCE_GROUP={{ traefik_acme_azure_resource_group }}
{% if traefik_acme_azure_zone_name | default('', true) | length > 0 %}
      - AZURE_ZONE_NAME={{ traefik_acme_azure_zone_name }}
{% endif %}
{% if traefik_acme_azure_environment | default('', true) | length > 0 %}
      - AZURE_ENVIRONMENT={{ traefik_acme_azure_environment }}
{% endif %}
      - AZURE_CLIENT_SECRET=${TRAEFIK_ACME_AZURE_CLIENT_SECRET:?TRAEFIK_ACME_AZURE_CLIENT_SECRET must be set in /opt/mgmt-host/.env}
{% else %}
      - CLOUDFLARE_DNS_API_TOKEN=${CLOUDFLARE_DNS_API_TOKEN:?CLOUDFLARE_DNS_API_TOKEN must be set in /opt/mgmt-host/.env}
{% endif %}
    volumes:
      # Persist acme.json on the host so cert state survives container
      # recreates. Mode 0700 root:root enforced by the playbook.
      - {{ le_dir }}:/letsencrypt
