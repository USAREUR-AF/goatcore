<?xml version="1.0" encoding="UTF-8"?>
<!-- TAK Server CoreConfig.xml — {{ inventory_hostname }}
     Managed by Ansible (tak-server.yml)
     Mesh IP: {{ tak_mesh_ip }} -->
<Configuration xmlns="http://bbn.com/marti/xml/config">

  <network multicastTTL="5">
    <!-- CoT streaming — primary ATAK/WinTAK connection (mTLS) -->
    <input _name="stdssl" protocol="tls" port="8089" coreVersion="2"/>

    <!-- Certificate enrollment — new clients get their .p12 here -->
    <connector port="8446" _name="cert_https" clientAuth="false"/>

    <!-- WebTAK + REST API + Data Sync + Missions -->
    <connector port="8443" _name="https" clientAuth="true"/>

    <!-- Admin interface + federation -->
    <connector port="9000" _name="fed_https" clientAuth="true"/>
  </network>

  <auth>
    <File/>
  </auth>

  <submission ignoreStaleMessages="false" validateXml="false"/>

  <subscription replicationCycleSeconds="1" replicationPrimaryKeyField="uid"/>

  <repository enable="true" numDbConnections="16"
    connectionString="jdbc:postgresql://127.0.0.1:5432/cot"
    username="martiuser" password="{{ tak_pg_password }}"/>

  <dissemination smartRetry="false"/>

  <certificateSigning CA="{{ tak_ca_name }}">
    <nameEntries>
      <nameEntry name="O" value="{{ tak_cert_org | mandatory('set tak_cert_org, the O of certificates this TAK server signs, in the tak_servers group') }}"/>
      <nameEntry name="OU" value="TAK"/>
    </nameEntries>
  </certificateSigning>

  <security>
    <tls context="TLSv1.2" keymanager="SunX509" keystore="JKS"/>
  </security>

  <plugins>
    <plugin archive="takserver-plugin-datasync" enabled="true"/>
  </plugins>

{% if federation_host is defined and federation_host != "" %}
  <federation>
    <federationServer port="{{ federation_port | default('9000') }}"/>
    <federationOutgoing>
      <outgoing name="{{ tak_federation_name }}"
                address="{{ federation_host }}"
                port="{{ federation_port | default('9000') }}"
                protocolVersion="2"
                reconnectInterval="30"
                enabled="true"
                fallback="false"/>
    </federationOutgoing>
  </federation>
{% endif %}

</Configuration>
