# Rendered by ops/ansible/roles/isitup/ — do not edit on host.
#
# Sourced by check.sh inside the isitup container on each cron tick. Format:
#   id|name|fqdn|type|container|port|health_path|kind|access|category|icon|desc|link_path|probe_front_door|expect_codes
#
# expect_codes is intentionally LAST because its value contains pipes
# ("2|3" default; "2|3|401|403" for the mgmt API). With `read -r` the
# trailing variable absorbs all remaining pipe-separated fields, which
# is exactly what we want for expect_codes. Inserting another field
# after it would split the value across columns.
#
# type:           container | external
# container:      only for container services (direct Docker health check)
# health_path:    optional, default /
# kind:           ui (default) | api
#                 - ui  → rendered as clickable link on the page
#                 - api → rendered as plain text (clicking would 404 / unhelpful)
# expect_codes:   pipe-separated HTTP code prefixes that count as "up";
#                 default `2|3`. For APIs that respond 401/403 unauth'd
#                 (e.g. mgmt-API), set `2|3|401|403`.
# access:         optional auth-posture tag — drives a colored badge on
#                 the page so a new user can navigate without 404/403
#                 guessing. Recognized values:
#                   public — any authenticated mesh peer can use it; no
#                            additional gating. Green badge.
#                   admins — additional admins-only gate in front (e.g.
#                            oauth2-proxy ADMINS group, Grafana
#                            ROLE_ATTRIBUTE_STRICT). Red badge — "you
#                            need elevated access for this one."
#                   api    — programmatic endpoint, not browseable; grey
#                            badge. Distinct from kind=api in that this
#                            is about posture, not clickability.
#                   offmesh — off-mesh address with its own sign-in plane
#                            (public Dex/Kanidm, or the collab plane), not
#                            this goatnet's mesh login. Blue badge — the
#                            axis is "which login", not "how privileged",
#                            so it is neither the green public nor the red
#                            admins.
#                 Default empty (renders no badge). New-user navigation
#                 wants every UI service flagged either public or
#                 admins; the API surfaces typically flag api.
# category:       optional page-section key. The SPA (ops/status/index.html)
#                 groups rows under a heading per category. Recognized:
#                   external    — off-mesh: public-internet addresses on their
#                                 own sign-in planes (collab space, the
#                                 cross-goatnet consistency view, the
#                                 relay-health dashboards). Fed by the separate
#                                 `isitup_external_services` list, appended
#                                 below; see the role defaults for why it is a
#                                 separate list and per-site opt-in.
#                   browse      — human-facing content/apps (docs, briefings,
#                                 downloads, games, playgrounds, login).
#                   interactive — opt-in split of browse for live apps
#                                 (airdefenders, sandbox); empty by default.
#                   platform    — data-fabric + inspection surfaces (zenoh
#                                 router/portal, panoscope, stethoscope,
#                                 flashlight).
#                   admin       — privileged consoles (compliance, dashboard,
#                                 IdP console, grafana).
#                   api         — programmatic endpoints (rendered plain text).
#                 Default empty → renders as `app` ("Applications"), the
#                 legacy single-section behavior for unclassified sites.
# icon:           optional per-row glyph. Either an ICONS key (see the map in
#                 index.html: download/docs/info/diagram/game/sandbox/login/
#                 fabric/portal/scope/stethoscope/flashlight/shield/dashboard/
#                 identity/chart/key/api) OR a path/URL ("/icons/zenoh.svg")
#                 to render a real brand logo as an <img>. Empty → a sensible
#                 glyph is picked from the row's category.
# desc:           optional one-sentence plain-English line rendered under the
#                 row name. It exists for the cold reader looking at a RED dot
#                 who has to decide whether it matters, so write the
#                 consequence, not the implementation: what stops working
#                 while this row is down, and what does not. Keep it to one
#                 sentence — the page is a status board, not a doc. MUST NOT
#                 contain a `|` (the field is pipe-delimited).
#                 Empty → no second line, unchanged row.
#
#                 A `"` IS allowed, in `desc` and in `name`. This file is a
#                 bash array of double-quoted strings, so both columns go
#                 through `_sh` below, which escapes the four characters bash
#                 acts on inside double quotes. An unescaped `"` closes its own
#                 string and the space after it splits the entry in two, which
#                 shows a second row with no name and a nonsense host column.
#                 tests/free-text-columns.sh pins it.
#
# probe_front_door:
#                 optional bool, default = this row's `probe_gate` (itself
#                 default true). `false` means the row's FQDN is NOT a public
#                 front door and must not be dialled on :443 — the service is
#                 deliberately reachable only over the container network.
#                 The zenoh-router row is the case: it is probed on the REST
#                 plugin at :8000 and no Traefik router is ever declared for
#                 `zenoh.<site>`, so that name 404s by design and probing it
#                 grades a healthy router degraded forever. Defaulting
#                 to `probe_gate` means a row that already opted out of the
#                 ADR 1133 gate plane needs no second declaration.
#
# link_path:      optional path the ROW'S LINK points at, default `/`. Distinct
#                 from health_path, which is where the PROBE goes: a service
#                 commonly probes an unauthenticated /ping while its useful page
#                 is elsewhere. Set it where the thing a human wants is a
#                 sub-path — the cross-goatnet relay overview lives at
#                 /goatnets.html on the same host as the fleet dashboard, and
#                 before this column existed it could not be linked at all.
#
# Per-row link target: the per-service `fqdn` becomes the `url` field in the
# emitted JSON (https://<fqdn><link_path>, link_path defaulting to `/`), which
# the index.html SPA renders as the row's link target for `kind=ui` entries.
# This is templating, not DNS — the
# mesh DNS records that resolve those FQDNs to mesh IPs are maintained
# separately (e.g. a site's ops/dns/<site>/mesh-hosts).
#
# Container-name correctness: check.sh looks up the upstream IP via
# `docker inspect <container>` on the value in the `container` column, NOT
# via DNS. If a container is renamed without updating this list (or the
# isitup_services list that templates it), the probe reports HTTP 000 even
# though the service is up.
#
# Rows come from the `isitup_rows` fact (templates/isitup-rows.json.j2), which
# merges this goatnet's isitup_services, the shared off-mesh catalog and the
# ADR 1178 external-service declarations once, deduplicated by id, with unlisted
# and past-retire_after rows already dropped. data/meta.json is rendered from
# the same fact, so the rows probed here and the rows the page describes are
# the same set by construction.
#
# APP_SERVICES_FORMAT declares the column set, so check.sh never has to GUESS
# it from the data. It matters because this file and check.sh are separate
# bind-mounts updated by separate tasks: an aborted play can leave a new
# services.env on disk with the previous check.sh still running in the
# container, and the next cron tick reads the pair. Guessing the shape from
# field contents fails on the one case that matters — a `desc` that happens to
# look like an expect_codes token — so the file says which shape it is.
#   3 = ...|desc|link_path|probe_front_door|expect_codes
#   2 = id|name|fqdn|type|container|port|health_path|kind|access|category|icon|desc|link_path|expect_codes
#   unset = the original shape ending ...|icon|expect_codes
# A check.sh reading a format it does not know falls back to the shape it does
# and defaults probe_front_door to true — the pre-F-430 behaviour — so a
# staggered bind-mount update mis-grades nothing.
{# Free text into a bash double-quoted string: escape the four characters bash
   acts on there. Backslash FIRST, or the escapes added after it get doubled. #}
{% macro _sh(v) %}{{ v | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}{% endmacro %}
APP_SERVICES_FORMAT=3
APP_SERVICES=(
{% for svc in isitup_rows %}
  "{{ svc.id }}|{{ _sh(svc.name) }}|{{ svc.fqdn }}|{{ svc.type }}|{{ svc.container }}|{{ svc.port }}|{{ svc.health_path }}|{{ svc.kind }}|{{ svc.access }}|{{ svc.category }}|{{ svc.icon }}|{{ _sh(svc.desc) }}|{{ svc.link_path }}|{{ svc.probe_front_door | string | lower }}|{{ svc.expect_codes }}"
{% endfor %}
)
