# Rendered by ops/ansible/roles/obs-host on {{ ansible_date_time.iso8601 }}
# Source: ops/ansible/roles/obs-host/templates/prometheus.yml.j2
# Anchor: ADR 0826 — observability lives on Orin-C, scraping the mgmt-host
# pair (Orin-A + Orin-B) via their wg-cp0 internal addresses (post-bringup)
# or LAN IPs (during bringup, before wg-cp0 is up).
#
# DO NOT EDIT THIS FILE ON THE HOST — re-run the obs-host role.

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    site: "{{ site_id }}"
    obs_host: "{{ inventory_hostname }}"

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:

  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # Alertmanager's own counters. Without this scrape a failing delivery
  # (alertmanager_notifications_failed_total) is invisible to alerting
  # and a dead pager is only discoverable in container logs.
  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]

  # The obs host's own node_exporter. The default address is the host's LAN
  # address, which is right where the firewall lets the docker bridge reach it —
  # and wrong on a mesh-only node. A mesh-only host's ufw may be INPUT DROP
  # with exactly two ways in, 22/tcp and anything arriving on wt0, so the scrape
  # leaves the prometheus container, comes back at the LAN address and is dropped:
  # the obs host becomes the one host its own Prometheus cannot see. Override with
  # obs_self_node_target where the mesh address is the reachable one.
  - job_name: obs-host-node
    static_configs:
      - targets: ["{{ obs_self_node_target | default((ansible_default_ipv4.address | default('localhost')) ~ ':9100') }}"]
        labels:
          host_role: obs

  # Targets driven by obs_scrape_targets in group_vars. Each entry's
  # required fields are {name, addr, job}. Optional `metrics_path`
  # overrides the default /metrics (e.g. MinIO's
  # /minio/v2/metrics/cluster). Pre-wg-cp0 mgmt-pair addrs are LAN IPs;
  # post-wg-cp0 they flip to 198.18.0.1 / 198.18.0.5. Phase-2 obs services
  # (MinIO / OpenObserve / OTel Collector) on this same Orin-C use
  # host.docker.internal because they live in separate compose projects.
{% set jobs = obs_scrape_targets | map(attribute='job') | unique | list %}
{% for j in jobs %}
  - job_name: {{ j }}
{% set first_target = (obs_scrape_targets | selectattr('job', 'equalto', j) | list)[0] %}
{% if first_target.metrics_path is defined %}
    metrics_path: "{{ first_target.metrics_path }}"
{% endif %}
    static_configs:
{% for t in obs_scrape_targets if t.job == j %}
      - targets: ["{{ t.addr }}"]
        labels:
          target_name: "{{ t.name }}"
          # `host` is ADDITIVE alongside target_name, not a rename: existing
          # dashboards and rules key on target_name and must keep working.
          # The shared rules from ops/compose/goat-obs/prometheus/rules join on
          # `host` (that is what the goat-obs stack's own scrape jobs label
          # with), so without this the ADR 1128 recording rules would evaluate
          # to nothing here and every bandwidth panel would read as no-data —
          # which on a capacity dashboard means "the link is idle".
          host: "{{ t.host | default(t.name) }}"
{% endfor %}
{% endfor %}
{% if obs_blackbox_enabled | default(false) %}

  # ---------------------------------------------------------------------
  # Active HTTPS probes — and the ONLY source of TLS certificate
  # observability on this host.
  # ---------------------------------------------------------------------
  # The job name is `blackbox-https` and must stay that: every expression in
  # rules/tls-cert-renewal.yml selects on it, including the absent() guard
  # that reports the whole surface going dark. Renaming this job silently
  # disarms all three alerts while the probes keep succeeding.
  #
  # Each target that completes a TLS handshake emits
  # probe_ssl_earliest_cert_expiry as an absolute unix timestamp. The alerts
  # do NOT fire on "a certificate is expiring" — Traefik renews unattended at
  # 30 days remaining — they fire on the negative event: the 30-day mark
  # passed and the certificate was not replaced, meaning renewal has stopped.
  #
  # Coverage is per-target, not per-goatnet: a vhost with no entry here has
  # an unwatched certificate even while these alerts read green from its
  # neighbours. The set is deduped because two services may share a hostname.
{# Probe only what the registry says is LIVE (#1518): drop every declared
   target whose host belongs to an isitup_services row marked
   `lifecycle: planned` / `retiring` or `listed: false` — past-retire_after
   rows and external-service declarations included. The rows arrive as
   obs_blackbox_registry_rows (tasks/main.yml via templates/registry-rows.json.j2,
   read from the mgmt group named by obs_blackbox_registry_group). The same block is in docker-compose.yml.j2;
   keep the two identical. #}
{% set _silenced = [] %}
{% for s in obs_blackbox_registry_rows | default([]) %}
{% if (s.lifecycle | default('live')) != 'live' or (s.listed | default(true) | string | lower) == 'false' %}
{% set _ = _silenced.append((s.fqdn | default('')) | lower) %}
{% endif %}
{% endfor %}
{% set _live_targets = [] %}
{% for t in obs_blackbox_targets | default([]) %}
{% if (t | regex_replace('^https?://', '') | regex_replace('[:/].*$', '') | lower) not in _silenced %}
{% set _ = _live_targets.append(t) %}
{% endif %}
{% endfor %}
{% set probe_targets = _live_targets | unique | list %}
  - job_name: blackbox-https
    metrics_path: /probe
    params:
      module: ["{{ obs_blackbox_module | default('http_gate') }}"]
    static_configs:
{% for t in probe_targets %}
      - targets: ["{{ t }}"]
        labels:
          surface: "{{ t | regex_replace('^https?://', '') | regex_replace('[:/].*$', '') | regex_replace('\..*$', '') }}"
          plane: gate
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
{% endif %}
