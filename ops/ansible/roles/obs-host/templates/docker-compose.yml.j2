# Rendered by ops/ansible/roles/obs-host on {{ ansible_date_time.iso8601 }}
# Source: ops/ansible/roles/obs-host/templates/docker-compose.yml.j2
# Anchor: ADR 0826 (per-site three-Orin topology) — Orin-C observability host.
#
# DO NOT EDIT THIS FILE ON THE HOST — it will be overwritten on next
# Ansible run. Edit the .j2 template + re-run the role.

services:
  prometheus:
    image: {{ prometheus_image }}
    container_name: prometheus
    restart: unless-stopped
    deploy:
      resources:
        limits: { cpus: "1.0", memory: 1G }
        reservations: { memory: 256M }
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ prometheus_retention_days }}d
{% if prometheus_retention_size %}
      # HARD CEILING on the TSDB. Prometheus enforces whichever of time/size
      # is hit first, so this survives a growth in series count that the time
      # limit would not catch. Mandatory on the emmc tier (see role asserts).
      - --storage.tsdb.retention.size={{ prometheus_retention_size }}
{% endif %}
      - --web.enable-lifecycle
      - --web.listen-address=:9090
    volumes:
      - {{ obs_compose_dir }}/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - {{ obs_compose_dir }}/rules:/etc/prometheus/rules:ro
      - {{ obs_data_root }}/prometheus:/prometheus
    ports:
      - "9090:9090"
    networks:
      - obs
    # Phase-2 obs services (MinIO / OpenObserve / OTel Collector) live in
    # separate compose projects on the same host. Prometheus reaches them
    # via `host.docker.internal:<port>` so scrape targets stay portable
    # across hosts (no hardcoded LAN IPs in scrape configs).
    extra_hosts:
      - "host.docker.internal:host-gateway"

  alertmanager:
    image: {{ alertmanager_image }}
    container_name: alertmanager
    restart: unless-stopped
    deploy:
      resources:
        limits: { cpus: "0.5", memory: 256M }
        reservations: { memory: 64M }
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
    volumes:
      - {{ obs_compose_dir }}/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - {{ obs_data_root }}/alertmanager:/alertmanager
    ports:
      - "9093:9093"
    networks:
      - obs

  grafana:
    image: {{ grafana_image }}
    container_name: grafana
    restart: unless-stopped
    deploy:
      resources:
        limits: { cpus: "1.0", memory: 512M }
        reservations: { memory: 128M }
    environment:
      GF_SECURITY_ADMIN_USER: "{{ grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
      GF_INSTALL_PLUGINS: ""
      GF_USERS_ALLOW_SIGN_UP: "false"
      # NO EGRESS — twin of the block in ops/compose/goat-obs/docker-compose.yml
      # (#943). Grafana is mesh-internal and makes no outbound call of its
      # own: update/plugin checkers, usage reporting, the home-page news
      # feed, gravatar, the plugin catalog and signing-key fetch are all off.
      GF_ANALYTICS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: "false"
      GF_ANALYTICS_FEEDBACK_LINKS_ENABLED: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
      GF_SECURITY_DISABLE_GRAVATAR: "true"
      GF_PLUGINS_PUBLIC_KEY_RETRIEVAL_DISABLED: "true"
      GF_PLUGINS_PLUGIN_ADMIN_ENABLED: "false"
      GF_PLUGINS_PLUGIN_CATALOG_HIDDEN: "true"
      GF_HELP_ENABLED: "false"
      GF_SERVER_HTTP_PORT: "3000"
      GF_SERVER_DOMAIN: "{{ grafana_server_domain | default('grafana.' + (site_id) + '.' + (obs_host_grafana_default_zone | default('netbird-prod.goat.example'))) }}"
      GF_SERVER_ROOT_URL: "https://{{ grafana_server_domain | default('grafana.' + (site_id) + '.' + (obs_host_grafana_default_zone | default('netbird-prod.goat.example'))) }}"
{% if operator_idp_enabled | default(false) | bool %}
      # OIDC via operator-IdP Hydra per ADR 0842 + Block 21H.3a.
      # The local-admin path (GF_SECURITY_ADMIN_*) above is preserved
      # as break-glass per ADR 0842 §"Local break-glass preserved";
      # operators normally log in via OIDC.
      GF_AUTH_GENERIC_OAUTH_ENABLED: "true"
      GF_AUTH_GENERIC_OAUTH_NAME: "Operator IdP"
      GF_AUTH_GENERIC_OAUTH_CLIENT_ID: "grafana"
      GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET: "{{ operator_idp_grafana_client_secret }}"
      # `offline_access` requests a refresh_token from Hydra so Grafana's
      # generic_oauth plugin can roll the session at access-token expiry
      # (Hydra default ~1h) instead of bouncing the user back to /login.
      # Must match the OIDC client's allowed scopes (grafana-oidc-client
      # role defaults). Mirror of the nova-obs compose fix from PR #210;
      # see F-138 for the durable observation.
      GF_AUTH_GENERIC_OAUTH_SCOPES: "openid profile email groups offline_access"
      GF_AUTH_GENERIC_OAUTH_AUTH_URL: "https://oauth2.ops.{{ site_id }}.{{ site_dns_zone }}/oauth2/auth"
      GF_AUTH_GENERIC_OAUTH_TOKEN_URL: "https://oauth2.ops.{{ site_id }}.{{ site_dns_zone }}/oauth2/token"
      GF_AUTH_GENERIC_OAUTH_API_URL: "https://oauth2.ops.{{ site_id }}.{{ site_dns_zone }}/userinfo"
      GF_AUTH_GENERIC_OAUTH_USE_PKCE: "true"
      # Group → Grafana built-in role mapping. JMESPath expression
      # against the JWT body. obs-admin OR grafana-admin → Admin;
      # obs-readonly OR grafana-readonly → Viewer; nothing else gets
      # access (login fails for operators with no Grafana group).
      GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH: "contains(groups, 'obs-admin') && 'Admin' || contains(groups, 'grafana-admin') && 'Admin' || contains(groups, 'obs-readonly') && 'Viewer' || contains(groups, 'grafana-readonly') && 'Viewer'"
      GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT: "true"
      # Auto-create Grafana user on first OIDC login. Without this,
      # OIDC succeeds but Grafana 401s because the user doesn't exist
      # in its local DB.
      GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP: "true"
      # Trust the offline-CA root for OIDC HTTPS calls (Hydra cert is
      # signed by the internal X.509 CA per ADR 0407). The root is
      # mounted at /etc/grafana/offline-ca.pem via the volume below.
      GF_AUTH_GENERIC_OAUTH_TLS_CLIENT_CA: "/etc/grafana/offline-ca.pem"
{% endif %}
    volumes:
      - {{ obs_compose_dir }}/grafana/provisioning:/etc/grafana/provisioning:ro
      - {{ obs_data_root }}/grafana:/var/lib/grafana
{% if obs_grafana_dashboards_enabled | default(true) | bool %}
      # Dashboards read-only from the compose dir, deliberately NOT written into
      # the data volume above: /var/lib/grafana holds grafana.db, and repo
      # content does not belong in a stateful volume where a UI edit and a
      # deploy would fight. This nested mount shadows only the dashboards
      # subdirectory; the database beside it is untouched.
      - {{ obs_compose_dir }}/grafana/dashboards:/var/lib/grafana/dashboards:ro
{% endif %}
{% if operator_idp_enabled | default(false) | bool %}
      # Offline-CA root for OIDC TLS verification (consumed by
      # GF_AUTH_GENERIC_OAUTH_TLS_CLIENT_CA above). The role lays this
      # file down in tasks/main.yml from the offline-CA bundle present
      # on every Orin per Block 22K.
      - {{ obs_compose_dir }}/grafana/offline-ca.pem:/etc/grafana/offline-ca.pem:ro
{% endif %}
    ports:
      - "3000:3000"
    networks:
      - obs

  # node_exporter for Orin-C itself. The mgmt-host pair (Orin-A, B) run
  # their own node_exporter via the legacy `observability` role's compose
  # overlay; this one is just for the obs-host's own metrics.
  node-exporter:
    image: {{ node_exporter_image }}
    container_name: node-exporter
    restart: unless-stopped
    deploy:
      resources:
        limits: { cpus: "0.25", memory: 128M }
    command:
      - --path.rootfs=/host
      - --collector.systemd
      - --collector.processes
      # Textfile collector: lets host-side probes publish metrics Prometheus
      # can alert on without each one becoming its own scrape target. Feeds
      # ops/obs/mesh-path-quality (path MTU / jitter / loss), the signals that
      # made a degraded-but-Connected mesh link invisible until a manual RCA.
      - --collector.textfile.directory={{ obs_textfile_dir | default('/textfile') }}
{% for c in obs_node_exporter_disabled_collectors | default([]) %}
      - --no-collector.{{ c }}
{% endfor %}
    pid: host
    network_mode: host
    volumes:
      - /:/host:ro,rslave
      - {{ obs_textfile_host_dir | default('/var/lib/node_exporter/textfile') }}:{{ obs_textfile_dir | default('/textfile') }}:ro

{% if obs_blackbox_enabled | default(false) %}
  # Active HTTPS probing, and the only source of TLS certificate observability
  # on this host. Every target that completes a handshake emits
  # probe_ssl_earliest_cert_expiry, which is what rules/tls-cert-renewal.yml
  # alerts on. Gated on obs_blackbox_enabled because that rule file's
  # absent() guard fires forever on a Prometheus with no blackbox job — see
  # the role defaults.
  blackbox-exporter:
    image: {{ obs_blackbox_image }}
    container_name: blackbox-exporter
    restart: unless-stopped
    deploy:
      resources:
        limits: { cpus: "0.25", memory: 128M }
        reservations: { memory: 32M }
    # ICMP probing needs raw sockets; nothing else is required.
    cap_drop:
      - ALL
    cap_add:
      - NET_RAW
    volumes:
      - ./blackbox.yml:/etc/blackbox_exporter/config.yml:ro
{% if (obs_blackbox_resolve_ip | default('')) | length > 0 %}
    # F-127 / F-282: docker's embedded DNS cannot reach mesh CoreDNS on :5353,
    # so every mesh-zone probe target is NXDOMAIN inside this container without
    # an explicit mapping. The names are the SAME list that drives the probes,
    # so the two cannot drift: a target added above is resolvable by
    # construction. All mesh-zone service names on a site resolve to the site's
    # mgmt-host mesh IP (ops/dns/<site>/mesh-hosts, generated).
    extra_hosts:
{# Deduped: two services may share one hostname (zagros-prod's peerview pair #}
{# both live on isitup.<site>.<zone>), and a repeated extra_hosts entry is #}
{# a duplicate /etc/hosts line for no gain. #}
{# Probe only what the registry says is LIVE (#1518): drop every declared
   target whose host belongs to an isitup_services row marked
   `lifecycle: planned` / `retiring` or `listed: false` — past-retire_after
   rows and external-service declarations included. The rows arrive as
   obs_blackbox_registry_rows (tasks/main.yml via templates/registry-rows.json.j2,
   read from the mgmt group named by obs_blackbox_registry_group). The same block is in docker-compose.yml.j2;
   keep the two identical. #}
{% set _silenced = [] %}
{% for s in obs_blackbox_registry_rows | default([]) %}
{% if (s.lifecycle | default('live')) != 'live' or (s.listed | default(true) | string | lower) == 'false' %}
{% set _ = _silenced.append((s.fqdn | default('')) | lower) %}
{% endif %}
{% endfor %}
{% set _live_targets = [] %}
{% for t in obs_blackbox_targets | default([]) %}
{% if (t | regex_replace('^https?://', '') | regex_replace('[:/].*$', '') | lower) not in _silenced %}
{% set _ = _live_targets.append(t) %}
{% endif %}
{% endfor %}
{% set probe_hosts = _live_targets | map('regex_replace', '^https?://', '') | map('regex_replace', '[:/].*$', '') | unique | list %}
{% for h in probe_hosts %}
      - "{{ h }}:{{ obs_blackbox_resolve_ip }}"
{% endfor %}
{% endif %}
    ports:
      - "127.0.0.1:9115:9115"
    networks:
      - obs

{% endif %}
volumes: {}

networks:
  obs:
    name: obs
