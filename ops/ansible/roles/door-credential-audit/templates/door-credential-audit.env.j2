# Rendered by ops/ansible/roles/door-credential-audit/ — DO NOT EDIT ON HOST.
# Mode 0600: carries a credential for the identity door.
DOOR_AUDIT_PLANE={{ door_credential_audit_plane }}
DOOR_AUDIT_REPORT_DIR={{ door_credential_audit_report_dir }}
DOOR_AUDIT_HISTORY_KEEP={{ door_credential_audit_history_keep }}
DOOR_AUDIT_PROM={{ door_credential_audit_textfile_dir }}/door_credential_audit.prom
# The door the audit reads: the base URL of its Kanidm.
{% if door_credential_audit_plane == 'public' %}
PUBLIC_DOOR_KANIDM_URL={{ door_credential_audit_door_url }}
{% else %}
COLLAB_KANIDM_URL={{ door_credential_audit_door_url }}
{% endif %}
{% if door_credential_audit_token | length > 0 %}
# Read-scoped service-account bearer (preferred).
DOOR_AUDIT_TOKEN={{ door_credential_audit_token }}
{% else %}
# FALLBACK: full-admin identity-plane password. Replace with a scoped token —
# ops/scripts/create-door-audit-identity.sh --plane {{ door_credential_audit_plane }}
{% if door_credential_audit_plane == 'public' %}
GOAT_IDM_ADMIN_PW={{ door_credential_audit_admin_password }}
{% else %}
COLLAB_KANIDM_IDM_ADMIN_PW={{ door_credential_audit_admin_password }}
{% endif %}
{% endif %}
