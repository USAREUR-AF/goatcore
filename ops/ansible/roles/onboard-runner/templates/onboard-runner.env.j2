# onboard-runner mint credentials — rendered by the onboard-runner role into
# {{ onboard_runner_dir }}/.env (0600). NEVER committed. Consumed by docker
# compose (env_file) → the container process env.
#
# ONBOARD_RUNNER_PORTAL_KEY — the runner's OWN portal operator key. Written to the
#   goat profile's portal.token by the entrypoint (the Zenoh CERT-MINT leg → the
#   portal's POST /api/orgs). Must be present in the portal's
#   PORTAL_OPERATOR_API_KEYS as `{{ onboard_runner_runner_id }}:<key>`.
# ONBOARD_API_TOKEN — the runner's bearer for the onboarding CONTRACT (approved
#   queue / claim / result), which moved to goat-id-console
#   (docs/design/onboarding-extraction-plan.md). The console must carry this same
#   key in ONBOARD_OPERATOR_API_KEYS as `{{ onboard_runner_runner_id }}:<key>` so
#   the runner is attributed per-handle. Reuses the runner's portal key
#   value — one runner identity, two legs.
# {{ site_id | upper }}_NB_API_TOKEN — the native NetBird leg reads this exact
#   env name to mint the setup key (goat's native_netbird_config for {{ site_id }}).
ONBOARD_RUNNER_PORTAL_KEY={{ onboard_runner_portal_key }}
ONBOARD_API_TOKEN={{ onboard_runner_portal_key }}
{# `| replace('-','_')` is load-bearing (third hit of the hyphenated-site_id
   class, 2026-08-04): a hyphenated site_id rendered `<SITE>-PROD_NB_API_TOKEN`,
   an env name goat's `<SITE>_NB_API_TOKEN` lookup can never match — the mesh
   leg failed and every admin approval landed the proposal in Failed. #}
{{ site_id | upper | replace('-', '_') }}_NB_API_TOKEN={{ onboard_runner_nb_api_token }}
{% if onboard_runner_operator_age_recipients %}
# GOAT_OPERATOR_AGE_RECIPIENTS — operator-action audit encrypt roster. When
# the runner mints on an operator's behalf it emits one OperatorActionV1 age-encrypted
# to this comma/newline-separated set of age recipients; unset ⇒ goat falls back to a
# local plaintext log (no roster encryption). Resolved at deploy time from the operator
# env (40-dev-ca-operators.envrc) — recipients are public keys but never committed
# literally (the identity-spillage CI guard forbids age recipients in tracked files).
GOAT_OPERATOR_AGE_RECIPIENTS={{ onboard_runner_operator_age_recipients }}
{% endif %}
{% if onboard_runner_collab_enabled and (onboard_runner_collab_kanidm_api_token or onboard_runner_collab_kanidm_admin_pw) %}
# COLLAB_* — the collaboration-environment provisioning leg
# (docs/design/collab-onboarding-provisioner.md). When a manifest carries
# collab.enabled, the runner mints a FLAT account in the collab Dex+Kanidm plane
# (SEPARATE from the mesh Ory) + stages a one-time setup link. Best-effort. Auth
# prefers a scoped service-account token; the idm_admin pw is the fallback. Both
# are secrets resolved at deploy from the operator env, never committed. The line
# is rendered only when the leg is enabled AND a credential is present.
COLLAB_PROVISION_ENABLED=1
COLLAB_KANIDM_URL={{ onboard_runner_collab_kanidm_url }}
{# The comment above says the credential line renders "only when the leg is
   enabled AND a credential is present". It did not check the third condition
   that matters: whether there is a collab door to authenticate TO. The URL and
   the credential resolve from independent sources — the URL from a per-goatnet
   group_var, the credential from the operator's own environment — so on a
   goatnet with no collab door the URL renders EMPTY while the password renders
   POPULATED: a live Kanidm idm_admin password sitting in the container's
   Config.Env, readable by any
   `docker inspect onboard-runner`, for a service the goatnet does not run.
   Gate both credentials on the URL: no door, no secret shipped. #}
{% if onboard_runner_collab_kanidm_url %}
{% if onboard_runner_collab_kanidm_api_token %}
COLLAB_KANIDM_API_TOKEN={{ onboard_runner_collab_kanidm_api_token }}
{% else %}
COLLAB_KANIDM_IDM_ADMIN_PW={{ onboard_runner_collab_kanidm_admin_pw }}
{% endif %}
{% endif %}
{% endif %}

# Read by docker-entrypoint.sh, which writes it into the runner's goat profile as
# router_endpoint — the operator-action audit emit needs it.
ROUTER_ENDPOINT={{ onboard_runner_router_endpoint }}

# Per-goatnet endpoints the native onboard legs need. docker-entrypoint.sh
# writes each non-empty one into the runner's goat profile, where goat prefers it
# over its built-in table — so a NEW goatnet is a config change here, not a
# goat-cli release. Every value mirrors a group_var and none is invented.
NETBIRD_MGMT_URL={{ onboard_runner_netbird_mgmt_url }}
NETBIRD_TOKEN_ENV={{ onboard_runner_netbird_token_env }}
NETBIRD_SITE_PREFIX={{ onboard_runner_netbird_site_prefix }}
NETBIRD_ROSENPASS={{ onboard_runner_netbird_rosenpass | lower }}
ORY_AUTH_URL={{ onboard_runner_ory_auth_url }}
ORY_SSH_HOST={{ onboard_runner_ory_ssh_host }}
ORY_SSH_USER={{ onboard_runner_ory_ssh_user }}
