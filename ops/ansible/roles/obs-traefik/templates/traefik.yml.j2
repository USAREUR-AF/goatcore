# Traefik static config — rendered by obs-traefik on {{ ansible_date_time.iso8601 }}
# DO NOT EDIT on host; edit the .j2 + re-run the role.

global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO
  format: json

accessLog:
  format: json
  filters:
    statusCodes:
      - "400-599"
    minDuration: "100ms"

entryPoints:
  websecure:
    address: ":443"
  traefik:
    # Traefik dashboard / admin API. Bound to localhost only via
    # docker port mapping in docker-compose.yml.j2 — never exposed
    # publicly.
    address: ":8080"

api:
  insecure: true
  dashboard: true

providers:
  file:
    directory: {{ obs_traefik_dynamic_dir }}
    watch: true
