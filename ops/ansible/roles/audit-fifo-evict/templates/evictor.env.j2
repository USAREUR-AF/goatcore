# {{ ansible_managed }} — mode 0600, never committed.
# MC_HOST_<alias> carries the credential, so it never appears in a command
# line or in `ps` output.
{% set _scheme, _rest = audit_fifo_evict_endpoint.split('://', 1) %}
MC_HOST_{{ audit_fifo_evict_alias }}={{ _scheme }}://{{ audit_fifo_evict_access_key }}:{{ audit_fifo_evict_secret }}@{{ _rest }}
