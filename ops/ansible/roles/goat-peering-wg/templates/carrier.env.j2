# {{ ansible_managed }}
# The carrier to the peering forwarder. Dialled from here; no firewall of its own,
# because what arrives on it is filtered by {{ peering_wg_nft_path }}.
WG_IFNAME={{ peering_wg_carrier_interface }}
WG_KEY_FILE={{ peering_wg_carrier_key_path }}
WG_LISTEN_PORT={{ peering_wg_carrier_listen_port }}
WG_MTU={{ peering_wg_carrier_mtu }}
WG_LINK_ADDR={{ peering_wg_carrier_local_ip }}/{{ peering_wg_carrier_prefix_len }}
WG_PEER_KEY={{ peering_wg_forwarder_carrier_public_key }}
WG_PEER_ALLOWED={{ peering_wg_carrier_remote_ip }}/32
WG_PEER_ENDPOINT={{ peering_wg_forwarder_endpoint }}
WG_PEER_KEEPALIVE={{ peering_wg_carrier_keepalive }}
