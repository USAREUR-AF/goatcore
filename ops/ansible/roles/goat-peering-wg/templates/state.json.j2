{{ {
  "timestamp": ansible_date_time.iso8601,
  "hostname": ansible_hostname,
  "interface": peering_wg_interface,
  "kernel": ansible_kernel,
  "decision": _pw_decision,
  "identity": {
    "our_sovereign_id": peering_wg_our_sovereign,
    "their_sovereign_id": peering_wg_partner_sovereign,
    "peer_public_key": _pw_peer_key
  },
  "transport": {
    "kind": peering_wg_kind,
    "link_subnet": peering_wg_local_link_ip ~ "/" ~ peering_wg_link_prefix_len,
    "remote_link_ip": peering_wg_remote_link_ip,
    "we_listen": peering_wg_we_listen | bool,
    "mtu": peering_wg_mtu,
    "fabric_port": peering_wg_fabric_port
  } | combine({
    "via_forwarder": {
      "carrier_interface": peering_wg_carrier_interface,
      "forwarder_endpoint": peering_wg_forwarder_endpoint,
      "forwarder_carrier_public_key": peering_wg_forwarder_carrier_public_key,
      "carrier_subnet": peering_wg_carrier_local_ip ~ "/" ~ peering_wg_carrier_prefix_len,
      "carrier_mtu": peering_wg_carrier_mtu
    }
  } if (peering_wg_via_forwarder | bool) else {}),
  "observed": {
    "kernel_fips_enabled": ((_pw_kernel_fips_raw.content | default('MA==') | b64decode | trim) == '1')
  },
  "fips": {
    "required": peering_wg_fips_required | bool,
    "claimed": false,
    "waived_reason": peering_wg_fips_waived_reason
  }
} | to_nice_json }}
