## nova-lan — closed-LAN DNS server (CoreDNS, authoritative for {{ lan_coredns_zone_name }})
## Rendered by ops/ansible/roles/lan-coredns from this template.
## Block 13A supply chain hardening (vs jpillora/dnsmasq:latest).
## Image: coredns/coredns (official CNCF, Docker Hub verified publisher).
## An overlay may set a hardened catalogue image through the role variable (ADR 1220).

services:
  coredns:
    container_name: {{ lan_coredns_container_name }}
    image: {{ lan_coredns_image }}
    restart: unless-stopped
    network_mode: host
    volumes:
      - ./Corefile:/etc/coredns/Corefile:ro
      - ./{{ lan_coredns_zone_name }}.hosts:/etc/zone/{{ lan_coredns_zone_name }}.hosts:ro
    command: ["-conf", "/etc/coredns/Corefile"]
    logging:
      driver: json-file
      options:
        max-size: "1m"
        max-file: "3"
