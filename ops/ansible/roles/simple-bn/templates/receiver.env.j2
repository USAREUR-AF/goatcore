# Rendered by the simple-bn role from the goatnet's declaration. Mode 600. Do not edit on the host.
SIMPLE_BN_DEST={{ _simple_bn_dest or 'none' }}
SIMPLE_BN_LABEL={{ simple_bn.receiver.label }}
SIMPLE_BN_NODE={{ simple_bn.node }}
SIMPLE_BN_FEEDS={{ simple_bn.feeds | join(',') }}
SIMPLE_BN_SAC={{ simple_bn.sac | default(0) }}
SIMPLE_BN_PROFILES={{ (simple_bn_etc ~ '/profiles.json') if simple_bn.profiles is defined else 'none' }}
SIMPLE_BN_TRANSPORT={{ simple_bn.receiver.transport | default('udp') }}
SIMPLE_BN_ENCRYPTION={{ 'ipsec' if (_sbn_ipsec.wanted | default(false)) else simple_bn_encryption_by_stage[simple_bn.encryption.stage | default(0) | int] }}
SIMPLE_BN_SRC_ADDR={{ _sbn_ipsec.conf.src_addr if (_sbn_ipsec.wanted | default(false)) else 'none' }}
SIMPLE_BN_INPUT={{ simple_bn.input | default('notional') }}
SIMPLE_BN_FEEDBACK_PORT={{ simple_bn.receiver.feedback_port | default(0) }}
SIMPLE_BN_RELAY_INTAKE={{ (_simple_bn_intake.stdout | trim) if (_simple_bn_relay | bool) else 'none' }}
SIMPLE_BN_RELAY_FROM={{ (_simple_bn_relay_from or 'none') if (_simple_bn_relay | bool) else 'none' }}
SIMPLE_BN_WG_INTERFACE={{ simple_bn.wireguard.interface if (simple_bn.encryption.stage | default(0) | int) == 1 else 'none' }}
SIMPLE_BN_RELAY_DEST={{ _simple_bn_relay_dest | default("none") }}
SIMPLE_BN_SCENE_REF={{ (simple_bn.scene.reference | join(',')) if simple_bn.scene is defined else 'none' }}
SIMPLE_BN_SIM_STATUS_URL={{ simple_bn.sim_status_url | default("none") }}
{% for name in _simple_bn_position_envs | default([]) %}
{{ name }}={{ lookup('env', name) | trim }}
{% endfor %}
{% for name in _simple_bn_undulation_envs | default([]) %}
{{ name }}={{ lookup('env', name) | trim }}
{% endfor %}
