# Rendered by the simple-bn role from the goatnet's declaration. Mode 600. Do not edit on the host.
SIMPLE_BN_DEST={{ _simple_bn_dest }}
SIMPLE_BN_LABEL={{ simple_bn.receiver.label }}
SIMPLE_BN_NODE={{ simple_bn.node }}
SIMPLE_BN_FEEDS={{ simple_bn.feeds | join(',') }}
SIMPLE_BN_SAC={{ simple_bn.sac | default(0) }}
SIMPLE_BN_PROFILES={{ (simple_bn_etc ~ '/profiles.json') if simple_bn.profiles is defined else 'none' }}
SIMPLE_BN_TRANSPORT={{ simple_bn.receiver.transport | default('udp') }}
SIMPLE_BN_ENCRYPTION={{ simple_bn_encryption_by_stage[simple_bn.encryption.stage | default(0) | int] }}
SIMPLE_BN_INPUT={{ simple_bn.input | default('notional') }}
SIMPLE_BN_FEEDBACK_PORT={{ simple_bn.receiver.feedback_port | default(0) }}
