{
  "Version": "2012-10-17",
  "Statement": [
    { "Effect": "Allow", "Action": ["s3:ListBucket"], "Resource": ["arn:aws:s3:::{{ minio_replay_bucket }}"], "Condition": {"StringLike": {"s3:prefix": ["{{ audit_subscriber_id }}/*"]}} },
    { "Effect": "Allow", "Action": ["s3:GetObject"], "Resource": ["arn:aws:s3:::{{ minio_replay_bucket }}/{{ audit_subscriber_id }}/*"] }
  ]
}
