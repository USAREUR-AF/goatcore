# Generated by the `minio` Ansible role — do not edit on host.
# Rendered to {{ minio_console_traefik_dynamic_dir }}/{{ minio_console_traefik_dynamic_filename }}
# only when minio_console_traefik_enabled is true.
#
# Mesh-internal exposure of the MinIO web console. Mirrors the portal /
# panoscope / airdefenders file-provider router pattern: a websecure router
# fronted by Let's Encrypt, optional mesh-only IP gating, upstream addressed
# by the console host-port on the mesh IP (minio publishes 9000/9001 on the
# host — the same addressing panoscope/stethoscope use for the MinIO API, so
# Traefik needs no minio-net join).
#
# Auth is NOT an oauth2-proxy forwardAuth here: the MinIO console does its
# own OIDC against Ory Hydra (MINIO_IDENTITY_OPENID_* in the compose), so a
# forwardAuth in front would double-gate. The mesh-only middleware (when set)
# still limits reachability to mesh source IPs. Filename is per-site so a
# redeploy can't stomp neighboring routes.

http:
  routers:
    {{ minio_console_traefik_router_name }}:
      rule: "Host(`{{ minio_console_traefik_host }}`)"
      entryPoints:
        - websecure
      service: {{ minio_console_traefik_router_name }}
{% if (minio_console_traefik_mesh_only_middleware | default('') | length > 0) or (minio_console_traefik_ratelimit_middleware | default('') | length > 0) %}
      middlewares:
{% if minio_console_traefik_mesh_only_middleware | default('') | length > 0 %}
        # Mesh-only gating — middleware defined in the site's mgmt Traefik
        # dynamic config.
        - "{{ minio_console_traefik_mesh_only_middleware }}"
{% endif %}
{% if minio_console_traefik_ratelimit_middleware | default('') | length > 0 %}
        # Browsing rate ceiling, 50 r/s per source peer — `goat-ratelimit`
        # from mgmt-dynamic.yml.j2, attached per router (the
        # entrypoint keeps only the 3000 r/s ceiling). See
        # docs/design/surface-overload-protection.md §3.1.
        - "{{ minio_console_traefik_ratelimit_middleware }}"
{% endif %}
{% endif %}
      tls:
        certResolver: {{ minio_console_traefik_cert_resolver }}

  services:
    {{ minio_console_traefik_router_name }}:
      loadBalancer:
        servers:
          - url: "{{ minio_console_traefik_upstream }}"
