<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd LaunchDaemon — snitch probe (macOS).
  Block 61H multi-platform builds. Bundle-onboarded macOS hosts (rare today,
  but explicit so Apple-Silicon operator laptops can participate in fleet
  health visibility). Mirrors the systemd unit's behavior:
    - run-at-load + keep-alive (= Restart=always)
    - throttle 30s (= RestartSec=30)
    - log to /var/log/snitch-probe.log (= journald)
  No equivalent of NoNewPrivileges / ProtectSystem on launchd; macOS sandbox
  profiles would be the analog but are deferred (snitch already runs as a
  least-privileged service per the AmbientCapabilities posture on Linux).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ snitch_probe_launchd_label }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/snitch</string>
    <string>probe</string>
    <string>--collector</string>
    <string>{{ snitch_collector_url }}</string>
    <string>--interval</string>
    <string>{{ snitch_probe_interval }}</string>
    <string>--cycle-budget</string>
    <string>{{ snitch_probe_cycle_budget }}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SNITCH_COLLECTOR</key>
    <string>{{ snitch_collector_url }}</string>
    <key>SNITCH_PROBE_KEY</key>
    <string>snitch_{{ snitch_probe_key_resolved }}</string>
{% if snitch_relay_urls | length > 0 %}
    <key>SNITCH_RELAY_URLS</key>
    <string>{{ snitch_relay_urls }}</string>
{% endif %}
{% if snitch_probe_disabled | length > 0 %}
    <key>SNITCH_PROBE_DISABLED</key>
    <string>{{ snitch_probe_disabled }}</string>
{% endif %}
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/var/log/snitch-probe.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/snitch-probe.log</string>
</dict>
</plist>
