# Rendered by ops/ansible/roles/goat-zenoh/. Do not edit on host.
#
# Heals the power-cycle boot race where the Zenoh router (host port pinned
# to the netbird mesh IP) starts before netbird has assigned that IP, dies
# with exit 255, and takes every mTLS client down with it. See the script
# header for the why.
[Unit]
Description=Start the Zenoh router once the netbird mesh IP is assigned
# Docker must be up (we drive `docker compose`). netbird.service active is
# necessary-but-not-sufficient (the daemon goes active before it finishes
# enrolling + binding the mesh IP), so the script still polls for the IP.
After=docker.service netbird.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/{{ zenoh_stack }}-mesh-boot.sh

[Install]
WantedBy=multi-user.target
