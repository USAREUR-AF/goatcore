# goat — mesh DNS server (CoreDNS)
# Rendered by ops/ansible/roles/mesh-coredns. Per-site bind IP is the host's
# mesh IP (NOT LAN IP) — keeps DNS strictly on the WireGuard overlay.
# Netbird nameserver group must point peers at {{ mesh_coredns_bind_ip }}:{{ mesh_coredns_port }}.
#
# Block 79 (2026-05-09): when mesh_coredns_wg_cp0_bind_ip is also set,
# CoreDNS binds an additional listener on the wg-cp0 address. This lets
# operator laptops on the silent control plane resolve mesh-internal
# hostnames pre-netbird-enrollment (closes the chicken-and-egg that
# would otherwise force IP-literal URLs and trip F-104).

.:{{ mesh_coredns_port }} {
    # Listen only on loopback + mesh interface(s). Public-internet exposure
    # of the mgmt-internal DNS resolver would violate the silent-control-plane
    # invariant (ADR 0313/0314).
    bind 127.0.0.1{% if mesh_coredns_bind_ip | length > 0 %} {{ mesh_coredns_bind_ip }}{% endif %}{% if mesh_coredns_wg_cp0_bind_ip | length > 0 %} {{ mesh_coredns_wg_cp0_bind_ip }}{% endif %}


{% if mesh_coredns_decoy_zone | default('') | length > 0 %}
    # Decoy names (ADR 1247, docs/design/deception-layer.md): every single
    # label under the service zone that ends in an 8-character tag resolves to
    # the host whose Traefik fronts the decoy responder. The mesh-hosts file
    # cannot hold them because the responder names new ones without end. A
    # real name never has this shape: the decoy role refuses to deploy if one does.
    template IN A {{ mesh_coredns_decoy_zone }} {
        match "^[a-z0-9][a-z0-9-]*-[a-z2-7]{8}\.{{ mesh_coredns_decoy_zone | regex_escape }}\.$"
        answer "{{ '{{' }} .Name {{ '}}' }} 30 IN A {{ mesh_coredns_decoy_answer_ip }}"
        fallthrough
    }
    template IN AAAA {{ mesh_coredns_decoy_zone }} {
        match "^[a-z0-9][a-z0-9-]*-[a-z2-7]{8}\.{{ mesh_coredns_decoy_zone | regex_escape }}\.$"
        rcode NOERROR
        fallthrough
    }

{% endif %}
    # Serve all records from mesh-hosts (standard /etc/hosts format).
    # reload 5s picks up peer additions without a container restart.
    hosts /etc/mesh-hosts {
        reload 5s
        no_reverse
{% if mesh_coredns_forwarders | length > 0 %}
        fallthrough
{% endif %}
    }

{# mesh_coredns_forwarders (defaults/main.yml): where a name outside the mesh
   zone goes. The default list renders the line every goatnet ran before. #}
{% if mesh_coredns_forwarders | length > 0 %}
    # Forward non-mesh queries to public DNS.
    forward . {{ mesh_coredns_forwarders | join(' ') }}
{% else %}
    # mesh_coredns_forwarders is empty: no forward directive. The zone file
    # is the last answer: a name outside it gets SERVFAIL from the hosts
    # plugin, and no query leaves this resolver.
{% endif %}

    cache 1000

    log
    errors
}
