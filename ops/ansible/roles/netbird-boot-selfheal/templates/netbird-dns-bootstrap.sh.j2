#!/bin/bash
# netbird-dns-bootstrap — resolve the netbird mgmt endpoint against a
# LAN-permitted resolver and pin the CURRENT IPs in /etc/hosts, so netbird can
# reach mgmt at boot before the mesh (and its CoreDNS) exist. Runs as an
# ExecStartPre of netbird.service. Self-refreshing every boot (no stale pin),
# and independent of systemd-resolved (which is not honored on the Jetson).
# Managed by ops/ansible/roles/netbird-boot-selfheal — DO NOT EDIT ON HOST.
set -u
NAME="${1:-{{ site_enrollment_dns }}}"
DNS="${2:-{{ netbird_selfheal_bootstrap_dns[0] }}}"
MARK="# nb-dns-bootstrap"

IPS=$(python3 - "$NAME" "$DNS" <<'PY'
import socket, struct, sys, random
name, server = sys.argv[1], sys.argv[2]
try:
    q = struct.pack(">HHHHHH", random.randint(0, 65535), 0x0100, 1, 0, 0, 0)
    for p in name.split("."):
        q += struct.pack("B", len(p)) + p.encode()
    q += b"\x00" + struct.pack(">HH", 1, 1)
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.settimeout(4)
    s.sendto(q, (server, 53)); d, _ = s.recvfrom(512); s.close()
    n = 12
    while d[n] != 0:
        n += 1 + d[n]
    n += 5
    an = struct.unpack(">H", d[6:8])[0]; out = []
    for _ in range(an):
        n += 2; typ = struct.unpack(">H", d[n:n+2])[0]; n += 8
        rl = struct.unpack(">H", d[n:n+2])[0]; n += 2
        if typ == 1 and rl == 4:
            out.append(socket.inet_ntoa(d[n:n+4]))
        n += rl
    print("\n".join(out))
except Exception:
    pass
PY
)

# No answer (resolver unreachable): keep whatever pin already exists, don't wipe it.
[ -z "$IPS" ] && exit 0

# Rewrite the managed block idempotently.
tmp="$(mktemp)"
grep -v "$MARK" /etc/hosts > "$tmp" 2>/dev/null || cp /etc/hosts "$tmp"
for ip in $IPS; do
  echo "$ip $NAME $MARK" >> "$tmp"
done
cat "$tmp" > /etc/hosts
rm -f "$tmp"
exit 0
