[Unit]
Description=Write spock_subscription_forward_origins for node-exporter's textfile collector
Documentation=https://github.com/usareur-af/goatcore/blob/main/docs/design/spock-mesh-peering.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/spock-forward-origins.sh prom {{ spock_forward_origins_check_container }} {{ spock_forward_origins_metrics_dir }}/spock_forward_origins.prom
# Runs as root for docker.sock. It reads the catalog through docker exec psql
# and writes one file in the textfile directory; nothing else is writable.
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ spock_forward_origins_metrics_dir }} /var/run/docker.sock
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
StandardOutput=journal
StandardError=journal
