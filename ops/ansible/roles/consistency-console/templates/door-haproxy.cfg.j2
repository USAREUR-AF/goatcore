# {{ ansible_managed }}
# door — env-doors Tier 2 lane client for the CF-7 hosted aggregator
# (ADR 1117; env-doors.md §"Tier 2"; consistency-foundation.md §7.8 as-built).
#
# Accepts the console's zenoh TLS stream on :17447 and wraps it in an OUTER
# mTLS connection to the peer goatnet's relay ingress: client cert signed by the
# offline dev CA, SNI pinned to {{ consistency_aggregator_door_sni }}
# (the relay dispatcher routes that SNI fail-closed to the door host's rathole
# tunnel; that host's Traefik terminates the outer TLS with
# RequireAndVerifyClientCert and raw-forwards to the router's zenoh tls/:7447).
# The INNER zenoh mTLS session — the console's subscribe-only leaf against
# the peer goatnet's zenoh CA — is untouched end-to-end.
#
# Modeled on federation-proxy-haproxy.cfg.j2 (the proven relay-tunneled TLS
# client shape): Docker-resolver DNS with outage-safe startup, check-ssl so a
# wedged tunnel marks a leg DOWN instead of blackholing,
# and verify required + verifyhost so this proxy never hands the zenoh
# stream to an unauthenticated TLS endpoint. All relay legs are equivalent
# (the SNI pin makes every relay land on the door host) — first healthy leg carries.

global
    log stdout format raw local0 notice
    maxconn 256

resolvers docker
    nameserver dockerdns 127.0.0.11:53
    resolve_retries 3
    timeout resolve 2s
    timeout retry 1s
    hold valid 30s
    hold obsolete 300s

defaults
    mode tcp
    log global
    option dontlognull
    timeout connect 5s
    timeout client 300s
    timeout server 300s
    # The zenoh session is one long-lived connection kept warm by zenoh's
    # own keepalives; once bytes flow both ways the tunnel timeout governs.
    timeout tunnel 24h
    retries 2
    option redispatch
    default-server init-addr last,libc,none resolvers docker

listen {{ consistency_aggregator_door_name }}
    bind :17447
{% for relay in consistency_aggregator_door_relays %}
    server {{ relay.split('.')[0] | replace('relay-', '') }} {{ relay }}:443 ssl sni str({{ consistency_aggregator_door_sni }}) verify required verifyhost {{ consistency_aggregator_door_sni }} ca-file /etc/ssl/certs/ca-certificates.crt crt /certs/{{ consistency_aggregator_door_name }}/client.pem check check-ssl check-sni {{ consistency_aggregator_door_sni }} inter 5s fall 3 rise 2
{% endfor %}
