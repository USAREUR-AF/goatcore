# SPDX-License-Identifier: Apache-2.0
# Generated by the goat-zenoh-portal Ansible role — do not edit on host.
# Rendered to {{ portal_traefik_dynamic_dir }}/{{ portal_traefik_dynamic_filename }}.
#
# Matches the panoscope + airdefenders pattern: file-provider router
# on Traefik, upstream addressed by Docker network alias on the `mgmt`
# network, Let's Encrypt cert via the `le` resolver. Filename intentionally
# distinct from mgmt.yml + airdefenders.yml + panoscope.yml so a
# portal redeploy can't stomp on neighboring routes.

http:
{% if portal_problem_pages_enabled | default(false) %}
  middlewares:
    # A 429 from either limiter below is answered with the problem body the
    # API document promises, fetched from the problem-pages sidecar. Only
    # 429: a 5xx range here would mask a portal fault behind a constant page.
    # Listed on the request router AFTER the mesh gate (a source the gate
    # refuses never causes a page fetch) and BEFORE the limiters (an errors
    # middleware only sees the status of what it wraps). It also wraps the
    # portal itself, so a 429 a handler produced would be replaced too; the
    # portal produces none (#1247's openapi_contract_test.go holds that
    # invariant).
    # Not on the stream router, which carries no limiter.
    {{ portal_traefik_router_name }}-problems:
      errors:
        status:
          - "429"
        service: {{ portal_traefik_router_name }}-problems
        query: "/{status}.json"

{% endif %}
  routers:
    {{ portal_traefik_router_name }}:
      rule: "Host(`{{ portal_traefik_host }}`)"
      entryPoints:
        - websecure
      service: {{ portal_traefik_router_name }}
{% if (portal_traefik_mesh_only_middleware | default('') | length > 0) or (portal_traefik_inflight_middleware | default('') | length > 0) or (portal_traefik_ratelimit_middleware | default('') | length > 0) or (portal_problem_pages_enabled | default(false)) %}
      middlewares:
{% if portal_traefik_mesh_only_middleware | default('') | length > 0 %}
        # Mesh-only gating — middleware defined in mgmt-dynamic.yml.j2.
        - "{{ portal_traefik_mesh_only_middleware }}"
{% endif %}
{% if portal_problem_pages_enabled | default(false) %}
        - "{{ portal_traefik_router_name }}-problems"
{% endif %}
        # Concurrency ceiling, per source peer.
        #
        # goat-ratelimit caps REQUESTS PER SECOND, which
        # assumes requests cost roughly the same. Portal auth briefly did not:
        # one request could cost 11.7 CPU-seconds, so a caller sitting at ~1
        # r/s — well under the 50 r/s ceiling and completely invisible to it —
        # held 8-12 of the host's 14 cores. A rate limit cannot see that; a
        # concurrency limit can, because expensive requests are the ones that
        # stay in flight.
        #
        # The auth fix removed that specific cost, so nothing legitimate comes
        # near this number today (post-fix requests finish in milliseconds and
        # in-flight depth per peer is ~1). It is here so the NEXT expensive
        # handler on this surface is bounded on the day it ships rather than
        # the day someone notices the CPU graph.
        #
        # Deliberately NOT attached at the entrypoint like goat-entrypoint-ceiling: an
        # in-flight cap counts a held-open SSE stream against its source for
        # the life of the stream, so a universal one would throttle peers for
        # doing exactly what the streaming surfaces ask of them. This applies
        # to the portal's request router only — the stream router below is
        # split out (ADR 1133) and deliberately does not carry it.
{% if portal_traefik_inflight_middleware | default('') | length > 0 %}
        - "{{ portal_traefik_inflight_middleware }}"
{% endif %}
{% if portal_traefik_ratelimit_middleware | default('') | length > 0 %}
        # Browsing rate ceiling, per source peer (tier 2 of two).
        # The entrypoint carries only the 3000 r/s control-plane ceiling;
        # the 50 r/s browsing limiter is attached per router, and the stream
        # router below deliberately does not carry it.
        - "{{ portal_traefik_ratelimit_middleware }}"
{% endif %}
{% endif %}
{# Empty resolver = file-provider TLS: the cert comes from the site's
   tls.certificates store (internal-CA LAN posture) #}
{% if portal_traefik_cert_resolver | default('') | length > 0 %}
      tls:
        certResolver: {{ portal_traefik_cert_resolver }}
{% else %}
      tls: {}
{% endif %}

    # ---------------------------------------------------------------------
    # The SSE route, split onto its own router (ADR 1133).
    # ---------------------------------------------------------------------
    # SAME service, SAME TLS, and the mesh gate as its only middleware:
    # neither limiter is attached here (see portal_traefik_ratelimit_middleware
    # in defaults) and no errors page, since nothing on this router answers
    # 429. It exists so the metric can be separated.
    #
    # Why: Traefik times a request open-to-close, so a peer holding
    # /api/topics/stream open for twenty minutes is recorded as one
    # 1200-second request, so that route dominates the slow-request count and
    # makes the portal read as the slowest thing on the goatnet. Dropping the ENTIRE
    # service from every percentile would throw away the real
    # page latency along with the noise.
    #
    # --metrics.prometheus.addRoutersLabels=true alone would NOT have fixed
    # that: the router above matches Host() only, so every path on the host
    # shares one router label and the aggregate stays fused. The split has to
    # exist in the routing table for the label to mean anything.
    #
    # Priority is explicit rather than relying on Traefik's default
    # longest-rule-wins. The default would in fact pick this router (its rule
    # is longer), but "the more specific route wins" is too load-bearing to
    # leave implicit — if it silently lost, the stream would fall back to the
    # Host router and the fusion would return with no visible symptom.
    {{ portal_traefik_router_name }}-stream:
      rule: "Host(`{{ portal_traefik_host }}`) && PathPrefix(`/api/topics/stream`)"
      priority: 100
      entryPoints:
        - websecure
      service: {{ portal_traefik_router_name }}
{% if portal_traefik_mesh_only_middleware | default('') | length > 0 %}
      middlewares:
        - "{{ portal_traefik_mesh_only_middleware }}"
{% endif %}
{% if portal_traefik_cert_resolver | default('') | length > 0 %}
      tls:
        certResolver: {{ portal_traefik_cert_resolver }}
{% else %}
      tls: {}
{% endif %}

  services:
    {{ portal_traefik_router_name }}:
      loadBalancer:
        servers:
          - url: "http://{{ portal_container_name }}:{{ portal_listen_port }}"
{% if portal_problem_pages_enabled | default(false) %}
    {{ portal_traefik_router_name }}-problems:
      loadBalancer:
        servers:
          - url: "http://{{ portal_problem_pages_container_name }}:{{ portal_problem_pages_listen_port }}"
{% endif %}
