# Rendered by goat-zenoh-portal Ansible role — DO NOT HAND-EDIT.
# Operator-only Bearer token consumed by the portal at startup.
PORTAL_OPERATOR_API_KEY={{ portal_operator_api_key }}
# Per-person operator keys — `handle:key,handle:key`. Additive to the
# single key above; empty = legacy single-key behaviour.
PORTAL_OPERATOR_API_KEYS={{ portal_operator_api_keys }}
# Service operator-key store dir (machine keys written by their own roles;
# survives a portal redeploy — decouples machine creds from the deploy env).
PORTAL_OPERATOR_API_KEYS_DIR={{ portal_operator_keys_dir }}
# How often that directory is re-read. Issuing or revoking an operator key is
# then an ordinary write into the directory rather than an envrc edit plus a
# portal redeploy — the governance that matters is an admin approving, and
# approval never needed a restart. 0 restores the startup-only behaviour.
PORTAL_OPERATOR_API_KEYS_RELOAD={{ portal_operator_keys_reload_interval }}
PORTAL_OPERATOR_APPROVAL_REQUIRED={{ 'true' if portal_operator_approval_required else 'false' }}
# Subject O of every leaf the portal mints (cert-sign --org), from
# goat_cert_organization. Empty = the flag is omitted and cert-sign's built-in
# default applies.
PORTAL_CERT_SIGN_ORG={{ portal_cert_sign_org | trim }}
# fabric_name reported by GET /api/fabric/config. Empty = the portal's built-in value.
PORTAL_FABRIC_NAME={{ portal_fabric_name | default('') }}
{% if portal_store | default('sqlite') == 'postgres' %}

# Registry store (ADR 1165 step A): the portal_registry database on postgres-a.
# The server reads only this; the SQLite file is the read-only cutover archive.
PORTAL_DB_DSN={{ portal_db_dsn }}
{% endif %}

# Identity model (ADR 1025). per-uuid-slot-pool requires the salt to match
# the router role's zenoh_slot_pool_salt byte-for-byte and the size to equal
# zenoh_slot_pool_size. The role default is per-vendor.
PORTAL_IDENTITY_MODEL={{ portal_identity_model }}
{% if portal_identity_model == 'per-uuid-slot-pool' %}
PORTAL_SLOT_POOL_SALT={{ portal_slot_pool_salt }}
PORTAL_SLOT_POOL_SIZE={{ portal_slot_pool_size }}
# Lazy slot storage (zenoh-storage-taxonomy-sharding.md): when the router runs
# zenoh_lazy_slot_storage, the portal live-adds a slot's store at mint. MUST
# match the router's zenoh_lazy_slot_storage.
PORTAL_LAZY_SLOT_STORAGE={{ portal_lazy_slot_storage | default(false) | string | lower }}
{% endif %}
{% if portal_max_streams_per_principal | string | length > 0 %}
# Live-stream cap per org or slot key; unset = the portal's default.
PORTAL_MAX_STREAMS_PER_PRINCIPAL={{ portal_max_streams_per_principal | int }}
{% endif %}
{% if zenoh_topic_budget_self_block is defined %}
# Topic-budget self-service block (cardinality allocation §2 tier 1) — powers
# /api/budget-projection (the ADR 1075 registry grant store's crawler
# resolver). MUST equal the goatnet's zenoh_topic_budget_self_block; unset
# disables the endpoint (503, crawler degrades honestly).
PORTAL_TOPIC_BUDGET_SELF_BLOCK={{ zenoh_topic_budget_self_block | int }}
{% endif %}

# Block 88 vendor-progress swimlane. Each block is independent:
# missing-token → that detector silently no-ops + the column shows "—".
{% set _nb_token = lookup('env', portal_netbird_api_token_envvar) %}
{% if _nb_token | length > 0 %}
{# One name, or a list of names: an overlay whose goatnets run portal images
   built from different trees writes each name an image may read, and each
   binary reads its own. #}
{% for _nb_env in ([portal_netbird_api_token_env] if portal_netbird_api_token_env is string else portal_netbird_api_token_env) %}
{{ _nb_env }}={{ _nb_token }}
{% endfor %}
PORTAL_NETBIRD_MGMT_URL={{ portal_netbird_mgmt_url }}
PORTAL_NETBIRD_POLL_INTERVAL={{ portal_netbird_poll_interval }}
{% endif %}

# ADR 1116 §9 machine-mint mesh wiring (machine-enrollment.md §"The mesh
# half"). Prefix + exercise map are DERIVED from ops/ansible/
# netbird_acl_taxonomy.yml — prefix via site_id (equality preflight-asserted
# by the role), exercises filtered to the ones this goatnet hosts. Hand-typing
# either is the drift ADR 1116 exists to stop.
PORTAL_MESH_SITE_PREFIX={{ portal_mesh_site_prefix }}
PORTAL_MESH_KEY_MINT_ENABLED={{ 'true' if portal_mesh_key_mint_enabled | bool else 'false' }}
PORTAL_MESH_KEY_TTL={{ portal_mesh_key_ttl }}
{% set _mesh_taxonomy = lookup('file', role_path ~ '/../../netbird_acl_taxonomy.yml') | from_yaml %}
{% set _mesh_ex = [] %}
{# EX-prefixed entries, PLUS any site rung named in portal_mesh_site_scopes.
   The taxonomy stamps persistent site rungs (site-one, svk-k) with the same
   machinery, but a site-rung scope is ADDITIVE (the peer keeps its
   goatnet-rung groups) while an exercise key scope is self-contained — a
   site-scoped key carries <SITE>-* alone. That was a severance hazard until
   ADR 1124 made the northbound reach a RULE rather than a second membership,
   so a site rung may now be admitted DELIBERATELY, BY NAME.

   DO NOT WIDEN THIS FILTER TO ALL netbird_exercises ROWS. `site-one` IS a
   netbird_exercises row, so dropping the startswith('EX-') test arms it
   silently. A site rung that should be mintable is named ONE AT A TIME in
   portal_mesh_site_scopes (2026-08-27, for the SVK tactical site) — an
   allow-list, so admitting one site can never arm another. Dropping the
   startswith test is still wrong for exactly the reason above.

   --site (plan D2) remains the better parameter: it would derive the site
   groups IN ADDITION to the goatnet rung, where a scope named here replaces
   them. That distinction stopped being a severance hazard when ADR 1124 made
   the northbound reach a RULE rather than a second membership (see the gate
   note below), which is what makes the allow-list safe in the meantime.

   STATE OF THE GATES (2026-08-12, updated): the SEVERANCE hazard that
   originally justified this filter is CLEARED, and both follow-on gates are
   answered. ADR 1124's HOST:INFRA rules are applied live to the site-one scope;
   two REAL SITE_ONE-only peers (gateway-one-pi-1, gateway-one-svn-001) hold ESTABLISHED
   sessions to the substrate router on 7447, read from the router's own netns
   connection table; and a re-render from main was shown non-destructive by
   reading the apply path (POST-create + PUT-update over synthesized_policies;
   no DELETE outside rollback/teardown). PR #2464 MERGED 2026-08-12 19:10Z, so
   main now describes the policy that reach depends on and the orphaned-policy
   exposure is closed. ALL GATES ARE CLEAR — nothing technical blocks arming
   site-one; it is a decision for whoever owns that scope, not a blocker.
   THIS FILTER STILL STAYS, on the design reason above: a site rung is ADDITIVE
   and an exercise scope SELF-CONTAINED, so --site is the right parameter and
   the exercise map is not where a site rung belongs. That reason never
   depended on any ACL state and does not expire with the gates.

   An empty PORTAL_MESH_EXERCISE_PREFIXES is the SAFE state, not a gap to fill.
   Current state + order:
   docs/project/machine-mesh-alignment-plan.md §"--site (D2) is BLOCKED". #}
{% for _ex_name, _ex in (_mesh_taxonomy.netbird_exercises | default({})) | dictsort if (_ex.host_site | default('')) == (site_id) and ((_ex.site_prefix | default('')).startswith('EX-') or _ex_name in (portal_mesh_site_scopes | default([]))) %}
{% set _ = _mesh_ex.append(_ex_name ~ '=' ~ _ex.site_prefix) %}
{% endfor %}
PORTAL_MESH_EXERCISE_PREFIXES={{ _mesh_ex | join(',') }}

{% set _s3_secret = lookup('env', portal_audit_s3_secret_key_envvar) %}
{# Access key is the fixed MinIO-read-user contract (portal_audit_s3_access_key), #}
{# NOT env-sourced — so it cannot drift from the user the minio role mints. #}
{# Gate audit config on the SECRET alone: present == audit reader provisioned.    #}
{% if _s3_secret | length > 0 %}
PORTAL_AUDIT_S3_ENDPOINT={{ portal_audit_s3_endpoint }}
# F-537 — swimlane activity counts. Empty = the count renders as unknown.
PORTAL_PROMETHEUS_URL={{ portal_prometheus_url }}
PORTAL_AUDIT_S3_BUCKET={{ portal_audit_s3_bucket }}
PORTAL_AUDIT_S3_REGION={{ portal_audit_s3_region }}
PORTAL_AUDIT_S3_ACCESS_KEY={{ portal_audit_s3_access_key }}
PORTAL_AUDIT_S3_SECRET_KEY={{ _s3_secret }}
PORTAL_AUDIT_SUBSCRIBER_ID={{ portal_audit_subscriber_id }}
PORTAL_AUDIT_TAIL_INTERVAL={{ portal_audit_tail_interval }}
{% endif %}

# Block 94 cross-surface deep-link contract — sibling-surface base URLs
# served at GET /api/siblings. Static catalog JS reads them on page load
# to render `diagnose ↗` + `tail ↗` + `panoscope ↗` row buttons. Empty
# string suppresses the corresponding button (URL-only contract, no
# runtime coupling). See docs/design/zenoh-surface-deep-links.md.
{% if portal_sibling_panoscope_url | default('') %}
PORTAL_SIBLING_PANOSCOPE_URL={{ portal_sibling_panoscope_url }}
{% endif %}
{% if portal_sibling_stethoscope_url | default('') %}
PORTAL_SIBLING_STETHOSCOPE_URL={{ portal_sibling_stethoscope_url }}
{% endif %}
{% if portal_sibling_flashlight_url | default('') %}
PORTAL_SIBLING_FLASHLIGHT_URL={{ portal_sibling_flashlight_url }}
{% endif %}

# Display lexicon (docs/design/portal-lexicon.md) — render-time UI vocabulary.
# Unset = the trial wording ("Zenoh Trial — Vendor Portal" / vendor), rendered
# byte-identical to pre-lexicon. A goatnet sets these in group_vars to render
# its own title and "org". Display-only: never touches API routes, cert
# URI-SANs, the registry, or any machine path. Setting portal_lex_org alone
# derives the plural + title-case forms.
{% if portal_lex_product_name | default('') %}
PORTAL_LEX_PRODUCT_NAME={{ portal_lex_product_name }}
{% endif %}
{% if portal_lex_product_title | default('') %}
PORTAL_LEX_PRODUCT_TITLE={{ portal_lex_product_title }}
{% endif %}
{% if portal_lex_org | default('') %}
PORTAL_LEX_ORG={{ portal_lex_org }}
{% endif %}
{% if portal_lex_orgs | default('') %}
PORTAL_LEX_ORGS={{ portal_lex_orgs }}
{% endif %}
{% if portal_lex_org_title | default('') %}
PORTAL_LEX_ORG_TITLE={{ portal_lex_org_title }}
{% endif %}
{% if portal_lex_orgs_title | default('') %}
PORTAL_LEX_ORGS_TITLE={{ portal_lex_orgs_title }}
{% endif %}
{% if portal_lex_panoscope_url | default('') %}
PORTAL_LEX_PANOSCOPE_URL={{ portal_lex_panoscope_url }}
{% endif %}
{% if portal_notify_console_url | default('') %}
# Candidate stage-notification channel (onboarding-notifications.md incr. 3):
# fire-and-forget POST to the id-console's /api/notify on each onboarding
# transition; the console owns the email send. Both unset = feature off.
PORTAL_NOTIFY_CONSOLE_URL={{ portal_notify_console_url }}
PORTAL_NOTIFY_TOKEN={{ portal_notify_token }}
{% endif %}
