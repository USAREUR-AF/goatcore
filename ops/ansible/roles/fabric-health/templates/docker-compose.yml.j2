# {{ ansible_managed }}
#
# goat-fabric-health meter for {{ fabric_health_site }}. Rendered by
# ops/ansible/roles/fabric-health/ (ADR 1034). One container, mTLS Zenoh
# client peer of the router: subscribes **, publishes ops/fabric/health +
# ops/fabric/footprint. Persists nothing — no secrets, so no sibling .env.

services:
  fabric-health:
    image: {{ fabric_health_image }}
    container_name: fabric-health
    # Memory ceiling: 4x the 7-day peak working set, floor 512M. An unbounded
    # leak on a shared host takes the identity plane down with it.
    deploy:
      resources:
        limits:
          memory: "{{ fabric_health_memory_limit }}"
    restart: unless-stopped
    networks:
      # Reaches the router over the goat-zenoh compose network.
      - zenoh
    environment:
      FABRIC_HEALTH_ENDPOINT: "{{ fabric_health_zenoh_endpoint }}"
      FABRIC_HEALTH_SITE: "{{ fabric_health_site }}"
      FABRIC_HEALTH_INTERVAL_MS: "{{ fabric_health_interval_ms }}"
      FABRIC_HEALTH_TARGET_MSGS: "{{ fabric_health_target_msgs }}"
      FABRIC_HEALTH_TARGET_BYTES: "{{ fabric_health_target_bytes }}"
      RUST_LOG: "{{ fabric_health_rust_log }}"
{% if fabric_health_zenoh_endpoint.startswith('tls/') %}
      FABRIC_HEALTH_CERT: "/certs/fabric-health-cert.pem"
      FABRIC_HEALTH_KEY_FILE: "/certs/fabric-health-key.pem"
      FABRIC_HEALTH_ROOT_CA: "/ca/ca-root.pem"
{% endif %}
{% if fabric_health_zenoh_endpoint.startswith('tls/') %}
    volumes:
{% if fabric_health_identity_source == 'spire' %}
      # client cert+key written by the spiffe-helper sidecar (SPIRE SVID,
      # CN=fabric-health-trial-peer so the CN-only Zenoh ACL admits it). A HOST
      # bind dir (not a named volume) chowned to the meter UID, so the helper —
      # which runs as the SAME UID — writes a 0600 key the meter can read.
      - "{{ fabric_health_svid_dir }}:/certs:ro"
{% else %}
      - "{{ fabric_health_cert_dir }}:/certs:ro"
{% endif %}
      # router server-cert verification — offline-CA root (both modes)
      - "{{ fabric_health_ca_root_src }}:/ca/ca-root.pem:ro"
{% endif %}
{% if fabric_health_identity_source == 'spire' %}

  # SPIRE Phase A: fetch + rotate the CN-bearing SVID from the SPIRE agent's
  # Workload API socket and write cert+key into the shared `svid` volume the
  # meter reads as /certs. The SPIRE registration entry's selector matches
  # this service's docker compose label.
  fabric-health-spiffe-helper:
    image: {{ fabric_health_spiffe_helper_image | default('TODO_PIN_spiffe_helper_image') }}
    container_name: fabric-health-spiffe-helper
    # Memory ceiling: 4x the 7-day peak working set, floor 512M. An unbounded
    # leak on a shared host takes the identity plane down with it.
    deploy:
      resources:
        limits:
          memory: "{{ fabric_health_spiffe_helper_memory_limit }}"
    restart: unless-stopped
    # Run as the meter's nonroot UID so the SVID key it writes (0600) is owned
    # by — and readable by — the meter. (spiffe-helper 0.10.1 ignores
    # key_file_mode and is distroless, so neither a mode key nor a chmod hook
    # works; shared-UID is the clean answer. Reaching the agent's Workload API
    # socket as nonroot needs the socket dir world-traversable — the spire role
    # renders it 0755.)
    user: "{{ fabric_health_spire_uid }}:{{ fabric_health_spire_uid }}"
    command: ["-config", "/etc/spiffe-helper/helper.conf"]
    volumes:
      - "{{ fabric_health_spire_socket_dir }}:/run/spire/sockets:ro"
      - "{{ fabric_health_compose_dir }}/spiffe-helper.conf:/etc/spiffe-helper/helper.conf:ro"
      - "{{ fabric_health_svid_dir }}:/svid"
    networks:
      - mgmt
{% endif %}

networks:
  zenoh:
    name: {{ fabric_health_zenoh_network }}
    external: true
{% if fabric_health_identity_source == 'spire' %}
  mgmt:
    name: mgmt
    external: true
{% endif %}
