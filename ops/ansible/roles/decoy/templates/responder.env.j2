# Rendered by ops/ansible/roles/decoy. Holds the responder key only, never the seed.
GOAT_DECOY_RESPOND_KEY={{ _decoy_key.stdout | trim }}
DECOY_SERVICE_ZONE={{ deception_service_zone }}
DECOY_LISTEN_ADDR={{ _decoy_listen }}
DECOY_LISTEN_PORT={{ decoy_listen_port }}
DECOY_TEMPLATES_DIR={{ decoy_install_dir }}/templates
DECOY_REPLY_DELAY_MS={{ deception_reply_delay_ms }}
DECOY_PAGE_PERIOD_SECONDS={{ deception_page_period_seconds }}
DECOY_RATE_PER_SECOND={{ decoy_rate_per_second }}
DECOY_RATE_BURST={{ decoy_rate_burst }}
DECOY_MAX_INFLIGHT={{ decoy_max_inflight }}
DECOY_METRICS_FILE={{ decoy_metrics_file }}
DECOY_TRUSTED_PROXIES={{ _decoy_proxy_net }}
