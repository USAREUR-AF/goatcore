# Generated by the decoy Ansible role — do not edit on host.
#
# One router for every tagged single label under the service zone. Priority 1:
# any router with a literal Host() rule wins. No certResolver: the names are
# covered by the wildcard certificate the host already serves.
http:
  routers:
    goat-decoy:
      rule: "HostRegexp(`^[a-z0-9][a-z0-9-]*-[a-z2-7]{8}\\.{{ deception_service_zone | regex_escape | replace('\\', '\\\\') }}$`)"
      priority: 1
      entryPoints:
        - websecure
      service: goat-decoy
{% if decoy_traefik_middlewares | length > 0 %}
      middlewares:
{% for m in decoy_traefik_middlewares %}
        - "{{ m }}"
{% endfor %}
{% endif %}
      tls: {}

  services:
    goat-decoy:
      loadBalancer:
        servers:
          - url: "http://{{ _decoy_listen }}:{{ decoy_listen_port }}"
