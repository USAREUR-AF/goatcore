# Managed by ansible (roles/machine-provenance-guard). Do not edit on the host.
# Mode 0600, root-owned. Holds an admin-scoped NetBird PAT and a portal
# operator key — two credentials on two planes, which is the reason this guard
# is its own role rather than an entry in a shared list.
NB_API_URL={{ machine_provenance_guard_nb_api_url }}
NB_API_TOKEN={{ machine_provenance_guard_nb_token }}
PORTAL_URL={{ machine_provenance_guard_portal_url }}
PORTAL_OPERATOR_KEY={{ machine_provenance_guard_portal_key }}
PROVENANCE_ENFORCE={{ '1' if machine_provenance_guard_enforce | bool else '0' }}
# Warrant declarations for this scope; absent on a goatnet warrant does not govern.
WARRANT_MEMBERSHIP_DIR={{ machine_provenance_guard_warrant_dir }}
{% if machine_provenance_guard_reconcile_allowlist | length > 0 %}
PROVENANCE_RECONCILE_ALLOWLIST=/etc/goat/provenance-reconcile-allowlist
{% endif %}
REPORT_DIR={{ machine_provenance_guard_report_dir }}
TEXTFILE_DIR={{ machine_provenance_guard_textfile_dir }}
LIB_DIR={{ machine_provenance_guard_lib_dir }}
