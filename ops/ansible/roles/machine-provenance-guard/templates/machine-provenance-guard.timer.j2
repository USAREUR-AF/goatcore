# Managed by ansible (roles/machine-provenance-guard). Do not edit on the host.
#
#   systemctl list-timers machine-provenance-guard.timer
#   journalctl -u machine-provenance-guard.service -n 60
#   cat {{ machine_provenance_guard_report_dir }}/last-run.txt
[Unit]
Description=Hourly gear-class provenance audit (ADR 1130)
Documentation=https://github.com/usareur-af/goatcore/blob/main/docs/design/live-state-guard-scheduling.md

[Timer]
# Hourly at :17 — offset from the sibling membership audit (06:41) and from the
# host's other timers. A side door open for at most an hour is a different thing
# from one open for five days.
OnCalendar={{ machine_provenance_guard_oncalendar }}
RandomizedDelaySec={{ machine_provenance_guard_jitter_sec }}
AccuracySec=1min
# Persistent so a host that was down at :17 audits when it returns rather than
# skipping in silence. A late audit beats no audit; no audit is the failure this
# whole ADR is about.
Persistent=true
Unit=machine-provenance-guard.service

[Install]
WantedBy=timers.target
