# ntfy server config — rendered by ops/ansible/roles/relay-health (ADR 1168).
# DO NOT EDIT ON HOST.
base-url: "https://{{ ntfy_fqdn }}"
listen-http: ":80"
behind-proxy: true
# Every topic is private. Publishers and subscribers are users with explicit
# grants; the alertmanager user is write-only on goat-<goatnet>-*, each
# PLATFORM-ADMIN is read-only on the same. Nothing is world-readable.
auth-file: "/var/lib/ntfy/user.db"
auth-default-access: "deny-all"
enable-login: true
enable-signup: false
enable-reservations: false
cache-file: "/var/cache/ntfy/cache.db"
cache-duration: "{{ ntfy_cache_duration }}"
attachment-cache-dir: "/var/cache/ntfy/attachments"
# Message templates (files/ntfy-templates). Alertmanager publishes with
# ?template=goat-alertmanager, a bounded template; ntfy's built-in
# `alertmanager` template overflows the 4096-byte message limit on a large
# group. A file named alertmanager.yml here would silently replace the
# built-in, so goat templates carry a goat- prefix.
template-dir: "/etc/ntfy/templates"
log-level: info
log-format: json
