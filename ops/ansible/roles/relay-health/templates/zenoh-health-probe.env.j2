# Rendered by ops/ansible/roles/relay-health/ — DO NOT EDIT ON HOST.
# zenoh-health-probe.sh config. Mode 0600 — carries the bearer token.
ZENOH_ROUTER_NAME={{ zenoh_health_router_name | default(zenoh_health_goatnet | default(site_id)) }}
ZENOH_ROUTER_CONTAINER={{ zenoh_health_router_container | default(zenoh_stack ~ '-router') }}
ZENOH_GOATNET={{ zenoh_health_goatnet | default(site_id) }}
ZENOH_INGEST_URLS={{ zenoh_health_ingest_urls }}
RELAY_METRICS_BEARER_TOKEN={{ relay_metrics_bearer_token }}
ZENOH_VANTAGE={{ zenoh_health_vantage | default(inventory_hostname) }}
ZENOH_INTERVAL_S={{ zenoh_health_interval_s | default(30) }}
ZENOH_REST_PORT={{ zenoh_health_rest_port | default(8000) }}
ZENOH_TPORT={{ zenoh_health_tport | default(7447) }}
ZENOH_QUIC_PORT={{ zenoh_health_quic_port | default(7448) }}
{% if zenoh_health_client_cert | default('') | length > 0 %}
ZENOH_CLIENT_CERT={{ zenoh_health_client_cert }}
ZENOH_CLIENT_KEY={{ zenoh_health_client_key | default(zenoh_health_client_cert) }}
{% endif %}
{% if zenoh_health_fips_attest | default('') | length > 0 %}
ZENOH_FIPS_ATTEST={{ zenoh_health_fips_attest }}
{% endif %}
{% if zenoh_health_storage_dir | default('') | length > 0 %}
ZENOH_STORAGE_DIR={{ zenoh_health_storage_dir }}
{% endif %}
{% if zenoh_health_router_peer_allow | default([]) | length > 0 %}
ZENOH_ROUTER_PEER_ALLOW={{ zenoh_health_router_peer_allow | join(',') }}
{% endif %}
{#- Ceiling on live whole-keyspace SESSIONS. Deliberately NOT derived from
    `zenoh_fabric_wide_read | length`: a grant is per identity and this counts
    sessions, and one named peer legitimately held three at once on one goatnet, so the
    derived number would false-fire the day someone reconnects. The operator
    sets it from a measured count plus headroom; unset (the default) disables
    the count alert and leaves the workaround-SHAPE alert, which needs no
    threshold. -#}
{% if zenoh_health_fabric_wide_max_sessions is defined %}
ZENOH_FABRIC_WIDE_EXPECTED={{ zenoh_health_fabric_wide_max_sessions }}
{% endif %}
{#- The probe writes goat_zenoh_* itself ONLY where zenoh-health-to-prom.py is
    not wired (zenoh-health-probe.service.j2 carries the same condition): the two
    must never emit the same series into one textfile directory. -#}
{% if relay_health_textfile_out | default('') | length > 0 and not (relay_health_enabled | default(false) | bool) %}
ZENOH_PROM_OUT={{ relay_health_textfile_out | dirname }}/zenoh-router-probe.prom
{% endif %}
STATE_DIR=/var/lib/zenoh-health-publish
