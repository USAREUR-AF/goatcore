# Rendered by ops/ansible/roles/relay-health/ — DO NOT EDIT ON HOST.
# Leading-indicator sampler for the wedge instrument
# (docs/design/zenoh-wedge-instrumentation.md): per-namespace keyexpr cardinality
# + admin-walk latency + a declare-rate proxy, written to the ingest as
# zenoh-fabric.json for the router-health band + the goat_zenoh_* precursor
# alerts. Single-flight (flock) — the full `**` walk IS the expensive read, so it
# must never stack. Runs as root: docker inspect + nsenter into the router netns.
[Unit]
Description=zenoh fabric cardinality/load sampler (wedge precursor signals)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=ZENOH_CT={{ relay_health_fabric_sampler_router_container | default(zenoh_health_router_container | default(zenoh_stack ~ '-router')) }}
Environment=ZENOH_ROUTER_NAME={{ relay_health_fabric_sampler_router_name | default(zenoh_health_router_name | default(zenoh_health_goatnet | default(site_id))) }}
Environment=FABRIC_JSON={{ relay_health_www_dir }}/ingest/zenoh-fabric.json
ExecStart=/usr/bin/env bash {{ relay_health_dir }}/zenoh-fabric-sampler.sh
