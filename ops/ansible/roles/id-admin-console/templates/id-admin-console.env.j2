# Rendered by ops/ansible/roles/id-admin-console/ — DO NOT EDIT ON HOST.
# Mode 0600 root:root.
#
# Consumed by the goat-id-console container in
# docker-compose.id-admin-console.yml.

# --- Listener ---
LISTEN_ADDR=:8080

# --- IdP selector (two-IdP threading per ADR 0860) ---
IDP_TENANT_LABEL={{ id_admin_console_idp_tenant_label }}
IDP_TENANT_KRATOS_ADMIN_URL={{ id_admin_console_idp_tenant_kratos_admin_url }}
IDP_TENANT_HYDRA_ADMIN_URL={{ id_admin_console_idp_tenant_hydra_admin_url }}

{% if id_admin_console_idp_operator_kratos_admin_url | default('') | length > 0 %}
# Operator IdP — present only on three-Orin sites (Orin-C runs the
# separate Kratos+Hydra per ADR 0842). On single-host sites,
# id_admin_console_idp_operator_kratos_admin_url is empty so this block
# is omitted and the console's config loader skips this IdP entirely.
IDP_OPERATOR_LABEL={{ id_admin_console_idp_operator_label }}
IDP_OPERATOR_KRATOS_ADMIN_URL={{ id_admin_console_idp_operator_kratos_admin_url }}
IDP_OPERATOR_HYDRA_ADMIN_URL={{ id_admin_console_idp_operator_hydra_admin_url }}
{% endif %}

# --- Canonical permissions matrix ---
# Bind-mounted into the container by the compose overlay. The console
# reads this file at startup and renders it verbatim on /permissions.
PERMISSIONS_YAML_PATH={{ id_admin_console_permissions_yaml_container_path }}

# --- Coalition framework registry (ADR 1077) ---
# Bind-mounted read-only. Backs the identity-detail "coalition standing" row:
# standing is nation-derived, so it exists in neither the cert nor the Ory claim
# and has to be resolved at render time. COALITION_FRAMEWORK empty = the
# registry's own default_framework.
COALITION_FRAMEWORKS_PATH={{ id_admin_console_coalition_frameworks_container_path }}
COALITION_FRAMEWORK={{ id_admin_console_coalition_framework }}

{% if peerview_enabled | default(false) %}
# Hold-records JSONL written by the peerview lifecycle sweep
# (ops/lifecycle/schema/hold-record.v1.schema.json). Read-only
# input for the Access section on the user-detail page.
HOLD_RECORDS_PATH=/var/lib/peerview/hold-records.jsonl
{% endif %}
{% if warrant_membership_enabled | default(false) %}
MEMBERSHIP_AUTHORITY=scope
MEMBERSHIP_SCOPE_PATH=/etc/goat/warrant/membership/{{ warrant_membership_scope }}/_scope.yaml
{% else %}
MEMBERSHIP_AUTHORITY=ungoverned
{% endif %}
{% if mesh_health_peer_summary_enabled | default(false) %}
# Per-peer handshake summary written by the mesh-health snapshot on this host.
# Read-only input for the enrolled card's control-only flag.
PEER_HANDSHAKES_PATH=/var/lib/mesh-peer-summary/peer-handshakes.json
{% endif %}

# --- Operating sovereign (ADR 1151) ---
# The ISO 3166-1 alpha-3 nation OPERATING this goatnet. It is the other half of
# the `organic` derivation: an affiliation is organic when its nation equals
# this one, which is why the same org reads organic on one goatnet and foreign
# on another. EMPTY = organic renders as UNKNOWN and says why -- it must never
# default to a nation, because a hardcoded sovereign is the exact bug ADR 1151
# names, and defaulting would silently reclassify a nation's own units as
# somebody else's.
OPERATING_SOVEREIGN={{ id_admin_console_operating_sovereign }}

# --- Step-up AAL2 thresholds (per ADR 0860 §"Step-up") ---
STEP_UP_RETURN_TO_BASE={{ id_admin_console_step_up_return_to_base }}
AAL2_FRESH_WINDOW_SEC={{ id_admin_console_aal2_fresh_window_sec }}
# Per-goatnet policy: whether the AAL2 step-up gate on sensitive mutations is
# actually enforced. Fail-closed default true (prod). A sandbox goatnet with no
# AAL2 flow wired sets this false so delete/revoke-admin/reset-2fa/grant-admin
# proceed-and-audit instead of 403-ing every admin. See
# docs/design/id-admin-console.md §"Step-up enforcement policy".
STEP_UP_ENFORCED={{ id_admin_console_step_up_enforced | default(true) | lower }}
{% if id_admin_console_step_up_sso_idp is defined %}
# The realm the console's oauth2-proxy SSO authenticates admins against; the
# step-up gate resolves the ACTOR's AAL posture here, never against the ?idp=
# administered-realm selector. Omit to default to the default IdP (tenant).
STEP_UP_SSO_IDP={{ id_admin_console_step_up_sso_idp }}
{% endif %}

# --- Onboarding engine (ADR 1062/1071 — the console OWNS the engine now) ---
{% if id_admin_console_store == 'postgres' %}
# The onboarding store and the org registry (ADR 1112) are Postgres databases on
# postgres-a, one per store (ADR 1165 step A). The server reads only these; the
# SQLite files under /var/lib/goat-id-console are the read-only cutover archive.
ONBOARD_DB_DSN={{ id_admin_console_onboard_db_dsn }}
ORG_DB_DSN={{ id_admin_console_org_db_dsn }}
# ADR 1112: the match-or-create affordance flag.
{% else %}
# The onboarding workflow moved out of the data-fabric portal into this console
# (docs/design/onboarding-extraction-plan.md): the console holds the proposal +
# invite SQLite store, mints, reviews/decides, and serves the machine + public
# realms. ONBOARD_DB_PATH is the store (a persistent volume; see the compose
# overlay).
ONBOARD_DB_PATH={{ id_admin_console_onboard_db_path }}
# ADR 1112: the org registry store + the match-or-create affordance flag.
ORG_DB_PATH={{ id_admin_console_org_db_path }}
{% endif %}
ORG_MATCH_ENABLED={{ 'true' if id_admin_console_org_match_enabled else 'false' }}
# ADR 1171 decision 7. Refuses an ADMIN APPROVAL while the candidate's
# organisation is not in this goatnet's registry. Default OFF and armed PER
# GOATNET, because arming it against a registry that does not yet hold the orgs
# that goatnet's live manifests already name refuses every onboarding.
ONBOARD_REQUIRE_REGISTERED_ORG={{ 'true' if id_admin_console_require_registered_org else 'false' }}
# Per-handle machine keys ("handle:key,handle:key") — the onboard-runner + the
# `goat admin invite` CLI present their own; attribution is per-handle.
ONBOARD_OPERATOR_API_KEYS={{ id_admin_console_onboard_operator_api_keys }}
# The read-only data-fabric portal base the console calls for participant-key
# delegation (GET /api/whoami → org handle + ADR 1071 sponsor cap). The vendors
# registry + key store stay the SoT in the portal.
PORTAL_INTERNAL_URL={{ id_admin_console_portal_internal_url }}
# Self-service sign-on setup codes (/setup-code, F-351). The two Kanidm doors
# are SEPARATE sign-on planes from the mesh Ory/Kratos identity this console
# runs on: collab (chat/docs/files) and the public dashboards.
#
# Empty URL or empty password => that door is simply not offered on the page.
# That is the right default: most goatnets have no collab plane at all.
#
# The credential is idm_admin, because Kanidm has no lesser right that can mint
# a credential-update intent. It is the SAME secret the onboard-runner already
# holds on this host for collab provisioning, so this adds no new blast radius —
# but it is admin-scoped and that is worth knowing rather than discovering.
COLLAB_KANIDM_URL={{ id_admin_console_collab_door_url | default('', true) }}
COLLAB_KANIDM_IDM_ADMIN_PW={{ id_admin_console_collab_door_admin_pw | default('', true) }}
PUBLIC_DOOR_KANIDM_URL={{ id_admin_console_public_door_url | default('', true) }}
{# The console reads GOAT_IDM_ADMIN_PW. A deployment that names the variable
   differently (public_door_idm_admin_pw_env) gets that name written as well,
   for console images built to read it. #}
GOAT_IDM_ADMIN_PW={{ id_admin_console_public_door_admin_pw | default('', true) }}
{% if (public_door_idm_admin_pw_env | default('GOAT_IDM_ADMIN_PW')) != 'GOAT_IDM_ADMIN_PW' %}
{{ public_door_idm_admin_pw_env }}={{ id_admin_console_public_door_admin_pw | default('', true) }}
{% endif %}

# The console's OUTBOUND portal bearer — an OPERATOR key (paired with the
# `id-console` entry in portal_operator_api_keys). Without it config.go falls
# back to NOTIFY_TOKEN, which the portal accepts only for the self-gated
# sponsorship lookup, so every requireOperator call 401s and — being
# best-effort — fails silently.
PORTAL_LOOKUP_TOKEN={{ id_admin_console_portal_lookup_token }}
# Public front-desk base for candidate one-time links (the collector's fqdn) +
# the console's own mesh-side public base (nomination-link fallback).
INTAKE_BASE_URL={{ id_admin_console_intake_base_url }}
# CONSOLE_PUBLIC_URL is THIS console's own host — the one that serves /ssh-key
# and /docs/onboarding. PORTAL_PUBLIC_URL below is the public INTAKE front desk
# and serves NEITHER (it 404s them). A mail link built from the wrong one is
# dead on arrival.
CONSOLE_PUBLIC_URL=https://{{ id_admin_console_fqdn }}
PORTAL_PUBLIC_URL={{ id_admin_console_portal_public_url }}
# --- Onboarding GitHub repo-grants (docs/design/onboarding-github-repo-grants.md) ---
# REPO_ACCESS_CONFIG points at the bind-mounted repo-access policy (the role lays
# down a no-rules default when a goatnet declares none). GITHUB_ONBOARD_TOKEN is a
# fine-grained PAT (Administration:write on the granted repos); UNSET = grants
# skipped (fail-open, never fails an onboard). Resolved from the controller env at
# deploy time; never committed.
REPO_ACCESS_CONFIG={{ id_admin_console_repo_access_container_path }}
GITHUB_ONBOARD_TOKEN={{ id_admin_console_github_onboard_token }}

# SMTP (AWS SES) for emailing onboarding invite links. Empty host = email off
# (link shown for manual hand-over). Recovery email is the Kratos courier (separate).
SMTP_HOST={{ id_admin_console_smtp_host }}
SMTP_PORT={{ id_admin_console_smtp_port }}
SMTP_USERNAME={{ id_admin_console_smtp_username }}
SMTP_PASSWORD={{ id_admin_console_smtp_password }}
SMTP_FROM={{ id_admin_console_smtp_from }}
SMTP_REPLY_TO={{ id_admin_console_smtp_reply_to | default('') }}

# SES v2 API for the sandbox-aware invite email controls (production-access
# detection + recipient verification). Same IAM user as the SMTP creds
# (the goatnet's Terraform SES module), policy-scoped to GetAccount + Create/GetEmailIdentity.
# All empty = feature off (console hides the sandbox controls).
SES_API_REGION={{ id_admin_console_ses_api_region }}
SES_API_ACCESS_KEY_ID={{ id_admin_console_ses_api_access_key_id }}
SES_API_SECRET_ACCESS_KEY={{ id_admin_console_ses_api_secret_access_key }}

# --- Audit emitter (v1 stderr + ring; v2 zenoh once the publisher lands) ---
# --- Audit emitter ---
# stderr = ring only (dies with the container); file = ring + durable JSONL at
# AUDIT_FILE_PATH (bind-mounted — survives redeploys; ADR 0860 interim).
AUDIT_BACKEND={{ id_admin_console_audit_backend }}
AUDIT_FILE_PATH={{ id_admin_console_audit_file_path }}

# --- Candidate stage-notification intake (onboarding-notifications.md incr. 3) ---
# The portal POSTs /api/notify with this shared bearer on each onboarding
# transition; the console renders + sends the candidate email (SES above).
# Empty token = endpoint off. The three URLs are the links the final
# "you're onboarded" email renders — per-goatnet display values.
NOTIFY_TOKEN={{ id_admin_console_notify_token }}
NOTIFY_MGMT_URL={{ id_admin_console_notify_mgmt_url }}
# Enrollment watcher (internal/enrollwatch): flips onboarded -> enrolled once
# the person consumes their mesh setup key, so the console can answer "did the
# welcome package actually land?" instead of only "did we send it?". Reuses
# NOTIFY_MGMT_URL as the NetBird API base; this token is what arms it. READ-ONLY
# use (GET /api/setup-keys). Empty = watcher off, rows stay at `onboarded`.
ENROLL_WATCH_NB_TOKEN={{ id_admin_console_enroll_watch_nb_token }}
ENROLL_WATCH_INTERVAL={{ id_admin_console_enroll_watch_interval }}
NOTIFY_GET_URL={{ id_admin_console_notify_get_url }}
NOTIFY_PORTAL_URL={{ id_admin_console_notify_portal_url }}
# The relay-fleet health dashboard. NOT a mesh service: the surviving dashboard
# is the OFF-MESH cloud one, deliberately, because a network-health surface
# reachable only over the mesh is unavailable exactly when the mesh is broken.
# Empty = the guide says "not configured on this goatnet" rather than linking
# somewhere dead.
# Where the portal reads operator API keys. Empty = the console records
# requests but grants nothing, and says so on the queue rather than letting an
# approval look successful.
OPERATOR_KEY_DIR={{ id_admin_console_operator_key_dir | default('') }}
NOTIFY_RELAY_HEALTH_URL={{ id_admin_console_notify_relay_health_url | default('') }}
# Geographic map surface — configured, never derived: only goatnets carrying a
# live geographic feed have one, and a derived link would point at a host that
# does not exist elsewhere. Blank = the guide renders "not configured".
NOTIFY_MAP_URL={{ id_admin_console_notify_map_url | default('') }}
# What a device on this goatnet dials outbound, for the guide's
# corporate-firewall topic (?topic=firewall). Sourced from the SAME group_vars
# that render management.json's Relays + Stuns, never set independently, so the
# guide cannot list a relay the goatnet does not hand to clients. The console
# resolves the names to public addresses when the page is requested. Blank =
# the topic renders ports and settings without an address table.
NOTIFY_RELAY_ADDRESSES={{ relay_addresses | default([]) | join(',') }}
NOTIFY_STUN_HOSTS={{ stun_hosts | default([stun_host] if stun_host is defined else []) | join(',') }}
# How this goatnet issues fabric credentials, so the guide describes the flow
# the goatnet actually runs. Sourced from the SAME group_var that drives the
# onboard-runner, never set independently: two copies of this fact let the
# guide contradict the welcome email.
NOTIFY_MINT_ON_COLLECT={{ 'true' if onboard_runner_defer_credential | default(false) else 'false' }}
NOTIFY_ROSENPASS={{ 'true' if id_admin_console_notify_rosenpass | default(false) else 'false' }}
# Environment identity: tagline goes in subjects ("<goatnet> (integration gateway)");
# purpose renders as the "About this environment" block in email bodies. Blank =
# name-only emails.
# Which goatnet this console SERVES. The fallback identity for emails to people
# with no onboarding proposal row (ported / hand-created / pre-buildout): without
# it those emails call the environment "the data fabric" and print a blank
# operator handle.
NOTIFY_GOATNET={{ id_admin_console_notify_goatnet }}
NOTIFY_GOATNET_TAGLINE={{ id_admin_console_notify_goatnet_tagline | default('') }}
NOTIFY_GOATNET_PURPOSE={{ id_admin_console_notify_goatnet_purpose | default('') }}
# The platform source repository and the collaboration front door the welcome
# package prints. Per goatnet; empty = the console's built-in value.
PLATFORM_REPO_URL={{ id_admin_console_platform_repo_url | default('') }}
NOTIFY_COLLAB_URL={{ id_admin_console_notify_collab_url | default('') }}
# Who is emailed when a candidate clears the SPONSOR gate and lands on the admin
# queue. Comma-separated addresses; blank = the notification is off and the queue
# stays pull-only. There is no derivable admin mailbox — ADMINS is a login-group
# name, not an address — so this is configured per goatnet.
ONBOARD_ADMIN_NOTIFY_EMAILS={{ id_admin_console_onboard_admin_notify_emails | default('') }}

# --- Onboarding: demand-gated non-governmental sector cluster (ADR 1077) ---
# OFF fleet-wide by default. When true, the intake form offers + the engine
# stamps the non-gov affiliation.sector values (ngo/media/academic/commercial);
# the governmental cluster (military/law-enforcement/civil-government/intelligence)
# is always live. Flip per goatnet on demand — a non-gov value submitted with
# the gate off is dropped, not stamped.
ONBOARD_SECTORS_NONGOV_ENABLED={{ 'true' if id_admin_console_onboard_sectors_nongov_enabled | default(false) else 'false' }}

# --- SPIFFE mTLS on the mint-capable onboarding leg (runner → console) ---
# Default OFF. When true, the console starts a SECOND listener (:9443) that
# requires a client SVID whose SPIFFE ID is the onboard-runner's, chained to the
# SPIRE bundle — cryptographic transport auth for the mint API, replacing "same
# mgmt bridge + static bearer" (the bearer still carries F-207 attribution). SVID
# files come from a spiffe-helper sidecar (SPIRE Phase A); the compose template
# adds that sidecar + the /svid mount when the toggle is on (the runner reaches
# :9443 container-to-container on the mgmt network — no host publish). SPIRE is
# opt-in per goatnet. See docs/design/runner-console-mtls.md §Deploy.
MTLS_ONBOARD_ENABLED={{ 'true' if id_admin_console_mtls_onboard_enabled | default(false) else 'false' }}
{% if id_admin_console_mtls_onboard_enabled | default(false) %}
MTLS_ONBOARD_ADDR={{ id_admin_console_mtls_onboard_addr | default(':9443') }}
MTLS_ONBOARD_CERT_FILE={{ id_admin_console_mtls_onboard_cert_file | default('/svid/goat-id-console-cert.pem') }}
MTLS_ONBOARD_KEY_FILE={{ id_admin_console_mtls_onboard_key_file | default('/svid/goat-id-console-key.pem') }}
MTLS_ONBOARD_BUNDLE_FILE={{ id_admin_console_mtls_onboard_bundle_file | default('/svid/spire-bundle.pem') }}
MTLS_ONBOARD_ALLOWED_CLIENT_IDS={{ id_admin_console_mtls_onboard_allowed_client_ids | default('spiffe://' + (spire_trust_domain | default(id_admin_console_onboard_trust_domain_fallback)) + '/onboard-runner') }}
{% endif %}

# --- Logging ---
LOG_LEVEL={{ id_admin_console_log_level }}

# DEV_BYPASS_AUTH is INTENTIONALLY NOT SET HERE. The console's adminGate
# middleware reads X-Auth-Request-Groups from oauth2-proxy-id-console.
# Setting DEV_BYPASS_AUTH=1 would bypass that check; only meaningful for
# local `go run` against an absent sidecar.
