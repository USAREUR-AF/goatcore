# Generated by the saltlick Ansible role — do not edit on host.
# Rendered to {{ saltlick_traefik_dynamic_dir }}/{{ saltlick_traefik_dynamic_filename }}.
#
# Same shape as the other mgmt-host routes: file-provider router,
# upstream by docker network alias on `{{ saltlick_traefik_network }}`, Let's Encrypt via the
# `{{ saltlick_traefik_cert_resolver }}` resolver. Filename distinct from the neighbouring route files so a
# saltlick redeploy cannot stomp another surface's router.
#
# TLS here is transport hygiene and nothing more. It is not what makes a
# package trustworthy: a consumer verifies the Ed25519 signature over the bytes
# themselves, against a key bound over a channel this service had nothing to do
# with. Serving plaintext would still be wrong, because it invites someone on
# the path to alter bytes in flight and waste a consumer's time.

http:
  routers:
    {{ saltlick_traefik_router_name }}:
      rule: "Host(`{{ saltlick_hostname }}`)"
      entryPoints:
        - websecure
      service: {{ saltlick_traefik_router_name }}
{% if saltlick_traefik_mesh_only_middleware | default('') | length > 0 %}
      middlewares:
        # Mesh-only gating. The directory is mesh-internal by decision
        # and the consequence — a partner cannot reach it — is accepted in
        # writing, because packages are self-verifying and can be handed over
        # by any means. This is the whole network gate; reads carry no
        # application-layer auth by design.
        - "{{ saltlick_traefik_mesh_only_middleware }}"
{% endif %}
      tls:
        certResolver: {{ saltlick_traefik_cert_resolver }}

  services:
    {{ saltlick_traefik_router_name }}:
      loadBalancer:
        servers:
          # Straight to the directory. No oauth2-proxy: writes are
          # trust-on-first-use signatures the publishing parties hold, and
          # fencing them behind our identity plane would make this instance the
          # thing deciding who may publish — the authoritative posture the
          # service exists to refuse.
          - url: "http://{{ saltlick_container_name }}:{{ saltlick_internal_port }}"
        healthCheck:
          path: /healthz
          interval: "30s"
          timeout: "5s"
