# Generated by the saltlick Ansible role — do not edit on host.
# Upstream schema-of-record: USAREUR-AF/saltlick deploy/docker-compose.yml
# (that one ships its own Caddy for self-hosters; here Traefik already
# terminates TLS, so only the directory container runs).
services:
  {{ saltlick_container_name }}:
    # ${SALTLICK_IMAGE} comes from the sibling .env the role writes, so the pin
    # can be flipped on the host without touching this file.
    image: "${SALTLICK_IMAGE:-{{ saltlick_image }}}"
    container_name: "{{ saltlick_container_name }}"
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: {{ saltlick_memory_limit }}
    environment:
      # Explicit, and NOT the binary's own default. saltlick defaults to
      # 127.0.0.1:8080 so that an accidental exposure is never the path of
      # least resistance; inside a container the network namespace is the
      # boundary instead, and a loopback bind would be unreachable to Traefik.
      SALTLICK_ADDR: ":{{ saltlick_internal_port }}"
      SALTLICK_DB: "{{ saltlick_db_path }}"
    volumes:
      # The DIRECTORY, never the .db file — WAL mode keeps -wal and -shm
      # siblings that must live on the same persistent volume.
      - "{{ saltlick_data_volume }}:{{ saltlick_db_path | dirname }}"
    networks:
      # Traefik resolves {{ saltlick_container_name }}:{{ saltlick_internal_port }} over this network.
      - "{{ saltlick_traefik_network }}"
    expose:
      - "{{ saltlick_internal_port }}"
    # No Traefik docker labels — routing is file-provider, rendered to
    # {{ saltlick_traefik_dynamic_dir }}/{{ saltlick_traefik_dynamic_filename }}.
    labels:
      - "traefik.enable=false"
    logging:
      driver: json-file
      options:
        max-size: "5m"
        max-file: "3"

networks:
  "{{ saltlick_traefik_network }}":
    external: true
    name: "{{ saltlick_traefik_network }}"

volumes:
  "{{ saltlick_data_volume }}":
    # The SQLite file and its WAL siblings. This is the only state that
    # matters; everything else is recreated by pulling the image again.
    # Removing it clears every trust-on-first-use binding, and each party
    # would then rebind on its next publish.
    name: "{{ saltlick_data_volume }}"
