# Prometheus scrape config for a vega mgmt-host node.
#
# Both vega nodes run an identical Prometheus; each scrapes its own
# local services AND the peer's node-exporter + signal-server
# /metrics via the Netbird mesh. This gives each site a full view
# of both nodes — no central hub needed for the Phase 2 PoC. A
# future Phase 3 federated-central rollup (region B) will
# remote_write from here; not in scope yet.
#
# Environment variables are expanded at scrape time from the
# container's env (rendered by Ansible into compose .env):
#   SITE_NAME                   — e.g. vega-a, vega-b. Applied to every
#                                  series via external_labels so queries
#                                  like signal_server_connected_peers{site="vega-a"}
#                                  work uniformly across both nodes.
#   PEER_NODE_EXPORTER_TARGET   — "<peer-mesh-ip>:9100"
#   PEER_SIGNAL_METRICS_TARGET  — "<peer-mesh-ip>:9090"

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    site: "${SITE_NAME}"

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:

  # ------------------------------------------------------------------
  # Prometheus itself (self-monitoring).
  # ------------------------------------------------------------------
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
        labels:
          instance: prometheus-local

  # ------------------------------------------------------------------
  # Alertmanager's own counters. Without this scrape a failing delivery
  # (alertmanager_notifications_failed_total) is invisible to alerting
  # and a dead pager is only discoverable in container logs.
  # ------------------------------------------------------------------
  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]

  # ------------------------------------------------------------------
  # signal-server — local /metrics via the compose network.
  # The base docker-compose.yml exposes :9090 host-locally; inside
  # the mgmt network we hit the container hostname directly.
  # ------------------------------------------------------------------
  - job_name: signal-server
    static_configs:
      - targets:
          - "signal-a:9090"
        labels:
          instance: signal-a
          role: local

  # ------------------------------------------------------------------
  # signal-server — PEER /metrics over the Netbird mesh. The peer's
  # signal-a binds 0.0.0.0:9090 on its host (base docker-compose.yml)
  # so we can reach it via the peer's mesh IP.
  # ------------------------------------------------------------------
  - job_name: signal-server-peer
    static_configs:
      - targets:
          - "{{ peer_signal_metrics_target }}"
        labels:
          instance: signal-peer
          role: peer

  # ------------------------------------------------------------------
  # postgres-exporter — sidecar to local postgres-a. Exposes
  # pg_stat_*, pg_replication_slots, and the Spock-specific custom
  # queries in monitoring/postgres-exporter-queries.yml.
  # ------------------------------------------------------------------
  - job_name: postgres
    static_configs:
      - targets:
          - "postgres-exporter:9187"
        labels:
          instance: postgres-a
          role: local

  # ------------------------------------------------------------------
  # node-exporter — local host metrics.
  # ------------------------------------------------------------------
  - job_name: node
    static_configs:
      - targets:
          - "node-exporter:9100"
        labels:
          instance: node-local
          role: local

  # ------------------------------------------------------------------
  # node-exporter — PEER host metrics over the Netbird mesh. Peer
  # node-exporter binds 0.0.0.0:9100; mesh ACLs restrict who can
  # reach it. This gives each Prometheus a symmetric view of both
  # nodes.
  # ------------------------------------------------------------------
  - job_name: node-peer
    static_configs:
      - targets:
          - "{{ peer_node_exporter_target }}"
        labels:
          instance: node-peer
          role: peer

  # ------------------------------------------------------------------
  # chrony_exporter — LOCAL host clock health. Deployed by the
  # ntp-hygiene Ansible role as a systemd unit (NOT a container —
  # needs to read /run/chrony/chronyd.sock). Bound to 127.0.0.1:9123;
  # Prometheus reaches the host loopback via the host-gateway alias
  # declared in docker-compose.obs.yml.
  # Metrics consumed by ops/compose/mgmt-host/monitoring/rules/ntp.yml.
  # ------------------------------------------------------------------
  - job_name: chrony
    static_configs:
      - targets:
          - "host.docker.internal:9123"
        labels:
          instance: chrony-local
          role: local

  # ------------------------------------------------------------------
  # ntp-health-agent (Block 12A) — authoritative NTP health verdict daemon.
  # systemd binary (not a container), reads chrony socket, exposes
  # ntp_health_class + ntp_stratum + ntp_rms_offset_seconds + ntp_freq_ppm.
  # Prometheus reaches host loopback via host-gateway alias.
  # Metrics consumed by ntp-health alert rules (Block 12A).
  # ------------------------------------------------------------------
  - job_name: ntp_health_agent
    scrape_interval: 30s
    static_configs:
      - targets:
          - "host.docker.internal:9753"
        labels:
          instance: ntp-health-local
          role: local
