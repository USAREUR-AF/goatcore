# {{ ansible_managed }}
WG_IFNAME={{ item.interface }}
{% set _key = peering_forwarder_config_dir ~ '/' ~ item.interface ~ '.key' %}
{% set bs = '%c' | format(92) %}{% set lf = '%c' | format(10) %}
WG_KEY_FILE={{ undef(hint='the carrier key path holds a newline, which no environment file can carry') if lf in _key else '"' ~ (_key | replace(bs, bs ~ bs) | replace('"', bs ~ '"') | replace('$', bs ~ '$') | replace('`', bs ~ '`')) ~ '"' }}
WG_LISTEN_PORT={{ item.carrier_port }}
WG_MTU={{ item.carrier_mtu }}
WG_LINK_ADDR={{ item.carrier_local_ip }}/{{ item.carrier_prefix_len }}
WG_PEER_KEY={{ item.edge_carrier_public_key }}
WG_PEER_ALLOWED={{ item.carrier_remote_ip }}/32
WG_NFT_FILE={{ peering_forwarder_nft_path }}
