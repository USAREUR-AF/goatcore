# {{ ansible_managed }}
WG_IFNAME={{ item.interface }}
{# One double-quoted value for systemd's EnvironmentFile and a shell that sources
    the file: backslash, " $ and ` escaped; a newline refused. The backslash and
    newline come from format(): Jinja string escapes differ across Ansible versions. #}
{% macro envq(v, what) %}{% set bs = '%c' | format(92) %}{% set lf = '%c' | format(10) %}{{ undef(hint=what ~ ' holds a newline, which no environment file can carry') if lf in v else '"' ~ (v | replace(bs, bs ~ bs) | replace('"', bs ~ '"') | replace('$', bs ~ '$') | replace('`', bs ~ '`')) ~ '"' }}{% endmacro %}
WG_KEY_FILE={{ envq(peering_forwarder_config_dir ~ '/' ~ item.interface ~ '.key', 'the carrier key path (peering_forwarder_config_dir)') }}
WG_LISTEN_PORT={{ item.carrier_port }}
WG_MTU={{ item.carrier_mtu }}
WG_LINK_ADDR={{ item.carrier_local_ip }}/{{ item.carrier_prefix_len }}
WG_PEER_KEY={{ item.edge_carrier_public_key }}
WG_PEER_ALLOWED={{ item.carrier_remote_ip }}/32
WG_NFT_FILE={{ envq(peering_forwarder_nft_path, 'peering_forwarder_nft_path') }}
