+// noToken fails if any output or error text holds the token, raw or in base64
+// at any of its three alignments.
+func noToken(t *testing.T, token string, texts ...string) {
+	t.Helper()
+	require.NotEmpty(t, token)
+	forms := []string{token}
+	for i := 0; i < 3; i++ {
+		enc := b64.StdEncoding.EncodeToString([]byte(strings.Repeat("x", i) + token))
+		forms = append(forms, enc[4:len(enc)-4])
+	}
+	for _, text := range texts {
+		require.NotContains(t, text, "nbp_")
+		for _, f := range forms {
+			require.NotContains(t, text, f)
+		}
+	}
+}
