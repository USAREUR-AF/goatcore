+	old := f.plain(t)
+	require.NoError(t, f.install(t, old, &out))
+	oldID := f.pats(t)[0].ID
+
+	// Without --rotate nothing new is made; with it, a pending token while
+	// the old one works.
+	out.Reset()
+	require.NoError(t, f.user(t, &out))
+	require.Equal(t, "held", state(t, &out))
+	out.Reset()
+	require.NoError(t, f.rotate(t, &out))
+	require.Equal(t, "pending", state(t, &out))
+	next := f.plain(t)
+	require.NotEqual(t, old, next)
+	require.True(t, authenticates(t, f, old), "the old token works while the new one is pending")
+	require.False(t, authenticates(t, f, next))
+
+	// Install outside a rotation refuses; the store kept the old value: refused.
+	require.Error(t, f.install(t, next, &out))
+	require.Error(t, f.installRotate(t, old, &out))
+	require.Len(t, f.pats(t), 1)
+
+	out.Reset()
+	require.NoError(t, f.installRotate(t, next, &out))
+	st := lastStatus(t, &out)
+	require.Equal(t, "installed", st.State)
+	require.Equal(t, oldID, st.OldTokenID)
+	require.Len(t, f.pats(t), 2, "the rotation window: old and new")
+	require.True(t, authenticates(t, f, old) && authenticates(t, f, next))
+	noToken(t, next, out.String())
+
+	// A third token is never made while two are held.
+	require.ErrorContains(t, f.rotate(t, &out), "exactly one token row")
+	require.ErrorContains(t, f.installRotate(t, next, &out), "")
+
+	// The old row goes only by its id, and never the only row.
+	require.Error(t, runBootstrapTokenRevoke(f.ctx, f.s, f.ev, &out, suName, "", "no-such-row"))
+	require.NoError(t, runBootstrapTokenRevoke(f.ctx, f.s, f.ev, &out, suName, "", oldID))
+	require.False(t, authenticates(t, f, old))
+	require.True(t, authenticates(t, f, next))
+	require.ErrorContains(t, runBootstrapTokenRevoke(f.ctx, f.s, f.ev, &out, suName, "", st.TokenID), "only one")
+	require.Len(t, f.pats(t), 1)
+	evs := f.events(t)
+	require.Equal(t, activity.PersonalAccessTokenCreated, evs[2])
+	require.Equal(t, activity.PersonalAccessTokenDeleted, evs[3])
+
+	// A rotation needs a service user with its one token.
+	g := newSUFixture(t)
+	require.ErrorContains(t, g.rotate(t, &out), "no service user")
+}
