+func TestServiceUserDirIsCheckedForRealUse(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "d")
+	require.NoError(t, os.Mkdir(dir, 0o755))
+	require.ErrorContains(t, checkBootstrapDir(dir), "not 0700")
+	require.NoError(t, os.Chmod(dir, 0o700))
+	link := filepath.Join(t.TempDir(), "l")
+	require.NoError(t, os.Symlink(dir, link))
+	require.Error(t, checkBootstrapDir(link))
+	require.Error(t, checkBootstrapDir("relative"))
+	fstype, err := mountFSType(dir)
+	require.NoError(t, err)
+	if fstype == "tmpfs" {
+		require.NoError(t, checkBootstrapDir(dir))
+	} else {
+		require.ErrorContains(t, checkBootstrapDir(dir), "not tmpfs")
+	}
+	got, err := mountFSType("/proc/self")
+	require.NoError(t, err)
+	require.Equal(t, "proc", got)
+
+	// O_EXCL: a file already there is a refusal, never an overwrite.
+	p := filepath.Join(dir, "x")
+	require.NoError(t, writeExcl(p, []byte("a")))
+	require.Error(t, writeExcl(p, []byte("b")))
+	b, _ := os.ReadFile(p)
+	require.Equal(t, "a", string(b))
+}
