+func TestServiceUserBootstrapMakesAPendingTokenThatDoesNotWorkYet(t *testing.T) {
+	f := newSUFixture(t)
+	var out bytes.Buffer
+	require.NoError(t, f.user(t, &out))
+	require.Equal(t, "pending", state(t, &out))
+
+	u, err := f.s.GetUserByUserID(f.ctx, store.LockingStrengthNone, serviceUserID(suName))
+	require.NoError(t, err)
+	require.True(t, u.IsServiceUser)
+	require.Equal(t, types.UserRoleAdmin, u.Role)
+	require.Equal(t, suName, u.ServiceUserName)
+	require.Empty(t, u.Name, "name is encrypted at rest; a service user writes it empty")
+	require.Empty(t, u.Email)
+	_, err = f.s.GetAccount(f.ctx, f.acct)
+	require.NoError(t, err, "the account still loads after the write")
+
+	require.Empty(t, f.pats(t), "no token row until install")
+	tok, pat := f.pending(t)
+	for _, p := range []string{tok, pat} {
+		fi, err := os.Stat(p)
+		require.NoError(t, err)
+		require.Equal(t, os.FileMode(0o600), fi.Mode().Perm(), p)
+	}
+	plain := f.plain(t)
+	require.Len(t, plain, types.PATLength)
+	sum := sha256.Sum256([]byte(plain))
+	_, err = f.s.GetPATByHashedToken(f.ctx, store.LockingStrengthNone, b64.StdEncoding.EncodeToString(sum[:]))
+	require.Error(t, err, "a pending token authenticates nothing")
+	require.Equal(t, []activity.Activity{activity.ServiceUserCreated}, f.events(t))
+	noToken(t, plain, out.String())
+}
