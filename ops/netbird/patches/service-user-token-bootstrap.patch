+	activitystore "github.com/netbirdio/netbird/management/server/activity/store"
+	"github.com/netbirdio/netbird/management/server/store"
+	"github.com/netbirdio/netbird/management/server/types"
+	"github.com/netbirdio/netbird/util/crypt"
+)
+
+const suName = "svc-zagros-netbird-infra"
+
+type suFixture struct {
+	ctx  context.Context
+	s    store.Store
+	ev   *activitystore.Store
+	dir  string
+	acct string
+}
+
+func newSUFixture(t *testing.T, accounts ...string) *suFixture {
+	t.Helper()
+	if len(accounts) == 0 {
+		accounts = []string{"acc-zagros"}
+	}
+	ctx := context.Background()
+	s, cleanup, err := store.NewTestStoreFromSQL(ctx, "", t.TempDir())
+	require.NoError(t, err)
+	t.Cleanup(cleanup)
+	for i, id := range accounts {
+		owner := types.NewOwnerUser("owner-"+id, "", "")
+		owner.AccountID = id
+		acc := &types.Account{
+			Id: id, CreatedAt: time.Now().UTC(), CreatedBy: owner.Id, Domain: "zagros.example.org",
+			Network: types.NewNetwork(), Users: map[string]*types.User{owner.Id: owner},
+			Settings: &types.Settings{PeerLoginExpiration: types.DefaultPeerLoginExpiration},
+		}
+		require.NoError(t, acc.AddAllGroup(false), i)
+		require.NoError(t, s.SaveAccount(ctx, acc))
+	}
+	key, err := crypt.GenerateKey()
+	require.NoError(t, err)
+	ev, err := activitystore.NewSqlStore(ctx, t.TempDir(), key)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = ev.Close(ctx) })
+	dir := filepath.Join(t.TempDir(), "goat-bootstrap")
+	require.NoError(t, os.Mkdir(dir, 0o700))
+	saved := suCheckDir
+	suCheckDir = func(string) error { return nil } // a test cannot hold a root tmpfs
+	t.Cleanup(func() { suCheckDir = saved })
+	return &suFixture{ctx: ctx, s: s, ev: ev, dir: dir, acct: accounts[0]}
+}
