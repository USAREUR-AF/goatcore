@@ -0,0 +1,485 @@
+package cmd
+
+import (
+	"bufio"
+	"context"
+	"crypto/sha256"
+	"crypto/subtle"
+	b64 "encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"syscall"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+	"github.com/spf13/cobra"
+
+	"github.com/netbirdio/netbird/formatter/hook"
+	nbconfig "github.com/netbirdio/netbird/management/internals/server/config"
+	"github.com/netbirdio/netbird/management/server/activity"
+	activitystore "github.com/netbirdio/netbird/management/server/activity/store"
+	"github.com/netbirdio/netbird/management/server/store"
+	"github.com/netbirdio/netbird/management/server/types"
+	"github.com/netbirdio/netbird/shared/management/status"
+	"github.com/netbirdio/netbird/util"
+)
+
+func isNotFound(err error) bool {
+	if s, ok := status.FromError(err); ok {
+		return s.Type() == status.NotFound
+	}
+	return false
+}
+
+// The `service-user` command tree mints the goatnet's bootstrap admin service
+// user and its personal access token OFFLINE, against the store, with no
+// dashboard and no OIDC login (goat ADR 1273). It never writes the plaintext
+// token to stdout, stderr, an argument, an environment variable or an error:
+//
+//   - bootstrap-user makes the service user (if absent) and a PENDING token with
+//     NetBird's own code. The plaintext goes to <dir>/<user-id>.token and the
+//     token row (hash only) to <dir>/<user-id>.pat.json, each created O_EXCL,
+//     mode 0600, in a root-owned 0700 tmpfs directory. No token row is saved in
+//     the store, so the token does not authenticate yet.
+//   - bootstrap-token-install reads the value the caller stored and read back,
+//     on stdin, refuses unless it equals the pending plaintext, then saves the
+//     pending token row and removes both files. Only now does the token work.
+//   - bootstrap-token-revoke deletes the service user's tokens: the deliberate
+//     recovery when a token row exists with no stored copy. Never run by a
+//     standup.
+//
+// Each step writes NetBird's own activity event, and fails if it cannot.
+
+const (
+	suMinDays       = 30
+	suMaxDays       = 365
+	suStdinMaxBytes = 4096
+)
+
+// Status is the only thing these commands print: never a token.
+type suStatus struct {
+	State  string `json:"state"`
+	UserID string `json:"user_id"`
+	Name   string `json:"name"`
+}
+
+var (
+	svcIDSanitizer = regexp.MustCompile(`[^a-zA-Z0-9_-]+`)
+
+	// suCheckDir is replaced in tests (they cannot run as root on a tmpfs).
+	suCheckDir = checkBootstrapDir
+)
+
+func newServiceUserCommands() *cobra.Command {
+	var (
+		name, accountID, dir string
+		expires              int
+	)
+	suCmd := &cobra.Command{
+		Use:   "service-user",
+		Short: "Mint the bootstrap admin service user and its token offline (goat ADR 1273)",
+	}
+	userCmd := &cobra.Command{
+		Use:   "bootstrap-user",
+		Short: "Make the service user if absent, and a pending token in --dir; no token is valid yet",
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			return withServiceUserStores(cmd, func(ctx context.Context, s store.Store, ev activity.Store) error {
+				return runBootstrapUser(ctx, s, ev, cmd.OutOrStdout(), name, accountID, dir, expires)
+			})
+		},
+	}
+	userCmd.Flags().StringVar(&name, "name", "", "the service user's name, as the registry resolves it (required)")
+	userCmd.Flags().StringVar(&accountID, "account-id", "", "the account (default: the only one; refused when there are several)")
+	userCmd.Flags().StringVar(&dir, "dir", "", "root-owned 0700 tmpfs directory for the pending token (required)")
+	userCmd.Flags().IntVar(&expires, "expires-in-days", suMaxDays, "token lifetime in days (30..365)")
+
+	installCmd := &cobra.Command{
+		Use:   "bootstrap-token-install",
+		Short: "Switch the pending token on, given the stored and read-back value on stdin",
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			return withServiceUserStores(cmd, func(ctx context.Context, s store.Store, ev activity.Store) error {
+				return runBootstrapTokenInstall(ctx, s, ev, cmd.InOrStdin(), cmd.OutOrStdout(), name, dir)
+			})
+		},
+	}
+	installCmd.Flags().StringVar(&name, "name", "", "the service user's name (required)")
+	installCmd.Flags().StringVar(&dir, "dir", "", "the directory bootstrap-user wrote to (required)")
+
+	revokeCmd := &cobra.Command{
+		Use:   "bootstrap-token-revoke",
+		Short: "Delete the service user's tokens (deliberate recovery; never run by a standup)",
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			return withServiceUserStores(cmd, func(ctx context.Context, s store.Store, ev activity.Store) error {
+				return runBootstrapTokenRevoke(ctx, s, ev, cmd.OutOrStdout(), name)
+			})
+		},
+	}
+	revokeCmd.Flags().StringVar(&name, "name", "", "the service user's name (required)")
+
+	for _, c := range []*cobra.Command{userCmd, installCmd, revokeCmd} {
+		if err := c.MarkFlagRequired("name"); err != nil {
+			panic(err)
+		}
+		suCmd.AddCommand(c)
+	}
+	for _, c := range []*cobra.Command{userCmd, installCmd} {
+		if err := c.MarkFlagRequired("dir"); err != nil {
+			panic(err)
+		}
+	}
+	suCmd.PersistentFlags().StringVar(&tokenDatadir, "datadir", "", "Override the data directory from config (where store.db is located)")
+	return suCmd
+}
+
+// withServiceUserStores opens the account store and the activity store, as
+// the management server does.
+func withServiceUserStores(cmd *cobra.Command, fn func(ctx context.Context, s store.Store, ev activity.Store) error) error {
+	if err := util.InitLog("error", "console"); err != nil {
+		return fmt.Errorf("init log: %w", err)
+	}
+	ctx := context.WithValue(cmd.Context(), hook.ExecutionContextKey, hook.SystemSource) //nolint:staticcheck
+	config, err := LoadMgmtConfig(ctx, nbconfig.MgmtConfigPath)
+	if err != nil {
+		return fmt.Errorf("load config: %w", err)
+	}
+	datadir := config.Datadir
+	if tokenDatadir != "" {
+		datadir = tokenDatadir
+	}
+	s, err := store.NewStore(ctx, config.StoreConfig.Engine, datadir, nil, true)
+	if err != nil {
+		return fmt.Errorf("create store: %w", err)
+	}
+	defer func() {
+		if err := s.Close(ctx); err != nil {
+			log.Debugf("close store: %v", err)
+		}
+	}()
+	ev, err := activitystore.NewSqlStore(ctx, datadir, config.DataStoreEncryptionKey)
+	if err != nil {
+		return fmt.Errorf("open the activity store: %w", err)
+	}
+	defer func() {
+		if err := ev.Close(ctx); err != nil {
+			log.Debugf("close activity store: %v", err)
+		}
+	}()
+	return fn(ctx, s, ev)
+}
+
+func serviceUserID(name string) string {
+	return "svc-" + svcIDSanitizer.ReplaceAllString(strings.ToLower(name), "-")
+}
+
+func pendingPaths(dir, userID string) (string, string) {
+	return filepath.Join(dir, userID+".token"), filepath.Join(dir, userID+".pat.json")
+}
+
+// checkBootstrapDir refuses anything but a real directory (not a symlink),
+// owned by this process's user, mode 0700, on tmpfs.
+func checkBootstrapDir(dir string) error {
+	if !filepath.IsAbs(dir) {
+		return fmt.Errorf("--dir %s is not an absolute path", dir)
+	}
+	fi, err := os.Lstat(dir)
+	if err != nil {
+		return fmt.Errorf("--dir %s: %w", dir, err)
+	}
+	if !fi.IsDir() || fi.Mode()&os.ModeSymlink != 0 {
+		return fmt.Errorf("--dir %s is not a directory", dir)
+	}
+	if fi.Mode().Perm() != 0o700 {
+		return fmt.Errorf("--dir %s has mode %o, not 0700", dir, fi.Mode().Perm())
+	}
+	st, ok := fi.Sys().(*syscall.Stat_t)
+	if !ok || int(st.Uid) != os.Geteuid() {
+		return fmt.Errorf("--dir %s is not owned by the user running this command", dir)
+	}
+	fstype, err := mountFSType(dir)
+	if err != nil {
+		return err
+	}
+	if fstype != "tmpfs" {
+		return fmt.Errorf("--dir %s is on %s, not tmpfs: a token must not reach a disk", dir, fstype)
+	}
+	return nil
+}
+
+// mountFSType reads /proc/self/mountinfo and returns the filesystem type of
+// the mount that holds path (the longest mount point that prefixes it).
+func mountFSType(path string) (string, error) {
+	f, err := os.Open("/proc/self/mountinfo")
+	if err != nil {
+		return "", fmt.Errorf("read mounts: %w", err)
+	}
+	defer f.Close()
+	best, fstype := "", ""
+	sc := bufio.NewScanner(f)
+	for sc.Scan() {
+		fields := strings.Fields(sc.Text())
+		sep := -1
+		for i, x := range fields {
+			if x == "-" {
+				sep = i
+				break
+			}
+		}
+		if len(fields) < 5 || sep < 0 || sep+1 >= len(fields) {
+			continue
+		}
+		mp := fields[4]
+		if (path == mp || strings.HasPrefix(path, strings.TrimSuffix(mp, "/")+"/") || mp == "/") && len(mp) > len(best) {
+			best, fstype = mp, fields[sep+1]
+		}
+	}
+	if best == "" {
+		return "", fmt.Errorf("no mount holds %s", path)
+	}
+	return fstype, nil
+}
+
+// writeExcl creates path with O_EXCL, mode 0600, and writes data.
+func writeExcl(path string, data []byte) error {
+	f, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return fmt.Errorf("create %s: %w", path, err)
+	}
+	if _, err := f.Write(data); err != nil {
+		_ = f.Close()
+		_ = os.Remove(path)
+		return fmt.Errorf("write %s: %w", path, err)
+	}
+	if err := f.Close(); err != nil {
+		_ = os.Remove(path)
+		return fmt.Errorf("close %s: %w", path, err)
+	}
+	return nil
+}
+
+func emit(w io.Writer, state, userID, name string) error {
+	b, err := json.Marshal(suStatus{State: state, UserID: userID, Name: name})
+	if err != nil {
+		return err
+	}
+	_, err = fmt.Fprintln(w, string(b))
+	return err
+}
+
+func soleAccount(ctx context.Context, s store.Store, accountID string) (string, error) {
+	if accountID != "" {
+		if _, err := s.GetAccount(ctx, accountID); err != nil {
+			return "", fmt.Errorf("account %s: %w", accountID, err)
+		}
+		return accountID, nil
+	}
+	accounts := s.GetAllAccounts(ctx)
+	switch len(accounts) {
+	case 0:
+		return "", fmt.Errorf("no account exists yet: the site's bootstrap creates it first")
+	case 1:
+		return accounts[0].Id, nil
+	default:
+		return "", fmt.Errorf("%d accounts present; give --account-id", len(accounts))
+	}
+}
+
+func saveEvent(ctx context.Context, ev activity.Store, a activity.Activity, accountID, targetID string, meta map[string]any) error {
+	_, err := ev.Save(ctx, &activity.Event{
+		Timestamp:   time.Now().UTC(),
+		Activity:    a,
+		InitiatorID: activity.SystemInitiator,
+		TargetID:    targetID,
+		AccountID:   accountID,
+		Meta:        meta,
+	})
+	if err != nil {
+		return fmt.Errorf("write the activity event %q: %w", a.Message(), err)
+	}
+	return nil
+}
+
+func runBootstrapUser(ctx context.Context, s store.Store, ev activity.Store, w io.Writer, name, accountID, dir string, expiresInDays int) error {
+	if strings.TrimSpace(name) == "" {
+		return fmt.Errorf("--name is required")
+	}
+	if expiresInDays < suMinDays || expiresInDays > suMaxDays {
+		return fmt.Errorf("--expires-in-days must be between %d and %d", suMinDays, suMaxDays)
+	}
+	if err := suCheckDir(dir); err != nil {
+		return err
+	}
+	accountID, err := soleAccount(ctx, s, accountID)
+	if err != nil {
+		return err
+	}
+	userID := serviceUserID(name)
+	tokenPath, patPath := pendingPaths(dir, userID)
+
+	user, err := s.GetUserByUserID(ctx, store.LockingStrengthNone, userID)
+	switch {
+	case err == nil:
+		if user.AccountID != accountID || !user.IsServiceUser || user.ServiceUserName != name {
+			return fmt.Errorf("user %s exists and is not this account's service user %s; nothing was changed", userID, name)
+		}
+		pats, err := s.GetUserPATs(ctx, store.LockingStrengthNone, userID)
+		if err != nil {
+			return fmt.Errorf("read the service user's tokens: %w", err)
+		}
+		if len(pats) > 0 {
+			// Its token row exists: never a second one. Whether the caller
+			// holds a copy is the caller's check; recovery is
+			// bootstrap-token-revoke, never this command.
+			return emit(w, "held", userID, name)
+		}
+		if _, terr := os.Lstat(tokenPath); terr == nil {
+			if _, perr := os.Lstat(patPath); perr != nil {
+				return fmt.Errorf("%s is there without %s; remove it and run again", tokenPath, patPath)
+			}
+			return emit(w, "pending", userID, name)
+		}
+		if _, perr := os.Lstat(patPath); perr == nil {
+			return fmt.Errorf("%s is there without %s; remove it and run again", patPath, tokenPath)
+		}
+	case isNotFound(err):
+		user = types.NewUser(userID, types.UserRoleAdmin, true, false, name, []string{}, types.UserIssuedAPI, "", "")
+		user.AccountID = accountID
+		if err := s.SaveUser(ctx, user); err != nil {
+			return fmt.Errorf("save the service user: %w", err)
+		}
+		if err := saveEvent(ctx, ev, activity.ServiceUserCreated, accountID, userID, map[string]any{"name": name, "by": "goat standup"}); err != nil {
+			if derr := s.DeleteUser(ctx, accountID, userID); derr != nil {
+				return fmt.Errorf("%v; and removing the service user again failed: %w", err, derr)
+			}
+			return err
+		}
+	default:
+		return fmt.Errorf("read the service user: %w", err)
+	}
+
+	gen, err := types.CreateNewPAT(name, expiresInDays, userID, userID)
+	if err != nil {
+		return fmt.Errorf("generate the token: %w", err)
+	}
+	row := gen.PersonalAccessToken
+	row.UserID = userID
+	pat, err := json.Marshal(&row)
+	if err != nil {
+		return fmt.Errorf("encode the pending token row: %w", err)
+	}
+	if err := writeExcl(tokenPath, []byte(gen.PlainToken)); err != nil {
+		return err
+	}
+	if err := writeExcl(patPath, pat); err != nil {
+		_ = os.Remove(tokenPath)
+		return err
+	}
+	return emit(w, "pending", userID, name)
+}
+
+func readPending(dir, userID string) ([]byte, *types.PersonalAccessToken, error) {
+	tokenPath, patPath := pendingPaths(dir, userID)
+	plain, err := os.ReadFile(tokenPath)
+	if err != nil {
+		return nil, nil, fmt.Errorf("no pending token at %s: run bootstrap-user first", tokenPath)
+	}
+	raw, err := os.ReadFile(patPath)
+	if err != nil {
+		return nil, nil, fmt.Errorf("no pending token row at %s: run bootstrap-user first", patPath)
+	}
+	var pat types.PersonalAccessToken
+	if err := json.Unmarshal(raw, &pat); err != nil {
+		return nil, nil, fmt.Errorf("the pending token row at %s cannot be read", patPath)
+	}
+	return plain, &pat, nil
+}
+
+func runBootstrapTokenInstall(ctx context.Context, s store.Store, ev activity.Store, in io.Reader, w io.Writer, name, dir string) error {
+	if strings.TrimSpace(name) == "" {
+		return fmt.Errorf("--name is required")
+	}
+	if err := suCheckDir(dir); err != nil {
+		return err
+	}
+	userID := serviceUserID(name)
+	user, err := s.GetUserByUserID(ctx, store.LockingStrengthNone, userID)
+	if err != nil {
+		return fmt.Errorf("read the service user %s: %w", userID, err)
+	}
+	if !user.IsServiceUser || user.ServiceUserName != name {
+		return fmt.Errorf("user %s is not the service user %s; nothing was changed", userID, name)
+	}
+	pats, err := s.GetUserPATs(ctx, store.LockingStrengthNone, userID)
+	if err != nil {
+		return fmt.Errorf("read the service user's tokens: %w", err)
+	}
+	if len(pats) > 0 {
+		return fmt.Errorf("the service user %s already holds a token; nothing was changed", name)
+	}
+	plain, pat, err := readPending(dir, userID)
+	if err != nil {
+		return err
+	}
+	stored, err := io.ReadAll(io.LimitReader(in, suStdinMaxBytes))
+	if err != nil {
+		return fmt.Errorf("read the stored value on stdin: %w", err)
+	}
+	stored = []byte(strings.TrimRight(string(stored), "\r\n"))
+	if len(stored) == 0 || subtle.ConstantTimeCompare(stored, plain) != 1 {
+		return fmt.Errorf("the value on stdin is not the pending token: the store did not keep what was written; no token was switched on")
+	}
+	sum := sha256.Sum256(plain)
+	if pat.UserID != userID || pat.HashedToken != b64.StdEncoding.EncodeToString(sum[:]) || pat.ExpirationDate == nil {
+		return fmt.Errorf("the pending token row does not belong to the pending token; remove both pending files and run bootstrap-user again")
+	}
+	if err := s.SavePAT(ctx, pat); err != nil {
+		return fmt.Errorf("save the token: %w", err)
+	}
+	if err := saveEvent(ctx, ev, activity.PersonalAccessTokenCreated, user.AccountID, userID, map[string]any{"name": pat.Name, "user_name": name, "by": "goat standup"}); err != nil {
+		if derr := s.DeletePAT(ctx, userID, pat.ID); derr != nil {
+			return fmt.Errorf("%v; and removing the token again failed: %w", err, derr)
+		}
+		return err
+	}
+	tokenPath, patPath := pendingPaths(dir, userID)
+	rmErr := errors.Join(os.Remove(tokenPath), os.Remove(patPath))
+	if err := emit(w, "installed", userID, name); err != nil {
+		return err
+	}
+	if rmErr != nil {
+		return fmt.Errorf("the token is switched on, and removing the pending files failed: %w", rmErr)
+	}
+	return nil
+}
+
+func runBootstrapTokenRevoke(ctx context.Context, s store.Store, ev activity.Store, w io.Writer, name string) error {
+	if strings.TrimSpace(name) == "" {
+		return fmt.Errorf("--name is required")
+	}
+	userID := serviceUserID(name)
+	user, err := s.GetUserByUserID(ctx, store.LockingStrengthNone, userID)
+	if err != nil {
+		return fmt.Errorf("read the service user %s: %w", userID, err)
+	}
+	if !user.IsServiceUser || user.ServiceUserName != name {
+		return fmt.Errorf("user %s is not the service user %s; nothing was changed", userID, name)
+	}
+	pats, err := s.GetUserPATs(ctx, store.LockingStrengthNone, userID)
+	if err != nil {
+		return fmt.Errorf("read the service user's tokens: %w", err)
+	}
+	for _, p := range pats {
+		if err := s.DeletePAT(ctx, userID, p.ID); err != nil {
+			return fmt.Errorf("delete token %s: %w", p.ID, err)
+		}
+		if err := saveEvent(ctx, ev, activity.PersonalAccessTokenDeleted, user.AccountID, userID, map[string]any{"name": p.Name, "user_name": name, "by": "goat bootstrap-token-revoke"}); err != nil {
+			return err
+		}
+	}
+	return emit(w, "revoked", userID, name)
+}
