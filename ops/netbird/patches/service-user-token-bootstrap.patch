+// Two runs at once, each in its own directory: one service user, and one
+// token row. Runs on SQLite, and on Postgres where NETBIRD_STORE_ENGINE=postgres
+// (the row lock only matters there).
+func TestServiceUserConcurrentRunsMakeOneUserAndOneToken(t *testing.T) {
+	tries := 15
+	for try := 0; try < tries; try++ {
+		f := newSUFixture(t)
+		dirs := []string{f.newDir(t), f.newDir(t)}
+		errs := make(chan error, 2)
+		start := make(chan struct{})
+		for _, d := range dirs {
+			go func(d string) {
+				<-start
+				var out bytes.Buffer
+				errs <- runBootstrapUser(f.ctx, f.s, f.ev, &out, suName, "", d, 365, false)
+			}(d)
+		}
+		close(start)
+		var got []error
+		for range dirs {
+			if err := <-errs; err != nil {
+				got = append(got, err)
+			}
+		}
+		require.Empty(t, got, "try %d: both runs succeed, the second finding the first's user", try)
+		require.Equal(t, 1, f.countServiceUsers(t), "try %d: two concurrent bootstrap-user runs", try)
+
+		// Make sure both directories hold a pending token for that one user.
+		for _, d := range dirs {
+			var out bytes.Buffer
+			require.NoError(t, runBootstrapUser(f.ctx, f.s, f.ev, &out, suName, "", d, 365, false))
+		}
+		plains := []string{}
+		for _, d := range dirs {
+			tok, _ := pendingNames(suName)
+			b, err := os.ReadFile(filepath.Join(d, tok))
+			require.NoError(t, err)
+			plains = append(plains, string(b))
+		}
+		start = make(chan struct{})
+		for i, d := range dirs {
+			go func(d, plain string) {
+				<-start
+				var out bytes.Buffer
+				errs <- runBootstrapTokenInstall(f.ctx, f.s, f.ev, strings.NewReader(plain), &out, suName, "", d, false)
+			}(d, plains[i])
+		}
+		close(start)
+		for range dirs {
+			<-errs
+		}
+		require.Len(t, f.pats(t), 1, "try %d: two concurrent installs from two directories", try)
+	}
+}
