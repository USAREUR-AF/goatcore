+func TestServiceUserResumesAPendingTokenAndNeverMakesTwo(t *testing.T) {
+	f := newSUFixture(t)
+	var out bytes.Buffer
+	require.NoError(t, f.user(t, &out))
+	first := f.plain(t)
+
+	// The run stopped before install: the same pending token is kept.
+	require.NoError(t, f.user(t, &out))
+	require.Equal(t, "pending", state(t, &out))
+	require.Equal(t, first, f.plain(t))
+	require.Equal(t, []activity.Activity{activity.ServiceUserCreated}, f.events(t))
+
+	// The pending files are gone (a reboot cleared /run): a new pending token,
+	// and still no token row, so this is not a second token.
+	tok, pat := f.pending(t)
+	require.NoError(t, os.Remove(tok))
+	require.NoError(t, os.Remove(pat))
+	require.NoError(t, f.user(t, &out))
+	require.NotEqual(t, first, f.plain(t))
+	require.Empty(t, f.pats(t))
+
+	// Half a pair is refused, and nothing is written.
+	require.NoError(t, os.Remove(pat))
+	err := f.user(t, &out)
+	require.Error(t, err)
+	require.NoFileExists(t, pat)
+}
