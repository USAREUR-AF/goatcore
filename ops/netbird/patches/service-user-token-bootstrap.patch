+func TestServiceUserInstallRefusesAWrongRowOrASecondToken(t *testing.T) {
+	f := newSUFixture(t)
+	var out bytes.Buffer
+	require.NoError(t, f.user(t, &out))
+	plain := f.plain(t)
+	_, patPath := f.pending(t)
+	orig, err := os.ReadFile(patPath)
+	require.NoError(t, err)
+	var row types.PersonalAccessToken
+	require.NoError(t, json.Unmarshal(orig, &row))
+	far := time.Now().Add(400 * 24 * time.Hour)
+	for why, mutate := range map[string]func(r *types.PersonalAccessToken){
+		"another user":   func(r *types.PersonalAccessToken) { r.UserID = "owner-acc-zagros" },
+		"another hash":   func(r *types.PersonalAccessToken) { r.HashedToken = "AAAA" },
+		"another name":   func(r *types.PersonalAccessToken) { r.Name = "other" },
+		"no expiry":      func(r *types.PersonalAccessToken) { r.ExpirationDate = nil },
+		"expiry too far": func(r *types.PersonalAccessToken) { r.ExpirationDate = &far },
+		"expiry too near": func(r *types.PersonalAccessToken) {
+			near := time.Now().Add(10 * 24 * time.Hour)
+			r.ExpirationDate = &near
+		},
+	} {
+		r := row
+		mutate(&r)
+		b, _ := json.Marshal(&r)
+		require.NoError(t, os.WriteFile(patPath, b, 0o600))
+		require.Error(t, f.install(t, plain, &out), why)
+		require.Empty(t, f.pats(t), why)
+	}
+	require.NoError(t, os.WriteFile(patPath, orig, 0o600))
+
+	// A token row that appeared meanwhile (another run): install refuses
+	// inside its transaction and adds none.
+	other, err := types.CreateNewPAT(suName, 365, f.su(t).Id, f.su(t).Id)
+	require.NoError(t, err)
+	other.PersonalAccessToken.UserID = f.su(t).Id
+	require.NoError(t, f.s.SavePAT(f.ctx, &other.PersonalAccessToken))
+	require.ErrorContains(t, f.install(t, plain, &out), "already holds a token")
+	require.Len(t, f.pats(t), 1)
+}
