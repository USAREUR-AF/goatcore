+func TestServiceUserInstallSwitchesOnOnlyTheReadBackValue(t *testing.T) {
+	f := newSUFixture(t)
+	var out bytes.Buffer
+	require.NoError(t, f.user(t, &out))
+	plain := f.plain(t)
+
+	for _, wrong := range []string{"", "nbp_" + strings.Repeat("0", 36), plain[:39], plain + "x"} {
+		var o bytes.Buffer
+		err := f.install(t, wrong, &o)
+		require.Error(t, err, wrong)
+		noToken(t, plain, o.String(), err.Error())
+		require.Empty(t, f.pats(t), "a store that kept another value switches nothing on")
+	}
+
+	out.Reset()
+	require.NoError(t, f.install(t, plain+"\n", &out))
+	require.Equal(t, "installed", state(t, &out))
+	noToken(t, plain, out.String())
+	pats := f.pats(t)
+	require.Len(t, pats, 1)
+	sum := sha256.Sum256([]byte(plain))
+	got, err := f.s.GetPATByHashedToken(f.ctx, store.LockingStrengthNone, b64.StdEncoding.EncodeToString(sum[:]))
+	require.NoError(t, err, "the read-back value now authenticates")
+	require.Equal(t, serviceUserID(suName), got.UserID)
+	exp := got.GetExpirationDate()
+	require.True(t, exp.After(time.Now().Add(364*24*time.Hour)) && exp.Before(time.Now().Add(366*24*time.Hour)), exp)
+	tok, pat := f.pending(t)
+	require.NoFileExists(t, tok)
+	require.NoFileExists(t, pat)
+	require.Equal(t, []activity.Activity{activity.ServiceUserCreated, activity.PersonalAccessTokenCreated}, f.events(t))
+}
