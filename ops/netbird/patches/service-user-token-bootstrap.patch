+func TestServiceUserDirIsCheckedByItsDescriptor(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "d")
+	require.NoError(t, os.Mkdir(dir, 0o755))
+	_, err := openBootstrapDir(dir)
+	require.ErrorContains(t, err, "not 0700")
+	require.NoError(t, os.Chmod(dir, 0o700))
+	link := filepath.Join(t.TempDir(), "l")
+	require.NoError(t, os.Symlink(dir, link))
+	_, err = openBootstrapDir(link)
+	require.Error(t, err, "a symlink is never followed")
+	_, err = openBootstrapDir("relative")
+	require.Error(t, err)
+
+	// The filesystem is read from the open directory itself, so a parent
+	// symlink or a mount stacked over the path cannot pass a disk off as
+	// tmpfs.
+	var fs unix.Statfs_t
+	require.NoError(t, unix.Statfs(dir, &fs))
+	d, err := openBootstrapDir(dir)
+	if fs.Type == unix.TMPFS_MAGIC {
+		require.NoError(t, err)
+		d.Close()
+	} else {
+		require.ErrorContains(t, err, "not on tmpfs")
+	}
+	if shm, serr := os.MkdirTemp("/dev/shm", "su-test-"); serr == nil {
+		t.Cleanup(func() { _ = os.RemoveAll(shm) })
+		require.NoError(t, os.Chmod(shm, 0o700))
+		d, err := openBootstrapDir(shm)
+		require.NoError(t, err, "a real tmpfs passes")
+		d.Close()
+		if fs.Type != unix.TMPFS_MAGIC {
+			through := filepath.Join(shm, "to-disk")
+			require.NoError(t, os.Symlink(filepath.Dir(dir), through))
+			_, err := openBootstrapDir(filepath.Join(through, "d"))
+			require.ErrorContains(t, err, "not on tmpfs", "a path through a tmpfs to a disk is a disk")
+		}
+	}
+
+	// O_EXCL: a file already there is a refusal, never an overwrite; a
+	// symlink in its place is never followed.
+	saved := suRequireTmpfs
+	suRequireTmpfs = false
+	t.Cleanup(func() { suRequireTmpfs = saved })
+	d, err = openBootstrapDir(dir)
+	require.NoError(t, err)
+	defer d.Close()
+	require.NoError(t, d.create("x", []byte("a")))
+	require.Error(t, d.create("x", []byte("b")))
+	b, _ := os.ReadFile(filepath.Join(dir, "x"))
+	require.Equal(t, "a", string(b))
+	elsewhere := filepath.Join(t.TempDir(), "target")
+	require.NoError(t, os.Symlink(elsewhere, filepath.Join(dir, "y")))
+	require.Error(t, d.create("y", []byte("c")))
+	require.NoFileExists(t, elsewhere)
+}
