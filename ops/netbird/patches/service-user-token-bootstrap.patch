+// The tmpfs check against a directory on a disk, whatever /tmp is: the
+// package's own directory is never a tmpfs on a build host.
+func TestServiceUserRefusesADiskDirectory(t *testing.T) {
+	wd, err := os.Getwd()
+	require.NoError(t, err)
+	var fs unix.Statfs_t
+	require.NoError(t, unix.Statfs(wd, &fs))
+	if fs.Type == unix.TMPFS_MAGIC {
+		t.Skip("the package directory is itself on tmpfs; no disk directory to test with")
+	}
+	disk, err := os.MkdirTemp(wd, "su-disk-")
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = os.RemoveAll(disk) })
+	require.NoError(t, os.Chmod(disk, 0o700))
+	saved := suRequireTmpfs
+	suRequireTmpfs = true
+	t.Cleanup(func() { suRequireTmpfs = saved })
+	_, err = openBootstrapDir(disk)
+	require.ErrorContains(t, err, "not on tmpfs")
+}
