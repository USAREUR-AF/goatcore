+package cmd
+
+import (
+	"context"
+	"crypto/sha256"
+	"crypto/subtle"
+	b64 "encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	log "github.com/sirupsen/logrus"
+	"github.com/spf13/cobra"
+	"golang.org/x/sys/unix"
+
+	"github.com/netbirdio/netbird/formatter/hook"
+	nbconfig "github.com/netbirdio/netbird/management/internals/server/config"
+	"github.com/netbirdio/netbird/management/server/activity"
+	activitystore "github.com/netbirdio/netbird/management/server/activity/store"
+	"github.com/netbirdio/netbird/management/server/store"
+	"github.com/netbirdio/netbird/management/server/types"
+	"github.com/netbirdio/netbird/util"
+)
+
+// The `service-user` command tree mints the goatnet's bootstrap admin service
+// user and its personal access token OFFLINE, against the store, with no
+// dashboard and no OIDC login (goat ADR 1273). It never writes the plaintext
+// token to stdout, stderr, an argument, an environment variable or an error:
+//
+//   - bootstrap-user makes the service user (if absent) and a PENDING token with
+//     NetBird's own code. The plaintext goes to <dir>/<name>.token and the
+//     token row (hash only) to <dir>/<name>.pat.json, each created O_EXCL,
+//     mode 0600, in a root-owned 0700 tmpfs directory, opened once and used by
+//     its descriptor. No token row is saved in the store, so the token does not
+//     authenticate yet.
+//   - bootstrap-token-install reads the value the caller stored and read back,
+//     on stdin, refuses unless it equals the pending plaintext, then saves the
+//     pending token row, in one transaction that first checks the service user
+//     holds none, and removes both files. Only now does the token work.
+//   - Rotation (renewal, and recovery from a token with no stored copy), run by
+//     a person, never by a standup: bootstrap-user --rotate makes a pending
+//     token while the one old token row stays valid; the caller replaces the
+//     stored copy and reads it back; bootstrap-token-install --rotate saves the
+//     new row while the old one still works (the only path that allows two);
+//     bootstrap-token-revoke --token-id removes the old row once the new
+//     token's consumers have it.
+//
+// Each step writes NetBird's own activity event, and fails (undoing its write)
+// if it cannot.
+
+const (
+	suMinDays       = 30
+	suMaxDays       = 365
+	suStdinMaxBytes = 4096
+
+	activityEngineEnv = "NB_ACTIVITY_EVENT_STORE_ENGINE"
+	activityFileEnv   = "NB_ACTIVITY_EVENT_SQLITE_FILE"
+)
+
+// Status is the only thing these commands print: never a token.
+type suStatus struct {
+	State   string `json:"state"`
+	UserID  string `json:"user_id"`
+	Name    string `json:"name"`
+	TokenID string `json:"token_id,omitempty"` // a token row's id, never the token
+	// OldTokenID is the row a rotation's install leaves for revoke --token-id.
+	OldTokenID string `json:"old_token_id,omitempty"`
+}
+
+var (
+	fileStemSanitizer = regexp.MustCompile(`[^a-z0-9_-]+`)
+
+	// suRequireTmpfs is turned off in tests only: a test directory is not a
+	// tmpfs on every machine.
+	suRequireTmpfs = true
+
+	// suOwnerUID is the owner the directory must have; tests replace it to
+	// show the check refuses another owner.
+	suOwnerUID = os.Geteuid
+)
+
+func newServiceUserCommands() *cobra.Command {
+	var (
+		name, accountID, dir, tokenID string
+		expires                       int
+		rotate                        bool
+	)
+	suCmd := &cobra.Command{
+		Use:   "service-user",
+		Short: "Mint the bootstrap admin service user and its token offline (goat ADR 1273)",
+	}
+	userCmd := &cobra.Command{
+		Use:   "bootstrap-user",
+		Short: "Make the service user if absent, and a pending token in --dir; no token is valid yet",
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			return withServiceUserStores(cmd, func(ctx context.Context, s store.Store, ev activity.Store) error {
+				return runBootstrapUser(ctx, s, ev, cmd.OutOrStdout(), name, accountID, dir, expires, rotate)
+			})
+		},
+	}
+	userCmd.Flags().IntVar(&expires, "expires-in-days", suMaxDays, "token lifetime in days (30..365)")
+
+	installCmd := &cobra.Command{
+		Use:   "bootstrap-token-install",
+		Short: "Switch the pending token on, given the stored and read-back value on stdin",
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			return withServiceUserStores(cmd, func(ctx context.Context, s store.Store, ev activity.Store) error {
+				return runBootstrapTokenInstall(ctx, s, ev, cmd.InOrStdin(), cmd.OutOrStdout(), name, accountID, dir, rotate)
+			})
+		},
+	}
+
+	revokeCmd := &cobra.Command{
+		Use:   "bootstrap-token-revoke",
+		Short: "Delete one of the service user's token rows, the old one after a rotation (never run by a standup)",
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			return withServiceUserStores(cmd, func(ctx context.Context, s store.Store, ev activity.Store) error {
+				return runBootstrapTokenRevoke(ctx, s, ev, cmd.OutOrStdout(), name, accountID, tokenID)
+			})
+		},
+	}
+	revokeCmd.Flags().StringVar(&tokenID, "token-id", "", "the token row to delete (required; never the service user's only one)")
+	if err := revokeCmd.MarkFlagRequired("token-id"); err != nil {
+		panic(err)
+	}
+
+	for _, c := range []*cobra.Command{userCmd, installCmd, revokeCmd} {
+		c.SilenceUsage = true
+		c.Flags().StringVar(&name, "name", "", "the service user's name, as the registry resolves it (required)")
+		c.Flags().StringVar(&accountID, "account-id", "", "the account (default: the only one; refused when there are several)")
+		if err := c.MarkFlagRequired("name"); err != nil {
+			panic(err)
+		}
+		suCmd.AddCommand(c)
+	}
+	for _, c := range []*cobra.Command{userCmd, installCmd} {
+		c.Flags().BoolVar(&rotate, "rotate", false, "rotation: the service user holds exactly one token, which stays valid until the new one is installed")
+		c.Flags().StringVar(&dir, "dir", "", "root-owned 0700 tmpfs directory for the pending token (required)")
+		if err := c.MarkFlagRequired("dir"); err != nil {
+			panic(err)
+		}
+	}
+	suCmd.PersistentFlags().StringVar(&tokenDatadir, "datadir", "", "Override the data directory from config (where store.db is located)")
+	return suCmd
+}
+
+// activityStoreReady refuses to open an activity store that the server does
+// not use: on SQLite (NetBird's default), an events file that does not exist
+// yet would be created here and read by nobody, so the event would be lost.
+func activityStoreReady(datadir string) error {
+	engine := os.Getenv(activityEngineEnv)
+	if engine != "" && types.Engine(engine) != types.SqliteStoreEngine {
+		return nil
+	}
+	file := "events.db"
+	if f := os.Getenv(activityFileEnv); f != "" {
+		file = f
+	}
+	if !filepath.IsAbs(file) {
+		file = filepath.Join(datadir, file)
+	}
+	if _, err := os.Stat(file); err != nil {
+		return fmt.Errorf("the activity store %s does not exist: run this with the management server's datadir and its %s, so the event lands where the server reads it", file, activityEngineEnv)
+	}
+	return nil
+}
+
+// withServiceUserStores opens the account store and the activity store, as
+// the management server does.
+func withServiceUserStores(cmd *cobra.Command, fn func(ctx context.Context, s store.Store, ev activity.Store) error) error {
+	if err := util.InitLog("error", "console"); err != nil {
+		return fmt.Errorf("init log: %w", err)
+	}
+	ctx := context.WithValue(cmd.Context(), hook.ExecutionContextKey, hook.SystemSource) //nolint:staticcheck
+	config, err := LoadMgmtConfig(ctx, nbconfig.MgmtConfigPath)
+	if err != nil {
+		return fmt.Errorf("load config: %w", err)
+	}
+	datadir := config.Datadir
+	if tokenDatadir != "" {
+		datadir = tokenDatadir
+	}
+	if err := activityStoreReady(datadir); err != nil {
+		return err
+	}
+	s, err := store.NewStore(ctx, config.StoreConfig.Engine, datadir, nil, true)
+	if err != nil {
+		return fmt.Errorf("create store: %w", err)
+	}
+	defer func() {
+		if err := s.Close(ctx); err != nil {
+			log.Debugf("close store: %v", err)
+		}
+	}()
+	ev, err := activitystore.NewSqlStore(ctx, datadir, config.DataStoreEncryptionKey)
+	if err != nil {
+		return fmt.Errorf("open the activity store: %w", err)
+	}
+	defer func() {
+		if err := ev.Close(ctx); err != nil {
+			log.Debugf("close activity store: %v", err)
+		}
+	}()
+	return fn(ctx, s, ev)
+}
+
+func fileStem(name string) string {
+	return fileStemSanitizer.ReplaceAllString(strings.ToLower(name), "-")
+}
+
+func pendingNames(name string) (string, string) {
+	stem := fileStem(name)
+	return stem + ".token", stem + ".pat.json"
+}
+
+// bootstrapDir is the pending-token directory, opened once (never through a
+// symlink) and checked by its descriptor, so what is checked is what is
+// written to.
+type bootstrapDir struct{ f *os.File }
+
+func openBootstrapDir(dir string) (*bootstrapDir, error) {
+	if !filepath.IsAbs(dir) {
+		return nil, fmt.Errorf("--dir %s is not an absolute path", dir)
+	}
+	fd, err := unix.Open(dir, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, fmt.Errorf("--dir %s: %w", dir, err)
+	}
+	f := os.NewFile(uintptr(fd), dir)
+	var st unix.Stat_t
+	if err := unix.Fstat(fd, &st); err != nil {
+		_ = f.Close()
+		return nil, fmt.Errorf("--dir %s: %w", dir, err)
+	}
+	if st.Mode&0o777 != 0o700 {
+		_ = f.Close()
+		return nil, fmt.Errorf("--dir %s has mode %o, not 0700", dir, st.Mode&0o777)
+	}
+	if int(st.Uid) != suOwnerUID() {
+		_ = f.Close()
+		return nil, fmt.Errorf("--dir %s is not owned by the user running this command", dir)
+	}
+	if suRequireTmpfs {
+		var fs unix.Statfs_t
+		if err := unix.Fstatfs(fd, &fs); err != nil {
+			_ = f.Close()
+			return nil, fmt.Errorf("--dir %s: %w", dir, err)
+		}
+		if fs.Type != unix.TMPFS_MAGIC {
+			_ = f.Close()
+			return nil, fmt.Errorf("--dir %s is not on tmpfs: a token must not reach a disk", dir)
+		}
+	}
+	return &bootstrapDir{f: f}, nil
+}
+
+func (d *bootstrapDir) Close() { _ = d.f.Close() }
+
+func (d *bootstrapDir) exists(name string) bool {
+	var st unix.Stat_t
+	return unix.Fstatat(int(d.f.Fd()), name, &st, unix.AT_SYMLINK_NOFOLLOW) == nil
+}
+
+// create makes name with O_EXCL, mode 0600, and writes data.
+func (d *bootstrapDir) create(name string, data []byte) error {
+	fd, err := unix.Openat(int(d.f.Fd()), name, unix.O_WRONLY|unix.O_CREAT|unix.O_EXCL|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0o600)
+	if err != nil {
+		return fmt.Errorf("create %s in %s: %w", name, d.f.Name(), err)
+	}
+	f := os.NewFile(uintptr(fd), name)
+	if _, err := f.Write(data); err != nil {
+		_ = f.Close()
+		_ = d.remove(name)
+		return fmt.Errorf("write %s in %s: %w", name, d.f.Name(), err)
+	}
+	if err := f.Close(); err != nil {
+		_ = d.remove(name)
+		return fmt.Errorf("close %s in %s: %w", name, d.f.Name(), err)
+	}
+	return nil
+}
+
+func (d *bootstrapDir) read(name string) ([]byte, error) {
+	fd, err := unix.Openat(int(d.f.Fd()), name, unix.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	f := os.NewFile(uintptr(fd), name)
+	defer f.Close()
+	return io.ReadAll(io.LimitReader(f, suStdinMaxBytes))
+}
+
+func (d *bootstrapDir) remove(name string) error {
+	return unix.Unlinkat(int(d.f.Fd()), name, 0)
+}
+
+func emit(w io.Writer, state, userID, name string) error {
+	return emitStatus(w, suStatus{State: state, UserID: userID, Name: name})
+}
+
+func emitStatus(w io.Writer, st suStatus) error {
+	b, err := json.Marshal(st)
+	if err != nil {
+		return err
+	}
+	_, err = fmt.Fprintln(w, string(b))
+	return err
+}
+
+func soleAccount(ctx context.Context, s store.Store, accountID string) (string, error) {
+	if accountID != "" {
+		if _, err := s.GetAccount(ctx, accountID); err != nil {
+			return "", fmt.Errorf("account %s: %w", accountID, err)
+		}
+		return accountID, nil
+	}
+	accounts := s.GetAllAccounts(ctx)
+	switch len(accounts) {
+	case 0:
+		return "", fmt.Errorf("no account exists yet: the site's bootstrap creates it first")
+	case 1:
+		return accounts[0].Id, nil
+	default:
+		return "", fmt.Errorf("%d accounts present; give --account-id", len(accounts))
+	}
+}
+
+// findServiceUser returns the account's service user by its name (nil when
+// there is none). Its id is random, as NetBird's own, never derived from the
+// name: a derived id could be claimed by a login whose subject is that string.
+func findServiceUser(ctx context.Context, s store.Store, accountID, name string) (*types.User, error) {
+	users, err := s.GetAccountUsers(ctx, store.LockingStrengthNone, accountID)
+	if err != nil {
+		return nil, fmt.Errorf("read the account's users: %w", err)
+	}
+	var found []*types.User
+	for _, u := range users {
+		if u.IsServiceUser && u.ServiceUserName == name {
+			found = append(found, u)
+		}
+	}
+	switch len(found) {
+	case 0:
+		return nil, nil
+	case 1:
+		return found[0], nil
+	default:
+		return nil, fmt.Errorf("the account holds %d service users named %s; nothing was changed", len(found), name)
+	}
+}
+
+func saveEvent(ctx context.Context, ev activity.Store, a activity.Activity, accountID, targetID string, meta map[string]any) error {
+	_, err := ev.Save(ctx, &activity.Event{
+		Timestamp:   time.Now().UTC(),
+		Activity:    a,
+		InitiatorID: activity.SystemInitiator,
+		TargetID:    targetID,
+		AccountID:   accountID,
+		Meta:        meta,
+	})
+	if err != nil {
+		return fmt.Errorf("write the activity event %q: %w", a.Message(), err)
+	}
+	return nil
+}
+
+func runBootstrapUser(ctx context.Context, s store.Store, ev activity.Store, w io.Writer, name, accountID, dir string, expiresInDays int, rotate bool) error {
+	if strings.TrimSpace(name) == "" || strings.Trim(fileStem(name), "-") == "" {
+		return fmt.Errorf("--name is required")
+	}
+	if expiresInDays < suMinDays || expiresInDays > suMaxDays {
+		return fmt.Errorf("--expires-in-days must be between %d and %d", suMinDays, suMaxDays)
+	}
+	d, err := openBootstrapDir(dir)
+	if err != nil {
+		return err
+	}
+	defer d.Close()
+	accountID, err = soleAccount(ctx, s, accountID)
+	if err != nil {
+		return err
+	}
+	tokenName, patName := pendingNames(name)
+
+	// The lookup and, when there is none, the create are one transaction with
+	// the account's row locked, and the lookup is made again inside it: two
+	// runs at once cannot both make a service user of this name.
+	var user *types.User
+	created := false
+	err = s.ExecuteInTransaction(ctx, func(tx store.Store) error {
+		if _, err := tx.GetAccountSettings(ctx, store.LockingStrengthUpdate, accountID); err != nil {
+			return fmt.Errorf("lock the account: %w", err)
+		}
+		u, err := findServiceUser(ctx, tx, accountID, name)
+		if err != nil {
+			return err
+		}
+		if u != nil {
+			user = u
+			return nil
+		}
+		if rotate {
+			return fmt.Errorf("the account has no service user %s to rotate; nothing was changed", name)
+		}
+		if d.exists(tokenName) || d.exists(patName) {
+			return fmt.Errorf("pending files for %s are in %s but the service user does not exist; remove them and run again", name, dir)
+		}
+		u = types.NewUser(uuid.New().String(), types.UserRoleAdmin, true, false, name, []string{}, types.UserIssuedAPI, "", "")
+		u.AccountID = accountID
+		if err := tx.SaveUser(ctx, u); err != nil {
+			return fmt.Errorf("save the service user: %w", err)
+		}
+		user, created = u, true
+		return nil
+	})
+	if err != nil {
+		return err
+	}
+	if created {
+		if err := saveEvent(ctx, ev, activity.ServiceUserCreated, accountID, user.Id, map[string]any{"name": name, "by": "goat standup"}); err != nil {
+			if derr := s.DeleteUser(ctx, accountID, user.Id); derr != nil {
+				return fmt.Errorf("%v; and removing the service user again failed: %w", err, derr)
+			}
+			return err
+		}
+	} else {
+		pats, err := s.GetUserPATs(ctx, store.LockingStrengthNone, user.Id)
+		if err != nil {
+			return fmt.Errorf("read the service user's tokens: %w", err)
+		}
+		switch {
+		case !rotate && len(pats) > 0:
+			// Its token row exists: never a second one. Whether the caller
+			// holds a copy is the caller's check; renewal and recovery are a
+			// rotation, never this command without --rotate.
+			return emit(w, "held", user.Id, name)
+		case rotate && len(pats) != 1:
+			return fmt.Errorf("a rotation starts from exactly one token row; the service user %s holds %d; nothing was changed", name, len(pats))
+		}
+		tok, pat := d.exists(tokenName), d.exists(patName)
+		switch {
+		case tok && pat:
+			return emit(w, "pending", user.Id, name)
+		case tok || pat:
+			return fmt.Errorf("only one of %s and %s is in %s; remove it and run again", tokenName, patName, dir)
+		}
+	}
+
+	gen, err := types.CreateNewPAT(name, expiresInDays, user.Id, user.Id)
+	if err != nil {
+		return fmt.Errorf("generate the token: %w", err)
+	}
+	row := gen.PersonalAccessToken
+	row.UserID = user.Id
+	pat, err := json.Marshal(&row)
+	if err != nil {
+		return fmt.Errorf("encode the pending token row: %w", err)
+	}
+	if err := d.create(tokenName, []byte(gen.PlainToken)); err != nil {
+		return err
+	}
+	if err := d.create(patName, pat); err != nil {
+		_ = d.remove(tokenName)
+		return err
+	}
+	return emit(w, "pending", user.Id, name)
+}
+
+func runBootstrapTokenInstall(ctx context.Context, s store.Store, ev activity.Store, in io.Reader, w io.Writer, name, accountID, dir string, rotate bool) error {
+	if strings.TrimSpace(name) == "" || strings.Trim(fileStem(name), "-") == "" {
+		return fmt.Errorf("--name is required")
+	}
+	d, err := openBootstrapDir(dir)
+	if err != nil {
+		return err
+	}
+	defer d.Close()
+	accountID, err = soleAccount(ctx, s, accountID)
+	if err != nil {
+		return err
+	}
+	user, err := findServiceUser(ctx, s, accountID, name)
+	if err != nil {
+		return err
+	}
+	if user == nil {
+		return fmt.Errorf("the account has no service user %s: run bootstrap-user first", name)
+	}
+	tokenName, patName := pendingNames(name)
+	plain, err := d.read(tokenName)
+	if err != nil {
+		return fmt.Errorf("no pending token %s in %s: run bootstrap-user first", tokenName, dir)
+	}
+	raw, err := d.read(patName)
+	if err != nil {
+		return fmt.Errorf("no pending token row %s in %s: run bootstrap-user first", patName, dir)
+	}
+	var pat types.PersonalAccessToken
+	if err := json.Unmarshal(raw, &pat); err != nil {
+		return fmt.Errorf("the pending token row %s in %s cannot be read", patName, dir)
+	}
+	stored, err := io.ReadAll(io.LimitReader(in, suStdinMaxBytes))
+	if err != nil {
+		return fmt.Errorf("read the stored value on stdin: %w", err)
+	}
+	stored = []byte(strings.TrimRight(string(stored), "\r\n"))
+	if len(stored) == 0 || subtle.ConstantTimeCompare(stored, plain) != 1 {
+		return fmt.Errorf("the value on stdin is not the pending token: the store did not keep what was written; no token was switched on")
+	}
+	sum := sha256.Sum256(plain)
+	now := time.Now().UTC()
+	if pat.UserID != user.Id || pat.Name != name || pat.HashedToken != b64.StdEncoding.EncodeToString(sum[:]) ||
+		pat.ExpirationDate == nil || !pat.ExpirationDate.After(now.Add(suMinDays*24*time.Hour-time.Hour)) ||
+		pat.ExpirationDate.After(now.Add(suMaxDays*24*time.Hour+time.Hour)) {
+		return fmt.Errorf("the pending token row does not belong to the pending token, or its expiry is out of bounds; remove both pending files and run bootstrap-user again")
+	}
+	// The check of what the service user holds and the save are one
+	// transaction, the user's row locked first: two installs at once cannot
+	// both save. Outside a rotation it holds none; in a rotation exactly the
+	// one old row, which stays valid until revoke --token-id removes it.
+	var oldID string
+	err = s.ExecuteInTransaction(ctx, func(tx store.Store) error {
+		if _, err := tx.GetUserByUserID(ctx, store.LockingStrengthUpdate, user.Id); err != nil {
+			return fmt.Errorf("lock the service user: %w", err)
+		}
+		pats, err := tx.GetUserPATs(ctx, store.LockingStrengthUpdate, user.Id)
+		if err != nil {
+			return fmt.Errorf("read the service user's tokens: %w", err)
+		}
+		switch {
+		case !rotate && len(pats) > 0:
+			return fmt.Errorf("the service user %s already holds a token; nothing was changed", name)
+		case rotate && len(pats) != 1:
+			return fmt.Errorf("a rotation installs beside exactly one token row; the service user %s holds %d; nothing was changed", name, len(pats))
+		case rotate && pats[0].ID == pat.ID:
+			return fmt.Errorf("the pending token is already installed; nothing was changed")
+		case rotate:
+			oldID = pats[0].ID
+		}
+		if err := tx.SavePAT(ctx, &pat); err != nil {
+			return fmt.Errorf("save the token: %w", err)
+		}
+		return nil
+	})
+	if err != nil {
+		return err
+	}
+	if err := saveEvent(ctx, ev, activity.PersonalAccessTokenCreated, accountID, user.Id, map[string]any{"name": pat.Name, "user_name": name, "is_service_user": true, "by": "goat standup"}); err != nil {
+		if derr := s.DeletePAT(ctx, user.Id, pat.ID); derr != nil {
+			return fmt.Errorf("%v; and removing the token again failed: %w", err, derr)
+		}
+		return err
+	}
+	rmErr := errors.Join(d.remove(tokenName), d.remove(patName))
+	if err := emitStatus(w, suStatus{State: "installed", UserID: user.Id, Name: name, TokenID: pat.ID, OldTokenID: oldID}); err != nil {
+		return err
+	}
+	if rmErr != nil {
+		return fmt.Errorf("the token is switched on, and removing the pending files failed: %w", rmErr)
+	}
+	return nil
+}
+
+func runBootstrapTokenRevoke(ctx context.Context, s store.Store, ev activity.Store, w io.Writer, name, accountID, tokenID string) error {
+	if strings.TrimSpace(name) == "" {
+		return fmt.Errorf("--name is required")
+	}
+	if strings.TrimSpace(tokenID) == "" {
+		return fmt.Errorf("--token-id is required")
+	}
+	accountID, err := soleAccount(ctx, s, accountID)
+	if err != nil {
+		return err
+	}
+	user, err := findServiceUser(ctx, s, accountID, name)
+	if err != nil {
+		return err
+	}
+	if user == nil {
+		return fmt.Errorf("the account has no service user %s", name)
+	}
+	pats, err := s.GetUserPATs(ctx, store.LockingStrengthNone, user.Id)
+	if err != nil {
+		return fmt.Errorf("read the service user's tokens: %w", err)
+	}
+	var target *types.PersonalAccessToken
+	for _, p := range pats {
+		if p.ID == tokenID {
+			target = p
+		}
+	}
+	if target == nil {
+		return fmt.Errorf("the service user %s holds no token row %s; nothing was changed", name, tokenID)
+	}
+	if len(pats) < 2 {
+		return fmt.Errorf("token row %s is the service user's only one; a rotation installs the new one first; nothing was changed", tokenID)
+	}
+	if err := s.DeletePAT(ctx, user.Id, target.ID); err != nil {
+		return fmt.Errorf("delete token %s: %w", target.ID, err)
+	}
+	if err := saveEvent(ctx, ev, activity.PersonalAccessTokenDeleted, accountID, user.Id, map[string]any{"name": target.Name, "user_name": name, "is_service_user": true, "by": "goat bootstrap-token-revoke"}); err != nil {
+		target.UserID = user.Id
+		if serr := s.SavePAT(ctx, target); serr != nil {
+			return fmt.Errorf("%v; and restoring the token failed: %w", err, serr)
+		}
+		return err
+	}
+	return emitStatus(w, suStatus{State: "revoked", UserID: user.Id, Name: name, TokenID: target.ID})
+}
