+func TestServiceUserReRunMintsNoSecondToken(t *testing.T) {
+	f := newSUFixture(t)
+	var out bytes.Buffer
+	require.NoError(t, f.user(t, &out))
+	plain := f.plain(t)
+	require.NoError(t, f.install(t, plain, &out))
+	before := f.events(t)
+
+	out.Reset()
+	require.NoError(t, f.user(t, &out))
+	require.Equal(t, "held", state(t, &out))
+	require.Len(t, f.pats(t), 1)
+	tok, pat := f.pending(t)
+	require.NoFileExists(t, tok)
+	require.NoFileExists(t, pat)
+	require.Equal(t, before, f.events(t))
+
+	// A second install has nothing to switch on and never adds a row.
+	require.Error(t, f.install(t, plain, &out))
+	require.Len(t, f.pats(t), 1)
+}
