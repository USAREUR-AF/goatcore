@@ -40,6 +40,14 @@ func OpenConn(ctx context.Context, dataDir string, mainEngine db.Engine) (*db.Co
 	if err != nil {
 		return nil, err
 	}
+	// NETBIRD_SKIP_MIGRATIONS gates schema changes on a Postgres access log store, which
+	// shares the main database under multi-master replication: each site migrates once,
+	// deliberately, rather than on every start. A SQLite access log store is per node and
+	// still needs its schema created on a fresh node, so the skip does not apply there.
+	if os.Getenv("NETBIRD_SKIP_MIGRATIONS") == "true" && engine == db.PostgresStoreEngine {
+		log.WithContext(ctx).Info("NETBIRD_SKIP_MIGRATIONS=true and access log store engine is Postgres; skipping access log AutoMigrate")
+		return conn, nil
+	}
 	if err := conn.AutoMigrate(&accesslogs.AccessLogEntry{}); err != nil {
 		_ = conn.Close()
 		return nil, fmt.Errorf("migrate access log store: %w", err)
