# zenoh-pqc-fips router image — the FIPS variant of the zenoh-pqc image
# (docs/design/zenoh-pqc-tls.md §5). Differences vs Dockerfile (non-FIPS):
#
#   1. zenohd builds against the aws-lc-rs FIPS backend on the AWS-LC FIPS
#      4.0.0 module that CMVP #5596 (static) / #5595 (dynamic) validate, with
#      ML-KEM-512/768/1024 approved in-boundary (ADR 1265, amending ADR 1079).
#      The module is built HERE from the exact source set the certificate's
#      security policy (section 11.1) names: the aws/aws-lc archive of commit
#      AWS_LC_FIPS_COMMIT, checked against the policy's SHA2-256 digest, built
#      with the policy's options (-DFIPS=1 -DCMAKE_BUILD_TYPE=RelWithDebInfo),
#      gated on `bssl isfips` = 1 and on the version string "AWS-LC FIPS 4.0.0"
#      in the linked binaries. aws-lc-fips-sys then LINKS that install
#      (AWS_LC_FIPS_SYS_SYSTEM_DIR) instead of compiling its own bundled copy:
#      no published aws-lc-fips-sys vendors the validated source set (0.14.0
#      vendors a later 4.x snapshot, 0.14.2+ vendor 4.2.0), and the source set
#      on the certificate is what the claim hangs on. Do NOT float any of the
#      AWS_LC_FIPS_* values; they move together, only to a newer validated
#      module, by an ADR.
#      COUPLED PIN: aws-lc-rs and aws-lc-fips-sys move as a PAIR (each
#      aws-lc-rs release floors its aws-lc-fips-sys requirement and calls its
#      API). Both are held exactly with fail-closed lock asserts below.
#      rustls and rustls-webpki move to their newest compatible releases, with
#      asserted floors: nothing holds them back any more.
#   2. glibc, not musl. The FIPS module build (cmake + Go + Perl, delocated
#      shared objects) does not fit the alpine/musl shape, so the runtime is
#      debian:bookworm-slim and the upstream image cannot be reused. That
#      re-opens the plugin story as a MATCHED-PAIR build (the ADR 0858 cost
#      the non-FIPS image avoids): rest + storage_manager + the rocksdb
#      backend are all built here from the same tag + toolchain. zenohd still
#      refuses mismatched plugins at startup — fail-closed, CI-smoked.
#   3. Build-time verification gate: fips-probe/ asserts the module enters
#      FIPS mode and X25519MLKEM768 is offered (fips=true, preferred) and
#      negotiates, before the image can exist. The CI smoke re-asserts it
#      live against the booted zenohd (fips-probe --connect).
#
# Plugin paths: libzenoh_plugin_rest.so + libzenoh_plugin_storage_manager.so
# at / (upstream image convention, drop-in for search_dirs), the rocksdb
# backend at /opt/zenoh/plugins-baked/ — deliberately NOT /opt/zenoh/plugins,
# which the ansible roles bind-mount with the upstream MUSL backend .so; a
# glibc zenohd cannot load that, so at adoption time the role must point
# backend_search_dirs at the baked path instead of bind-mounting (recorded in
# zenoh-pqc-tls-implementation.md).
#
# Vocabulary discipline (§5): this image is "built on the CMVP #5596-validated
# module" — a FIPS 140-3 *claim* additionally needs the compliance-package
# language (tested OEs are Amazon Linux 2023; our hosts ride user-affirmation).

ARG ZENOH_TAG=1.10.2
ARG ROCKSDB_BACKEND_TAG=1.10.2
# The validated module source set (CMVP #5595/#5596 security policy, section
# 11.1): archive of this aws/aws-lc commit, and the archive's SHA2-256 digest
# as the policy prints it. AWS_LC_FIPS_MODULE_VERSION is the version string
# the policy says the module reports.
ARG AWS_LC_FIPS_COMMIT=1276fc7d9cd0f509000294e9657914c3a23e65d2
ARG AWS_LC_FIPS_ZIP_SHA256=33b5443d2213bfca45071b300daeb45decf13e3b46f726890b48d6267968f049
ARG AWS_LC_FIPS_MODULE_VERSION=4.0.0
# The Rust side: aws-lc-fips-sys links the module above, aws-lc-rs is the newest
# release whose aws-lc-fips-sys floor (^0.14.2) accepts it. Bump both together.
ARG AWS_LC_FIPS_SYS_VERSION=0.14.4
ARG AWS_LC_RS_VERSION=1.19.0
# Generates the Rust bindings for the self-built module (the commit predates
# AWS-LC's own GENERATE_RUST_BINDINGS option).
ARG BINDGEN_CLI_VERSION=0.72.1

# Go toolchain for the FIPS module build (bookworm's packaged Go is too old).
FROM golang:1.24-bookworm AS gosrc

FROM rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
      cmake perl clang libclang-dev git ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*
COPY --from=gosrc /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH

ARG BINDGEN_CLI_VERSION
RUN cargo install --locked bindgen-cli --version ${BINDGEN_CLI_VERSION}

# The validated AWS-LC FIPS module, built from the exact source set its
# security policy names (note 1). Each step is fail-closed: a digest that
# differs from the policy's, a version string other than the certificate's,
# or `bssl isfips` other than 1 aborts the image. The policy forbids
# additions, deletions or alterations to the archive's files, so nothing is
# patched; BUILD_TESTING=OFF only skips the test binaries.
ARG AWS_LC_FIPS_COMMIT
ARG AWS_LC_FIPS_ZIP_SHA256
ARG AWS_LC_FIPS_MODULE_VERSION
RUN curl -fsSL -o /tmp/aws-lc.zip \
      "https://github.com/aws/aws-lc/archive/${AWS_LC_FIPS_COMMIT}.zip" \
    && echo "${AWS_LC_FIPS_ZIP_SHA256}  /tmp/aws-lc.zip" | sha256sum -c - \
    && unzip -q /tmp/aws-lc.zip -d /src \
    && mv "/src/aws-lc-${AWS_LC_FIPS_COMMIT}" /src/aws-lc \
    && rm /tmp/aws-lc.zip \
    && grep -qxF "#define AWSLC_VERSION_NUMBER_STRING \"${AWS_LC_FIPS_MODULE_VERSION}\"" \
         /src/aws-lc/include/openssl/base.h \
    && cmake -S /src/aws-lc -B /src/aws-lc/build \
         -DFIPS=1 -DCMAKE_BUILD_TYPE=RelWithDebInfo \
         -DBUILD_TESTING=OFF -DCMAKE_INSTALL_PREFIX=/opt/aws-lc-fips \
    && cmake --build /src/aws-lc/build -j"$(nproc)" \
    && test "$(/src/aws-lc/build/tool/bssl isfips)" = "1" \
    && cmake --install /src/aws-lc/build

# Rust bindings for that install, generated the way AWS-LC's own
# GENERATE_RUST_BINDINGS option (added after this commit) generates them;
# rust_wrapper.h is the crypto header list aws-lc-fips-sys itself binds.
COPY aws-lc-fips/rust_wrapper.h /src/aws-lc-fips/rust_wrapper.h
RUN mkdir -p /opt/aws-lc-fips/share/rust \
    && bindgen /src/aws-lc-fips/rust_wrapper.h \
         --allowlist-file '.*(/|\\)openssl((/|\\)[^/\\]+)+\.h' \
         --allowlist-file '.*(/|\\)rust_wrapper\.h' \
         --rustified-enum point_conversion_form_t \
         --default-macro-constant-type signed \
         --with-derive-default --with-derive-partialeq --with-derive-eq \
         --generate functions,types,vars,methods,constructors,destructors \
         --rust-target 1.70 --formatter prettyplease \
         --output /opt/aws-lc-fips/share/rust/aws_lc_bindings.rs \
         -- -I/opt/aws-lc-fips/include \
    && grep -q 'pub fn awslc_version_string' /opt/aws-lc-fips/share/rust/aws_lc_bindings.rs

# aws-lc-fips-sys links the install above instead of building its bundled
# source; the non-FIPS aws-lc-sys (pulled in by other crates) keeps building
# its own copy and never adopts the FIPS install.
ENV AWS_LC_FIPS_SYS_SYSTEM_DIR=/opt/aws-lc-fips \
    AWS_LC_FIPS_SYS_STATIC=1 \
    AWS_LC_SYS_USE_SYSTEM=0

ARG ZENOH_TAG
ARG AWS_LC_FIPS_SYS_VERSION
ARG AWS_LC_RS_VERSION
RUN git clone --depth 1 --branch ${ZENOH_TAG} \
    https://github.com/eclipse-zenoh/zenoh.git /src/zenoh

COPY patches/zenohd-fips-aws-lc-fips.patch /tmp/
# cargo fetch first: the tag's Cargo.lock predates the patch, so the new
# aws-lc-fips-sys dep isn't in it yet and a bare `cargo update -p` errors
# with "did not match any packages"; fetch syncs the lock minimally.
# aws-lc-rs is pinned before aws-lc-fips-sys because each aws-lc-rs release
# floors its aws-lc-fips-sys requirement. The grep-asserts are fail-closed: a
# resolution that lands on any other version aborts the build.
# bindgen (a build-dependency of aws-lc-fips-sys, ^0.73) is held at 0.73.0:
# 0.73.1+ accept syn 2 or 3 and prettyplease 0.2 or 0.3, and zenoh's lock
# already carries syn 3.0.6 and prettyplease 0.2.37 (for prost-build), so they
# resolve to syn 3 with a syn-2 prettyplease and fail to compile. 0.73.0
# requires syn 3 with prettyplease 0.3, a consistent pair.
# rustls and rustls-webpki move to their newest semver-compatible releases:
# zenoh 1.10.2's lock carries rustls 0.23.45 and rustls-webpki 0.103.15, older
# than the fixes for RUSTSEC-2026-0346 to -0349 (0.23.46) and RUSTSEC-2026-0382
# (0.103.16). The floors are asserted.
RUN cd /src/zenoh && git apply /tmp/zenohd-fips-aws-lc-fips.patch \
    && cargo fetch \
    && cargo update --package aws-lc-rs --precise ${AWS_LC_RS_VERSION} \
    && cargo update --package aws-lc-fips-sys --precise ${AWS_LC_FIPS_SYS_VERSION} \
    && cargo update --package bindgen --precise 0.73.0 \
    && cargo update --package rustls --package rustls-webpki \
    && grep -A1 'name = "bindgen"' Cargo.lock | grep -qx 'version = "0.73.0"' \
    && grep -A1 'name = "aws-lc-rs"' Cargo.lock \
    && grep -A1 'name = "aws-lc-fips-sys"' Cargo.lock \
    && grep -A1 'name = "rustls"' Cargo.lock \
    && grep -A1 'name = "rustls-webpki"' Cargo.lock \
    && grep -A1 'name = "aws-lc-rs"' Cargo.lock | grep -qx "version = \"${AWS_LC_RS_VERSION}\"" \
    && grep -A1 'name = "aws-lc-fips-sys"' Cargo.lock | grep -qx "version = \"${AWS_LC_FIPS_SYS_VERSION}\"" \
    && v=$(grep -A1 '^name = "rustls"$' Cargo.lock | sed -n 's/^version = "\(.*\)"/\1/p') \
    && test "$(printf '%s\n' 0.23.46 "$v" | sort -V | head -1)" = 0.23.46 \
    && v=$(grep -A1 '^name = "rustls-webpki"$' Cargo.lock | sed -n 's/^version = "\(.*\)"/\1/p') \
    && test "$(printf '%s\n' 0.103.16 "$v" | sort -V | head -1)" = 0.103.16

# goat F-253: throttle the TLS accept loop only on genuine listener-level (fd)
# errors, not per-connection handshake failures — the unconditional 100ms
# throttle serialized admission to ~10 opens/s under a reconnect storm.
COPY patches/zenohd-f253-accept-throttle.patch /tmp/
RUN cd /src/zenoh && git apply /tmp/zenohd-f253-accept-throttle.patch

# goat fabric-wedge fix #1 — storage-manager adminspace_getter
# deadlock (upstream issue #1094, open). The admin handler `adminspace_getter`
# held the one global std::sync::Mutex<StorageRuntimeInner> across a
# block_in_place GetStatus round-trip to every ~1000 storage, deadlocking under
# concurrent admin walks + real peer traffic + worker pressure. This patch
# snapshots the storage senders under the lock, drops the guard, then does the
# blocking fan-out lock-free. Touches the storage-manager plugin crate.
# Load-tested.
COPY patches/zenohd-adminspace-getter-deadlock.patch /tmp/
RUN cd /src/zenoh && git apply /tmp/zenohd-adminspace-getter-deadlock.patch

# Upstream #2635 (querier/session deadlock) ships in 1.10.0; its backport was dropped at the 1.10.2 bump.

# goat fabric-wedge fix #3 — admin-space reply under the tables lock.
# `resources_data` (subscriber/publisher/queryable/querier/token census),
# `linkstate_data` and the `route_successor` shortcut held the routing
# `tables` read guard while sending each reply; the reply path
# (`route_send_response`, the egress ACL's `MuxContext::prefix`) takes that
# guard for read again. std's RwLock blocks a new reader behind a queued
# writer, so a declaration arriving mid-walk deadlocks the router: one
# `send_declare` writer, a reader inside `resources_data`, the rest queued.
# Admin walks + declaration churn together wedge it within a minute; either
# alone does not. On a bare router the gate
# ops/zenoh/wedge-repro/ci-adminspace-deadlock.sh wedged the unpatched image
# 3/3 (15-17 s) and the patched image answered 3/3 for 90 s.
# The patch builds the replies under the guard and sends after it drops.
COPY patches/zenohd-adminspace-reply-under-tables-lock.patch /tmp/
RUN cd /src/zenoh && git apply /tmp/zenohd-adminspace-reply-under-tables-lock.patch
# Finding F-614: zenoh-link-tls shares one TLS stream between its read and
# write tasks through an UnsafeCell. This keeps the stream behind a per-poll
# Mutex instead, the same change goatcore's vendor/zenoh-link-tls carries for
# the client workspaces. Drop it when a zenoh release ships the fix.
COPY patches/zenohd-link-tls-stream-mutex.patch /tmp/
RUN cd /src/zenoh && git apply /tmp/zenohd-link-tls-stream-mutex.patch

# Matched-pair build: router binary + both plugin cdylibs, one toolchain,
# one workspace, one lockfile.
RUN cd /src/zenoh && cargo build --release \
      -p zenohd -p zenoh-plugin-rest -p zenoh-plugin-storage-manager

# Collect FIPS shared objects if the module linked dynamically (macOS always
# does; Linux aws-lc-fips-sys links the module STATICALLY by default, so an
# empty dir here is normal) and prove zenohd runs — `--version` aborts if a
# needed .so is missing, which is the real assert.
RUN mkdir -p /out/fips-libs \
    && find /src/zenoh/target/release/build -name 'libaws_lc_fips_*.so' \
         -exec cp {} /out/fips-libs/ \; \
    && ls -la /out/fips-libs/ \
    && LD_LIBRARY_PATH=/out/fips-libs /src/zenoh/target/release/zenohd --version

# The router carries exactly one AWS-LC FIPS module and it is the validated
# one: the only "AWS-LC FIPS <version>" string in the binary (the module's
# show-version service, security policy section 11.1) is the certificate's.
# A bundled aws-lc-fips-sys build would show its own 4.x version here.
RUN found="$(grep -aoE 'AWS-LC FIPS [0-9]+\.[0-9]+\.[0-9]+' /src/zenoh/target/release/zenohd | sort -u)" \
    && echo "module in zenohd: ${found}" \
    && test "${found}" = "AWS-LC FIPS ${AWS_LC_FIPS_MODULE_VERSION}"

# rocksdb storage backend, same tag, same toolchain (glibc matched pair for
# the .so the musl upstream release cannot provide here).
ARG ROCKSDB_BACKEND_TAG
RUN git clone --depth 1 --branch ${ROCKSDB_BACKEND_TAG} \
    https://github.com/eclipse-zenoh/zenoh-backend-rocksdb.git /src/rocksdb-backend
# Matched-pair feature record: the zenoh workspace pins zenoh_backend_traits
# with default-features = false, so the host storage_manager's compat record
# has no `zenoh-backend-traits/default` token — but the rocksdb repo's dep
# enables defaults, and zenohd refuses the mismatched record at load
# (`default` is only a passthrough to zenoh/default, which both sides already
# carry via their direct zenoh dep — the code is identical, only the record
# token differs). Align the dep, fail loudly if the manifest shape moved.
RUN cd /src/rocksdb-backend \
    && sed -i "s|zenoh_backend_traits = { version = \"${ROCKSDB_BACKEND_TAG}\"}|zenoh_backend_traits = { version = \"${ROCKSDB_BACKEND_TAG}\", default-features = false }|" Cargo.toml \
    && grep -q 'default-features = false' Cargo.toml \
    && cargo build --release \
    && ls target/release/libzenoh_backend_rocksdb.so

# Build-time FIPS-PQC verification gate — the image cannot exist unless the
# pinned module enters FIPS mode and X25519MLKEM768 is offered + negotiates.
COPY fips-probe /src/fips-probe
RUN cd /src/fips-probe && cargo build --release \
    && found="$(grep -aoE 'AWS-LC FIPS [0-9]+\.[0-9]+\.[0-9]+' ./target/release/fips-probe | sort -u)" \
    && echo "module in fips-probe: ${found}" \
    && test "${found}" = "AWS-LC FIPS ${AWS_LC_FIPS_MODULE_VERSION}" \
    && LD_LIBRARY_PATH=/out/fips-libs ./target/release/fips-probe

FROM debian:bookworm-slim AS runtime

# wget: the fleet's compose healthcheck probes the REST plugin with wget
# (the upstream alpine image ships busybox wget; bookworm-slim ships neither
# (the upstream alpine image ships busybox wget; bookworm-slim ships neither
# wget nor curl, and without one the healthcheck reads unhealthy on a healthy router).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/fips-libs/ /usr/local/lib/
RUN ldconfig
COPY --from=builder /src/zenoh/target/release/zenohd /zenohd
COPY --from=builder /src/zenoh/target/release/libzenoh_plugin_rest.so /
COPY --from=builder /src/zenoh/target/release/libzenoh_plugin_storage_manager.so /
COPY --from=builder /src/rocksdb-backend/target/release/libzenoh_backend_rocksdb.so /opt/zenoh/plugins-baked/

EXPOSE 7447
ENTRYPOINT ["/zenohd"]

# Sidecar stage for CI (and operators): the probe with the same FIPS libs, to
# assert a LIVE listener negotiates X25519MLKEM768.
#   docker run --network host <img-probe> --connect 127.0.0.1:7447 <sni> <ca.pem>
FROM debian:bookworm-slim AS probe
COPY --from=builder /out/fips-libs/ /usr/local/lib/
RUN ldconfig
COPY --from=builder /src/fips-probe/target/release/fips-probe /usr/local/bin/fips-probe
ENTRYPOINT ["fips-probe"]
