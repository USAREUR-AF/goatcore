#!/usr/bin/env bash
# with-secrets — run ONE command with the declared secrets posture's values in its environment.
#
# The posture (ADR 1204) is the team's choice of where deploy secrets live; it is
# declared once, as `secrets: store:` in ops/goatbuilder/goatbuilder.yaml, and
# GOAT_SECRET_STORE overrides it per command. goat's own posture is references
# only (ADR 1186): NAME=op://vault/item/field lines in .envrc.local.d/*.refs,
# resolved per command so values never reach the shell, a file or argv. A team
# adopting goat may declare a simpler store and owns that trade.
#
#   ops/scripts/with-secrets terraform plan
#   ops/scripts/with-secrets ./ops/scripts/deploy-component.sh ...
#
# ansible-preflight.sh calls this itself; Ansible commands need no prefix.
#
# Stores (docs/design/pluggable-dependencies.md, secret-store-requirements.md):
#   1password            references: op:// by `op run`, bao:// by ops/secrets/openbao/run,
#   openbao              bw:// by ops/secrets/vaultwarden/run — all in one file and one
#   vaultwarden          command (one grammar, ADR 1204; the Vaultwarden store is ADR 1212)
#   custom               references -> $GOAT_SECRET_RUN <cmd>  e.g. "bws run --"
#   sops                 values decrypted from $GOAT_SECRET_SOPS_FILE for this command
#   git-crypt            values from the unlocked $GOAT_SECRET_GITCRYPT_FILE
#   env-file (default)   values from the gitignored 0600 $GOAT_SECRET_ENV_FILE (plaintext)
#   env                  values already exported; nothing is resolved
#   <name>               any other store with an executable ops/secrets/<name>/run
#   GOAT_SECRET_REF_PREFIX  what a reference starts with (op://, bao:// or bw://)
# A references posture with no reference in the environment runs the command unchanged.
#
# A live secrets session (ops/scripts/secrets-session, docs/design/secrets-session.md)
# is used first: its token, read from the keychain, is handed to that store's
# injector only (OP_SERVICE_ACCOUNT_TOKEN / BAO_TOKEN / BW_SESSION) and removed
# before the command runs. No session, or an expired one: the usual path.
# GOAT_SECRETS_SESSION=0 ignores any session for this command.
set -euo pipefail

[ $# -gt 0 ] || { echo "usage: with-secrets <command> [args...]" >&2; exit 2; }
[ -n "${GOAT_SECRETS_RESOLVED:-}" ] && exec "$@"

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
POSTURE="$HERE/../secrets/posture.py"
store="${GOAT_SECRET_STORE:-}"
if [ -z "$store" ]; then
  # posture.py owns the default (ADR 1204). If it cannot answer, nothing here can
  # say which store this checkout declares, so refuse rather than guess one.
  store="$(python3 "$POSTURE" store 2>/dev/null)" || { echo "with-secrets: $POSTURE did not answer, so the declared store is unknown. Is python3 installed?" >&2; exit 2; }
fi

# References posture: one grammar, scheme-dispatched. Each scheme present in the
# environment is resolved by its own store, chained, and each injector touches only
# its own references: op:// by `op run`, bao:// by ops/secrets/openbao/run, bw:// by
# ops/secrets/vaultwarden/run (the Bitwarden CLI decrypts on this device, ADR 1212).
if [ "$store" = 1password ] || [ "$store" = openbao ] || [ "$store" = vaultwarden ]; then
  env_now="$(env)"
  has_op=0; has_bao=0; has_bw=0
  if [ -n "${GOAT_SECRET_REF_PREFIX:-}" ]; then
    case "$GOAT_SECRET_REF_PREFIX" in
      bao://*) [[ "$env_now" == *"=bao://"* ]] && has_bao=1 ;;
      bw://*)  [[ "$env_now" == *"=bw://"* ]] && has_bw=1 ;;
      *)       [[ "$env_now" == *"=${GOAT_SECRET_REF_PREFIX}"* ]] && has_op=1 ;;
    esac
  else
    [[ "$env_now" == *"=op://"* ]] && has_op=1
    [[ "$env_now" == *"=bao://"* ]] && has_bao=1
    [[ "$env_now" == *"=bw://"* ]] && has_bw=1
  fi
  unset env_now
  [ "$has_op$has_bao$has_bw" = 000 ] && exec "$@"
  export GOAT_SECRETS_RESOLVED=1
  chain=()
  # A live session's token for <store> on stdout, or nothing (no session, expired,
  # no keychain, sessions switched off). Never argv, never a file.
  session_token() {
    [ "${GOAT_SECRETS_SESSION:-1}" = 0 ] && return 1
    python3 "$HERE/secrets-session" token "$1" 2>/dev/null
  }
  session_vars=()
  op_session=0
  if [ "$has_op" = 1 ]; then
    command -v op >/dev/null 2>&1 || {
      echo "with-secrets: op:// references need the 1Password CLI (op) — see goat-credentials team-secrets-1password.md §2, or declare another store (docs/design/pluggable-dependencies.md)" >&2
      exit 127; }
    if tok="$(session_token 1password)"; then
      # A service account names no account and prompts for nothing.
      export OP_SERVICE_ACCOUNT_TOKEN="$tok"; unset OP_ACCOUNT tok
      session_vars+=(OP_SERVICE_ACCOUNT_TOKEN)
      op_session=1
    fi
  fi
  if [ "$has_op" = 1 ] && [ "$op_session" = 0 ]; then
    # Pin the account before `op run` so it can never fan out a prompt across every
    # configured account. posture.py resolves OP_ACCOUNT (env) or the declared
    # `secrets: op_account:`, and exits 3 (message on stderr) when neither is set and
    # more than one account is configured — the one case that is fail-closed. Any
    # other non-zero (posture.py not on this checkout, python absent) is tolerated and
    # the command runs unpinned, exactly as the `store` lookup above falls back.
    set +e
    op_account="$(python3 "$POSTURE" op-account 2>/dev/null)"
    op_account_rc=$?
    set -e
    if [ "$op_account_rc" = 3 ]; then
      python3 "$POSTURE" op-account >/dev/null || true   # re-emit the detailed refusal to stderr
      echo "with-secrets: refusing to run — op would prompt across every 1Password account." >&2
      exit 3
    fi
    [ -n "$op_account" ] && export OP_ACCOUNT="$op_account"
    chain+=(op run --)
  fi
  [ "$op_session" = 1 ] && chain+=(op run --)
  if [ "$has_bao" = 1 ]; then
    bao_run="$HERE/../secrets/openbao/run"
    [ -x "$bao_run" ] || { echo "with-secrets: bao:// references need the OpenBao store's injector, ops/secrets/openbao/run (ADR 1203), which is not on this checkout" >&2; exit 127; }
    if tok="$(session_token openbao)"; then
      export BAO_TOKEN="$tok"; unset tok; session_vars+=(BAO_TOKEN)
    fi
    chain+=("$bao_run" --)
  fi
  if [ "$has_bw" = 1 ]; then
    bw_run="$HERE/../secrets/vaultwarden/run"
    [ -x "$bw_run" ] || { echo "with-secrets: bw:// references need the Vaultwarden store's injector, ops/secrets/vaultwarden/run (ADR 1212), which is not on this checkout" >&2; exit 127; }
    if tok="$(session_token vaultwarden)"; then
      export BW_SESSION="$tok"; unset tok; session_vars+=(BW_SESSION)
    fi
    chain+=("$bw_run" --)
  fi
  # The session's tokens are for the injectors; the command itself does not get them.
  if [ "${#session_vars[@]}" -gt 0 ]; then
    unset_args=()
    for v in "${session_vars[@]}"; do unset_args+=(-u "$v"); done
    chain+=(env "${unset_args[@]}")
  fi
  exec "${chain[@]}" "$@"
fi

case "$store" in
  custom)
    prefix="${GOAT_SECRET_REF_PREFIX:-op://}"
    [[ "$(env)" == *"=${prefix}"* ]] || exec "$@"
    ;;
esac
export GOAT_SECRETS_RESOLVED=1

case "$store" in
  custom)
    [ -n "${GOAT_SECRET_RUN:-}" ] || { echo "with-secrets: GOAT_SECRET_STORE=custom needs GOAT_SECRET_RUN" >&2; exit 2; }
    read -r -a runner <<<"$GOAT_SECRET_RUN"
    exec "${runner[@]}" "$@"
    ;;
  sops|git-crypt|env-file)
    exec python3 "$POSTURE" exec -- "$@"
    ;;
  env)
    exec "$@"
    ;;
  *)
    run="$HERE/../secrets/$store/run"
    [ -x "$run" ] || {
      echo "with-secrets: unknown GOAT_SECRET_STORE='${store}' (1password | openbao | vaultwarden | custom | sops | git-crypt | env-file | env, or a store with ops/secrets/<name>/run)" >&2
      exit 2; }
    exec "$run" -- "$@"
    ;;
esac
