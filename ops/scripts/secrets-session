#!/usr/bin/env python3
"""secrets-session — one approval that lets with-secrets resolve references for up to 24 hours.

    ops/scripts/secrets-session start [--store S]... [--hours N]   (default 24, at most 24)
    ops/scripts/secrets-session status
    ops/scripts/secrets-session end [--store S]...                (default: every store)

Stores: 1password, openbao, vaultwarden. `start` with no --store starts the
declared store (ops/secrets/posture.py store).

  1password    reads a read-only service account token from stdin (or a hidden
               prompt), checks it with `op whoami`, keeps it in the keychain.
               with-secrets exports it as OP_SERVICE_ACCOUNT_TOKEN, so `op run`
               needs no desktop approval.
  openbao      mints a child token of the current login (`bao token create`,
               ttl = N hours, capped by the login's own remaining ttl) and keeps
               it in the keychain; with-secrets exports it as BAO_TOKEN.
               `end` revokes it.
  vaultwarden  keeps a `bw unlock` session key (BW_SESSION from the environment,
               else from `bw unlock --raw`, which the person types the master
               password to) in the keychain; with-secrets exports it as
               BW_SESSION. `end` and expiry run `bw lock`.

The token lives in the macOS login keychain (ADR 1186: no value in a file),
written through `security -i` on stdin so it is never in argv, and never
printed. Where `security` is absent, `start` refuses; there is no file fallback.

`token <store>` is with-secrets' read: it prints the token of a LIVE session to
stdout and exits 0; otherwise it exits 1 (an expired session is ended first).

Canon: docs/design/secrets-session.md, ADR 1186, ADR 1204, ADR 1212.
"""
import argparse
import getpass
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

STORES = ("1password", "openbao", "vaultwarden")
ENV_VAR = {"1password": "OP_SERVICE_ACCOUNT_TOKEN", "openbao": "BAO_TOKEN", "vaultwarden": "BW_SESSION"}
SERVICE_PREFIX = "goat-secrets-session-"
MAX_HOURS = 24
# `security -i` parses its stdin like a shell line; every token these stores issue
# fits this set, and anything outside it is refused rather than quoted.
TOKEN_RE = re.compile(r"^[A-Za-z0-9._~+/=:-]{8,16384}$")
HERE = Path(__file__).resolve().parent
POSTURE = HERE.parent / "secrets" / "posture.py"


class SessionError(Exception):
    pass


def warn(msg):
    print(f"secrets-session: {msg}", file=sys.stderr)


def account():
    name = os.environ.get("USER") or getpass.getuser() or "goat"
    return name if re.match(r"^[A-Za-z0-9._-]+$", name) else "goat"


def service(store):
    return SERVICE_PREFIX + store


# --- keychain -------------------------------------------------------------

def security():
    exe = shutil.which("security")
    if not exe:
        raise SessionError(
            "no `security` command: a session keeps its token in the macOS keychain and this "
            "machine has none. There is no file fallback (ADR 1186); with-secrets keeps "
            "resolving references the usual way.")
    return exe


def keychain_put(store, token, expires):
    if not TOKEN_RE.match(token):
        raise SessionError(f"the {store} token has characters this driver does not pass to the keychain; refused")
    line = (f'add-generic-password -U -s {service(store)} -a {account()} '
            f'-l "goat secrets session ({store})" -j "expires={int(expires)}" -w {token}\n')
    proc = subprocess.run([security(), "-i"], input=line, text=True,
                          stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    if proc.returncode != 0 or keychain_get(store) is None:
        raise SessionError(f"the keychain did not keep the {store} token ({proc.stderr.strip() or 'no detail'})")


def keychain_get(store):
    """(token, expires) or None. Never raises for a missing entry."""
    exe = shutil.which("security")
    if not exe:
        return None
    attrs = subprocess.run([exe, "find-generic-password", "-s", service(store), "-a", account()],
                           capture_output=True, text=True)
    if attrs.returncode != 0:
        return None
    m = re.search(r'"icmt"<blob>="expires=(\d+)"', attrs.stdout)
    expires = int(m.group(1)) if m else 0
    secret = subprocess.run([exe, "find-generic-password", "-s", service(store), "-a", account(), "-w"],
                            capture_output=True, text=True)
    if secret.returncode != 0:
        return None
    return secret.stdout.rstrip("\n"), expires


def keychain_delete(store):
    exe = shutil.which("security")
    if exe:
        subprocess.run([exe, "delete-generic-password", "-s", service(store), "-a", account()],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# --- per store ------------------------------------------------------------

def need(cli, store):
    exe = shutil.which(cli)
    if not exe:
        raise SessionError(f"a {store} session needs the `{cli}` CLI on PATH")
    return exe


def child_env(**kw):
    env = dict(os.environ)
    for k, v in kw.items():
        if v is None:
            env.pop(k, None)
        else:
            env[k] = v
    return env


def start_1password(hours):
    op = need("op", "1password")
    if sys.stdin.isatty():
        token = getpass.getpass("1Password service account token (input hidden): ").strip()
    else:
        token = sys.stdin.read().strip()
    if not token.startswith("ops_"):
        raise SessionError("expected a 1Password service account token (it starts with ops_) on stdin")
    check = subprocess.run([op, "whoami", "--format=json"], capture_output=True, text=True,
                           env=child_env(OP_SERVICE_ACCOUNT_TOKEN=token, OP_ACCOUNT=None))
    if check.returncode != 0:
        raise SessionError("1Password refused the service account token (op whoami failed); nothing kept")
    return token, time.time() + hours * 3600, None


def start_openbao(hours):
    bao = need("bao", "openbao")
    if not (os.environ.get("BAO_ADDR") or os.environ.get("VAULT_ADDR")):
        raise SessionError("BAO_ADDR is unset; set it to the store's address and sign in first")
    proc = subprocess.run(
        [bao, "token", "create", f"-ttl={hours}h", f"-explicit-max-ttl={hours}h",
         "-display-name=goat-secrets-session", "-format=json"],
        capture_output=True, text=True)
    if proc.returncode != 0:
        first = (proc.stderr.strip().splitlines() or ["no detail"])[0]
        raise SessionError(
            f"bao token create was refused ({first}). A session needs a current login "
            "(bao login) whose policy grants update on auth/token/create.")
    try:
        auth = json.loads(proc.stdout)["auth"]
        token, lease = auth["client_token"], int(auth["lease_duration"])
    except (ValueError, KeyError, TypeError):
        raise SessionError("bao token create answered in a shape this driver does not read; nothing kept")
    note = None
    if lease < hours * 3600:
        note = f"the login this token is a child of ends sooner, so the session lasts {fmt_left(lease)}"
    return token, time.time() + lease, note


def start_vaultwarden(hours):
    bw = need("bw", "vaultwarden")
    token = os.environ.get("BW_SESSION", "")
    if not token:
        if not sys.stdin.isatty():
            raise SessionError("BW_SESSION is unset and there is no terminal to type the master password to `bw unlock`")
        proc = subprocess.run([bw, "unlock", "--raw"], stdout=subprocess.PIPE, text=True,
                              env=child_env(BW_NOINTERACTION=None))
        token = proc.stdout.strip()
        if proc.returncode != 0 or not token:
            raise SessionError("bw unlock did not return a session; nothing kept")
    check = subprocess.run([bw, "unlock", "--check"], capture_output=True, text=True,
                           env=child_env(BW_SESSION=token, BW_NOINTERACTION="true"))
    if check.returncode != 0:
        raise SessionError("the Bitwarden CLI does not accept this session key (bw unlock --check failed); nothing kept")
    return token, time.time() + hours * 3600, None


START = {"1password": start_1password, "openbao": start_openbao, "vaultwarden": start_vaultwarden}


def close(store, token):
    """Revoke what can be revoked from this device. Returns a one-line outcome."""
    if store == "openbao":
        bao = shutil.which("bao")
        if not bao:
            return "keychain entry removed; `bao` is not on PATH, so the token was not revoked and lives to its ttl"
        rc = subprocess.run([bao, "token", "revoke", "-self"], capture_output=True, text=True,
                            env=child_env(BAO_TOKEN=token, VAULT_TOKEN=None)).returncode
        return "token revoked" if rc == 0 else "keychain entry removed; the store did not confirm the revoke (the token lives to its ttl)"
    if store == "vaultwarden":
        bw = shutil.which("bw")
        if bw:
            subprocess.run([bw, "lock"], capture_output=True, text=True,
                           env=child_env(BW_SESSION=token, BW_NOINTERACTION="true"))
            return "vault locked"
        return "keychain entry removed; `bw` is not on PATH, run `bw lock`"
    return ("keychain entry removed; the service account token stays valid until its own expiry "
            "unless an admin deletes the service account")


# --- verbs ----------------------------------------------------------------

def fmt_left(seconds):
    seconds = max(0, int(seconds))
    return f"{seconds // 3600}h{(seconds % 3600) // 60:02d}m"


def declared_store():
    try:
        out = subprocess.run([sys.executable, str(POSTURE), "store"], capture_output=True, text=True)
    except OSError:
        return None
    store = out.stdout.strip()
    return store if out.returncode == 0 and store in STORES else None


def cmd_start(args):
    hours = args.hours
    if not 1 <= hours <= MAX_HOURS:
        raise SessionError(f"--hours must be between 1 and {MAX_HOURS}")
    security()  # refuse before asking anyone for anything
    stores = args.store or [s for s in [declared_store()] if s]
    if not stores:
        raise SessionError("the declared store is not 1password, openbao or vaultwarden; name one with --store")
    for store in stores:
        token, expires, note = START[store](hours)
        keychain_put(store, token, expires)
        del token
        print(f"{store}: session live for {fmt_left(expires - time.time())}, until "
              f"{time.strftime('%Y-%m-%d %H:%M %Z', time.localtime(expires))}")
        if note:
            print(f"{store}: {note}")
    return 0


def state(store, now=None):
    now = now or time.time()
    got = keychain_get(store)
    if got is None:
        return "absent", 0
    _token, expires = got
    return ("live", expires - now) if expires > now else ("expired", 0)


def cmd_status(_args):
    if not shutil.which("security"):
        print("no keychain on this machine: sessions are unavailable; with-secrets resolves the usual way")
        return 0
    for store in STORES:
        st, left = state(store)
        print(f"{store:12} {st}" + (f"  {fmt_left(left)} left" if st == "live" else ""))
    return 0


def cmd_end(args):
    for store in args.store or STORES:
        got = keychain_get(store)
        if got is None:
            print(f"{store}: no session")
            continue
        outcome = close(store, got[0])
        keychain_delete(store)
        print(f"{store}: session ended; {outcome}")
    return 0


def cmd_token(args):
    got = keychain_get(args.store)
    if got is None:
        return 1
    token, expires = got
    if expires <= time.time():
        close(args.store, token)
        keychain_delete(args.store)
        return 1
    sys.stdout.write(token)
    return 0


def main(argv):
    ap = argparse.ArgumentParser(prog="secrets-session", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="verb", required=True)
    s = sub.add_parser("start", help="start a session (default: the declared store, 24 hours)")
    s.add_argument("--store", action="append", choices=STORES)
    s.add_argument("--hours", type=int, default=MAX_HOURS)
    sub.add_parser("status", help="live / expired / absent per store, and time left")
    e = sub.add_parser("end", help="end sessions (default: every store)")
    e.add_argument("--store", action="append", choices=STORES)
    t = sub.add_parser("token", help=argparse.SUPPRESS)
    t.add_argument("store", choices=STORES)
    args = ap.parse_args(argv)
    try:
        return {"start": cmd_start, "status": cmd_status, "end": cmd_end, "token": cmd_token}[args.verb](args)
    except SessionError as err:
        warn(str(err))
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
