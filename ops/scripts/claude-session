#!/usr/bin/env bash
# claude-session — provision a per-session git worktree on a fresh branch
# and launch Claude Code there. Implements ADR 0011's per-session worktree
# pattern + ADR 0013's master-read-only invariant.
#
# Usage:
#   claude-session <name>            # default: provision worktree
#   claude-session --master          # explicit master mode (no worktree)
#   claude-session --master <name>   # master mode with track name
#   claude-session --read-only       # no track, no worktree, no commits
#
# Behavior:
#   <name>: provisions .claude/worktrees/<name> off origin/main on branch
#   track/<name>, registers track via ops/work/work pickup, cd's into
#   worktree, execs claude. Master worktree HEAD untouched.
#
#   --master: no worktree provisioned. Operates on master HEAD. Optional
#   <name> registers a master-mode track for visibility. Per the
#   net-positive call: status quo collision risk carries forward; no
#   warnings or locks.
#
#   --read-only: no track, no worktree. Pure inspection.
#
# Compose with:
#   - ops/git-hooks/install.sh         (must be installed before this is reliable)
#   - ops/work/work pickup             (auto-invoked by this launcher)
#   - /iso slash command (skill)       (mid-session toggle once Claude is open)
#
# v1: --master and --read-only modes are noted but only --master and the
# default worktree mode are implemented. Read-only is "just don't pickup,
# just run claude" and not yet wrapped here.
set -e

usage() {
  cat <<EOF
usage: claude-session <name>                    # provision per-session worktree (default)
       claude-session --autonomous <name>       # worktree + overnight-allowlist permissions
       claude-session --master [<name>]         # explicit master mode (no worktree)
       claude-session --read-only                # no track, no worktree
       claude-session -h | --help

The default mode (worktree) is the safe default per ADR 0011 + 0013. Master
mode is for trivial fixes / inspection / merge-conflict resolution; status
quo collision risk carries forward (no warnings or locks).

--autonomous installs ops/scripts/permissions/overnight-allowlist.json into
the per-session worktree's .claude/settings.local.json so the agent runs
end-to-end without operator permission prompts. Hard deny list still applies
(cloud apply / destructive / main push / merge). Permission-denial pattern
is the structural escalation trigger — see ops/work/roles/autonomous-worker.md.
Rollback: rm .claude/worktrees/<name>/.claude/settings.local.json.
EOF
}

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  echo "error: not in a git repository" >&2
  exit 1
fi

# Verify we're in the master worktree (not already in a child worktree)
abs_git=$(cd "$(git rev-parse --git-dir)" && pwd)
abs_common=$(cd "$(git rev-parse --git-common-dir)" && pwd)
if [ "$abs_git" != "$abs_common" ]; then
  echo "error: claude-session must be run from the master worktree" >&2
  echo "       you are already in a child worktree:" >&2
  echo "       $(git rev-parse --show-toplevel)" >&2
  echo "       cd to ${abs_common%/.git} and re-run." >&2
  exit 1
fi

MODE="worktree"
NAME=""
AUTONOMOUS=0

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --master)
      MODE="master"
      shift
      ;;
    --read-only)
      MODE="read-only"
      shift
      ;;
    --autonomous)
      AUTONOMOUS=1
      shift
      ;;
    -*)
      echo "error: unknown flag: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [ -z "$NAME" ]; then
        NAME="$1"
      else
        echo "error: unexpected positional argument: $1" >&2
        usage >&2
        exit 1
      fi
      shift
      ;;
  esac
done

if [ "$AUTONOMOUS" = "1" ] && [ "$MODE" != "worktree" ]; then
  echo "error: --autonomous only valid with worktree mode (default)." >&2
  echo "       autonomous mode is unsafe on master worktree (shared HEAD)" >&2
  echo "       and meaningless in read-only mode (no agent commits)." >&2
  exit 1
fi

case "$MODE" in
  worktree)
    if [ -z "$NAME" ]; then
      echo "error: worktree mode requires a name" >&2
      usage >&2
      exit 1
    fi
    # Validate name
    if [[ ! "$NAME" =~ ^[a-z0-9][a-z0-9._-]*$ ]]; then
      echo "error: name must be lowercase alphanumeric + . _ -, starting with alphanumeric" >&2
      exit 1
    fi
    WORKTREE_PATH=".claude/worktrees/${NAME}"
    BRANCH="track/${NAME}"
    if [ -d "${REPO_ROOT}/${WORKTREE_PATH}" ]; then
      echo "worktree already exists at ${WORKTREE_PATH}; entering it" >&2
    else
      git fetch origin main --quiet
      git worktree add "${REPO_ROOT}/${WORKTREE_PATH}" -b "${BRANCH}" origin/main
    fi
    # Register track via work CLI (best-effort; failure is non-fatal so
    # operators can still work even if work CLI has issues)
    if [ -x "${REPO_ROOT}/ops/work/work" ]; then
      "${REPO_ROOT}/ops/work/work" pickup "${NAME}" \
        --note "claude-session launcher; worktree at ${WORKTREE_PATH}" \
        2>/dev/null || \
        echo "note: 'work pickup ${NAME}' failed (non-fatal). Track may already be registered." >&2
    else
      echo "warning: ops/work/work CLI not found; skipping track registration." >&2
    fi
    cd "${REPO_ROOT}/${WORKTREE_PATH}"
    # Write per-worktree env anchor (anti-drift; matches /iso enter)
    cat > "${REPO_ROOT}/${WORKTREE_PATH}/.iso-mode.env" <<ENVEOF
# claude-session anchor — sourced by agents to verify worktree context.
# Per ops/work/roles/autonomous-worker.md cwd-discipline: every Bash
# invocation in this worktree should start with: cd "\$WORKTREE_ROOT" && ...
WORKTREE_ROOT=${REPO_ROOT}/${WORKTREE_PATH}
TRACK=${NAME}
BRANCH=${BRANCH}
MODE=worktree
AUTONOMOUS=${AUTONOMOUS}
ENVEOF
    if [ "$AUTONOMOUS" = "1" ]; then
      ALLOWLIST="${REPO_ROOT}/ops/scripts/permissions/overnight-allowlist.json"
      if [ ! -f "$ALLOWLIST" ]; then
        echo "error: --autonomous requested but allowlist missing at ${ALLOWLIST}" >&2
        echo "       remove --autonomous OR restore the allowlist file" >&2
        exit 1
      fi
      mkdir -p .claude
      cp "$ALLOWLIST" .claude/settings.local.json
      echo "claude-session: --autonomous → installed allowlist at .claude/settings.local.json"
      echo "  hard-deny still applies (cloud apply, destructive, main push, merge)"
      echo "  permission denial = structural halt; see ops/work/roles/autonomous-worker.md"
      echo "  rollback: rm .claude/settings.local.json"
    fi
    echo "claude-session: in worktree ${WORKTREE_PATH} on branch ${BRANCH}"
    echo "  master worktree at ${REPO_ROOT} stays on main (untouched)"
    echo "  release with: ${REPO_ROOT}/ops/work/work release ${NAME}"
    echo "  cleanup with: cd ${REPO_ROOT} && git worktree remove ${WORKTREE_PATH}"
    ;;
  master)
    cd "${REPO_ROOT}"
    if [ -n "$NAME" ] && [ -x "${REPO_ROOT}/ops/work/work" ]; then
      "${REPO_ROOT}/ops/work/work" pickup "${NAME}" \
        --master \
        --note "claude-session launcher --master; operating on master HEAD" \
        2>/dev/null || \
        echo "note: 'work pickup ${NAME} --master' failed (non-fatal)." >&2
    fi
    echo "claude-session: master mode at ${REPO_ROOT}"
    echo "  ⚠ master HEAD is shared across sessions; collision risk per status quo"
    echo "  ⚠ ≤2 unpushed commits per ADR 0014 trunk-mirror invariant"
    ;;
  read-only)
    cd "${REPO_ROOT}"
    echo "claude-session: read-only mode at ${REPO_ROOT}"
    echo "  no track, no worktree; no commits"
    ;;
esac

# Exec claude (the actual Claude Code CLI). Resolves $PATH; operator must
# have it installed. If absent, claude-session has done its setup but the
# operator runs claude manually.
if command -v claude >/dev/null 2>&1; then
  exec claude "$@"
else
  echo "" >&2
  echo "note: 'claude' not on PATH; setup complete, run claude manually from this directory" >&2
  exec "$SHELL"
fi
