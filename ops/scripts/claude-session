#!/usr/bin/env bash
# claude-session — runs `claude-session` from dots (agent-tools/bin/claude-session); see ops/scripts/dots-tool.
s="${BASH_SOURCE[0]}"
while [ -L "$s" ]; do l="$(readlink "$s")"; case "$l" in /*) s="$l" ;; *) s="$(dirname "$s")/$l" ;; esac; done
exec "$(dirname "$s")/dots-tool" claude-session "$@"
