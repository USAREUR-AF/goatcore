#!/usr/bin/env bash
# dots-tool — run a session tool from a dots checkout (agent-tools/), where the
# coldstart, claude-session, closeout-check, worktree-reap and next-id tools
# and the git-hook dispatcher now live, beside the agent-workflow Claude Code
# plugin. The ops/scripts wrappers of the same names call this, so the paths
# the ADRs cite keep working.
#
#   dots-tool <name> [args...]       runs agent-tools/bin/<name>
#   dots-tool <dir>/<name> [args...] runs agent-tools/<dir>/<name> (e.g. git-hooks/install-global)
#   dots-tool --which <name>         prints the path it would run
#   dots-tool --root                 prints the dots checkout it uses
#
# Where dots comes from, first match:
#   1. $DOTS_DIR, a dots checkout.
#   2. For a bin/ tool, the tool on PATH.
#   3. The checkout git's global core.hooksPath points into
#      (<dots>/agent-tools/git-hooks/hooks, set by install-global).
#   4. A clone of $DOTS_REPO_URL at the commit in ops/scripts/dots.ref, cached
#      under ${XDG_CACHE_HOME:-~/.cache}/agent-workflow/.
# The chosen agent-tools/bin goes first on PATH, so tools that call aw-config
# or each other find the same copy.
set -euo pipefail
mode=""
case "${1:-}" in --which|--root) mode="$1"; shift ;; esac
rel=""
if [ "$mode" != --root ]; then
  [ $# -ge 1 ] || { echo "usage: dots-tool [--which] <name> [args...] | --root" >&2; exit 2; }
  rel="$1"; shift
  case "$rel" in */*) ;; *) rel="bin/$rel" ;; esac
fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root=""
if [ -n "${DOTS_DIR:-}" ]; then
  root="$DOTS_DIR"
elif [ -n "$rel" ] && [ -z "${DOTS_TOOL_VIA_PATH:-}" ] && [ "${rel%%/*}" = bin ] \
     && found="$(command -v "${rel#bin/}" 2>/dev/null)" \
     && [ "$(cd "$(dirname "$found")" && pwd)" != "$here" ]; then
  [ -n "$mode" ] && { printf '%s\n' "$found"; exit 0; }
  # Set so a PATH entry that links back to these wrappers cannot loop.
  DOTS_TOOL_VIA_PATH=1 exec "$found" "$@"
else
  hooks="$(git config --global core.hooksPath 2>/dev/null || true)"
  case "$hooks" in
    */agent-tools/git-hooks/hooks) root="${hooks%/agent-tools/git-hooks/hooks}" ;;
  esac
  if [ -z "$root" ] || [ ! -d "$root/agent-tools/bin" ]; then
    ref="$(tr -d '[:space:]' < "$here/dots.ref")"
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/agent-workflow"
    root="$cache/dots-$ref"
    if [ ! -d "$root/agent-tools" ]; then
      [ -n "${DOTS_REPO_URL:-}" ] || {
        echo "dots-tool: no dots checkout found; set DOTS_DIR to one, or DOTS_REPO_URL to clone it at ops/scripts/dots.ref" >&2
        exit 127
      }
      mkdir -p "$cache"
      tmp="$(mktemp -d "$cache/dots-clone.XXXXXX")"
      git clone -q "$DOTS_REPO_URL" "$tmp" >&2
      git -C "$tmp" -c advice.detachedHead=false checkout -q "$ref"
      mv "$tmp" "$root" 2>/dev/null || rm -rf "$tmp"
    fi
  fi
fi
[ "$mode" = --root ] && { printf '%s\n' "$root"; exit 0; }
tool="$root/agent-tools/$rel"
[ -x "$tool" ] || { echo "dots-tool: $tool is missing or not executable" >&2; exit 127; }
[ -n "$mode" ] && { printf '%s\n' "$tool"; exit 0; }
PATH="$root/agent-tools/bin:$PATH" exec "$tool" "$@"
