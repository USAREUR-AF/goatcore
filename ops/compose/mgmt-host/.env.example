# Example environment for ops/compose/mgmt-host/docker-compose.yml.
# Copy to `.env` on the mgmt-host (Ansible renders this from env vars +
# 1Password at deploy time; do NOT commit a real .env).

# --- Identity / site -------------------------------------------------------
# Feeds signal-server --node label, used in logs and Prometheus metric labels.
SITE_NAME=pilot

# --- Image pins ------------------------------------------------------------
# REQUIRED: the compose files name no image for postgres-a/-b or signal-a/-b,
# and refuse to load without these two. Ansible renders them from the
# goatnet's pins (postgres_spock_image, signal_server_image); digest-pinned
# references are the norm in production.
POSTGRES_SPOCK_IMAGE=ghcr.io/usareur-af/postgres-spock:sha-abc1234
SIGNAL_SERVER_IMAGE=ghcr.io/usareur-af/signal-server:sha-abc1234
# The account and setup-key CLI (`docker compose --profile bootstrap run --rm
# mgmt-host-bootstrap`). Unset = the public :latest build.
# MGMT_HOST_BOOTSTRAP_IMAGE=ghcr.io/usareur-af/mgmt-host-bootstrap:sha-abc1234
#
# --- Netbird management image ---------------------------------------------
# Default (unset) = upstream netbirdio/management:0.68.3 (AutoMigrate runs
#   every start — single-instance pilot is fine).
# Override with the patched image when running the Phase 2 multi-master
# validation on the goat-ha-dev EC2 pair, or any Phase 3+ site:
# NETBIRD_MGMT_IMAGE=ghcr.io/usareur-af/netbird-mgmt@sha256:4d5d350741daa57391b1fbc55e5b2e695a728dee595c5eb41c6dcc18516943c3

# --- Secrets ---------------------------------------------------------------
# PG superuser password — only used locally (loopback 5432). Application
# users (netbird, replicator) get their own passwords provisioned by Ansible
# post-boot, not here.
POSTGRES_SUPERUSER_PASSWORD=change-me-via-ansible
