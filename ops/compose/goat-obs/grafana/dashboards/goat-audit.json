{
  "id": null,
  "uid": "goat-audit",
  "title": "GOAT Audit Subscriber",
  "description": "Per-vendor + per-topic visibility into the external Zenoh audit subscriber on the mgmt host (Block 82S; ADR 0858). Replaces what the retired in-process audit-logger plugin tried (and silently failed) to provide.",
  "tags": ["goat", "zenoh", "audit"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Subscriber session state",
      "description": "1 = connected to zenoh router; 0 = disconnected. Should be a flat 1.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "goat_audit_subscriber_session_state",
          "legendFormat": "{{audit_subscriber_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Samples / 5min",
      "description": "Total publishes captured across all vendors in the last 5 min.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(goat_audit_samples_total[5m]))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Batches uploaded / 5min",
      "description": "NDJSON batches successfully PUT to MinIO `audit-integrity` bucket.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(goat_audit_batches_uploaded_total[5m]))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Write errors / 5min",
      "description": "MinIO PutObject failures. Non-zero = alertable. QuotaExceeded shows up here (per the 12 GiB cap on audit-integrity).",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(goat_audit_write_errors_total[5m]))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Samples / second by topic-family",
      "description": "Per-second publish rate the subscriber sees, one series per first-two-segments key-pattern (e.g. `caracal/mantis/*`). Pivots on `key_pattern` rather than `vendor` because a trial fabric routes every logical vendor through one of two cert-bound prefixes (caracal, community); grouping by `vendor` collapses ~18 logical vendors into 2 series, hiding most of what's actually flowing. Production sites where each vendor owns its own cert will see the two views converge.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (key_pattern) (rate(goat_audit_samples_total[1m]))",
          "legendFormat": "{{key_pattern}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Bytes / second by vendor",
      "description": "Per-second payload-bytes the subscriber sees, by cert-bound vendor (caracal / community / attest). Combined with the 7d retention + 12 GiB cap on audit-integrity, this is how to forecast time-to-quota. Stays on `vendor` rather than `key_pattern` so the quota-budget view matches how MinIO bills the bytes (per writer identity, not per topic).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (vendor) (rate(goat_audit_sample_bytes_total[1m]))",
          "legendFormat": "{{vendor}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top topics (last 5 min)",
      "description": "Per-vendor + per-key_pattern publish counts in the last 5 min, sorted by volume. Spot-check that the busiest topics make sense given the live publisher fleet.",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "topk(20, sum by (vendor, key_pattern) (increase(goat_audit_samples_total[5m])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "audit_subscriber_id": true },
            "indexByName": { "vendor": 0, "key_pattern": 1, "Value": 2 },
            "renameByName": { "Value": "samples (5m)" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "samples (5m)" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "footer": { "show": false } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Drops / second (subscriber-side)",
      "description": "Events the subscriber dropped before batching — bounded-channel backpressure or batch-buffer full. Should be a flat 0 under normal load.",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (audit_subscriber_id) (rate(goat_audit_drop_total[1m]))",
          "legendFormat": "{{audit_subscriber_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      }
    }
  ],
  "annotations": { "list": [] },
  "templating": { "list": [] }
}
