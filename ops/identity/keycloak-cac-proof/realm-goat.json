{
  "realm": "goat",
  "enabled": true,
  "sslRequired": "none",
  "directGrantFlow": "x509 direct grant",
  "users": [
    {
      "username": "1234567890",
      "enabled": true,
      "email": "person-23@example.org",
      "firstName": "CAC",
      "lastName": "User",
      "emailVerified": true,
      "attributes": { "edipi": ["1234567890"] }
    }
  ],
  "clients": [
    {
      "clientId": "proof",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "edipi",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "edipi",
            "claim.name": "edipi",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "kratos",
      "enabled": true,
      "publicClient": false,
      "secret": "kratos-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://kratos:4433/self-service/methods/oidc/callback/*"],
      "protocolMappers": [
        {
          "name": "edipi",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "edipi",
            "claim.name": "edipi",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "x509 direct grant",
      "description": "Direct grant authenticated by a CAC x509 client certificate.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "direct-grant-auth-x509-username",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "x509-edipi-config",
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "x509-edipi-config",
      "config": {
        "x509-cert-auth.mapping-source-selector": "Match SubjectDN using regular expression",
        "x509-cert-auth.regular-expression": "CN=[^,]*?\\.([0-9]+)",
        "x509-cert-auth.mapper-selector": "Username or Email",
        "x509-cert-auth.canonical-dn-enabled": "false",
        "x509-cert-auth.serialnumber-hex-enabled": "false",
        "x509-cert-auth.timestamp-validation-enabled": "true",
        "x509-cert-auth.crl-checking-enabled": "false",
        "x509-cert-auth.ocsp-checking-enabled": "false"
      }
    }
  ]
}
